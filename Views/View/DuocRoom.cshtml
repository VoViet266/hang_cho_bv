@model HangChoKhamBenh.Web.Models.DuocRoomViewModel
@{
    Layout = null;
    var isBhyt = Model.DuocType == "bhyt";
    var isDichVu = Model.DuocType == "dichvu";
    var isAll = Model.DuocType == "all";
    var queueList = Model.QueueList ?? new List<HangChoKhamBenh.Web.Models.DuocQueueItemDto>();
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title - Bệnh Viện Tâm Minh Đức</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/board.css">
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#1e40af',
                            danger: '#dc2626',
                            success: '#16a34a',
                            accent: '#0f172a',
                        }
                    }
                }
            }
    </script>
    <style>
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            @@keyframes pulse-red {

                0%,
                100% {
                    transform: scale(1);
                    opacity: 1;
                }

                50% {
                    transform: scale(1.02);
                    opacity: 0.95;
                }
            }

            .animate-pulse-red {
                animation: pulse-red 2s infinite ease-in-out;
            }

            .duoc-patient-table {
                table-layout: fixed !important;
                width: 100% !important;
            }

            .duoc-patient-table thead {
                background: #e2e8f0 !important;
            }

            .duoc-patient-table th {
                overflow: visible !important;
                text-overflow: clip !important;
                white-space: nowrap !important;
                font-size: clamp(14px, 1.25vw, 22px) !important;
                font-weight: 900 !important;
                padding: 10px 4px !important;
                letter-spacing: 0.01em !important;
                text-align: center !important;
                color: #1e3a8a !important;
            }

            .duoc-patient-table th:nth-child(2) {
                text-align: left !important;
                padding-left: 12px !important;
            }

            .duoc-patient-table td {
                overflow: visible !important;
                text-overflow: clip !important;
                vertical-align: middle !important;
            }

            .duoc-patient-table .patient-name-container {
                overflow: visible !important;
                max-width: 100% !important;
                min-width: 0 !important;
            }

            .duoc-patient-table .patient-name-text {
                display: inline-block !important;
                white-space: normal !important;
                word-break: break-word !important;
                overflow: visible !important;
                text-overflow: clip !important;
                line-height: 1.18 !important;
                max-width: 100% !important;
                font-size: clamp(23px, 2.1vw, 48px) !important;
                font-weight: 900 !important;
                letter-spacing: -0.01em !important;
                color: #1e3a8a !important;
            }

            .duoc-patient-table td.cell-stt {
                font-size: clamp(24px, 2.2vw, 40px) !important;
                font-weight: 900 !important;
                text-align: center !important;
                white-space: nowrap !important;
                overflow: visible !important;
                text-overflow: clip !important;
                color: #172554 !important;
                padding-left: 2px !important;
                padding-right: 2px !important;
            }

            .duoc-patient-table td.cell-namsinh {
                font-size: clamp(16px, 1.5vw, 32px) !important;
                font-weight: 800 !important;
                text-align: center !important;
                white-space: nowrap !important;
                overflow: visible !important;
                text-overflow: clip !important;
                color: #1e3a8a !important;
                padding-left: 2px !important;
                padding-right: 2px !important;
            }

            /* --- CHẾ ĐỘ 1 BẢNG (KHI CHƯA TRÀN): CHỮ SIÊU TO, ĐẬM NÉT, DỄ ĐỌC TỪ XA --- */
            .duoc-table-single th {
                font-size: clamp(16px, 1.45vw, 25px) !important;
                font-weight: 900 !important;
                padding: 12px 6px !important;
                letter-spacing: 0.02em !important;
                text-align: center !important;
                color: #1e3a8a !important;
            }

            .duoc-table-single th:nth-child(2) {
                text-align: left !important;
                padding-left: 14px !important;
            }

            .duoc-table-single .patient-name-text {
                font-size: clamp(28px, 2.65vw, 45px) !important;
                color: #1e3a8a !important;
            }

            .duoc-table-single td.cell-stt {
                font-size: clamp(32px, 3.2vw, 54px) !important;
            }

            .duoc-table-single td.cell-namsinh {
                font-size: clamp(20px, 1.9vw, 32px) !important;
            }

            .duoc-table-single .badge-money {
                font-size: clamp(18px, 1.6vw, 28px) !important;
                font-weight: 900 !important;
                padding: 5px 12px !important;
            }

            .duoc-table-single .badge-ocua {
                font-size: clamp(18px, 1.6vw, 28px) !important;
                font-weight: 900 !important;
                padding: 5px 12px !important;
            }

            .duoc-table-single .badge-status {
                font-size: clamp(16px, 1.4vw, 24px) !important;
                font-weight: 900 !important;
                padding: 5px 12px !important;
            }

            /* --- CHẾ ĐỘ 2 BẢNG (KHI FULL TRÀN MÀN HÌNH): CHỮ TO RÕ, CÂN ĐỐI 2 BÊN --- */
            .duoc-table-split th {
                font-size: clamp(12px, 1.0vw, 16px) !important;
                font-weight: 900 !important;
                padding: 6px 2px !important;
                letter-spacing: 0 !important;
                text-align: center !important;
                color: #1e3a8a !important;
                white-space: nowrap !important;
            }

            .duoc-table-split th:nth-child(2) {
                text-align: left !important;
                padding-left: 10px !important;
            }

            .duoc-table-split .patient-name-text {
                font-size: clamp(23px, 2.0vw, 34px) !important;
                color: #1e3a8a !important;
            }

            .duoc-table-split td.cell-stt {
                font-size: clamp(25px, 2.3vw, 40px) !important;
            }

            .duoc-table-split td.cell-namsinh {
                font-size: clamp(17px, 1.5vw, 25px) !important;
            }

            .duoc-table-split .badge-money {
                font-size: clamp(14px, 1.25vw, 21px) !important;
                font-weight: 900 !important;
                padding: 3px 8px !important;
            }

            .duoc-table-split .badge-ocua {
                font-size: clamp(14px, 1.25vw, 21px) !important;
                font-weight: 900 !important;
                padding: 3px 8px !important;
            }

            .duoc-table-split .badge-status {
                font-size: clamp(11px, 0.95vw, 15px) !important;
                font-weight: 900 !important;
                padding: 2px 6px !important;
            }

            /* Tự động lấp đầy 100% chiều cao bảng, chia đều các hàng, không để lại khoảng trống thừa ở đáy */
            .duoc-patient-table.table-fill-height {
                height: 100% !important;
            }

            .duoc-patient-table.table-fill-height tbody {
                height: 100% !important;
            }

            .duoc-patient-table.table-fill-height tbody tr {
                height: 1% !important;
            }
    </style>
</head>

<body class="tv-board bg-slate-100 text-slate-900 font-sans flex flex-col h-screen overflow-hidden select-none">

    <!-- Top Bar Header -->
    <header
        class="tv-header flex flex-col md:flex-row justify-between items-start md:items-center bg-white py-1 px-2.5 border-2 border-slate-300 shadow-sm gap-2 shrink-0">
        <!-- Logo & Đồng hồ -->
        <div class="tv-brand flex items-center bg-white gap-3">
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-12 md:h-14 object-contain">
            <div class="tabular-nums">
                <div id="date-str"
                     class="tv-clock-date text-xs text-slate-500 font-bold uppercase tracking-widest leading-tight">
                </div>
                <div id="time-str" class="tv-clock-time text-xl md:text-2xl font-black text-brand leading-none"></div>
            </div>
        </div>

        <!-- Tiêu đề -->
        <div class="tv-room-heading flex flex-col flex-1 text-center items-center justify-center">
            <h1
                class="tv-room-title tv-numbered-room-title text-danger text-xl md:text-4xl font-extrabold uppercase tracking-wide">
                Hàng Chờ Dược
            </h1>
        </div>

        <!-- Controls & Counters -->
        <div class="tv-actions flex items-center gap-2">
            <div
                class="tv-stat tv-stat--waiting bg-red-50 px-3 py-1 text-center min-w-[90px] rounded border border-red-200">
                <span class="block text-danger font-bold text-[10px] uppercase tracking-wide">Đang chờ</span>
                <span id="totalWaiting"
                      class="block text-danger font-black text-lg md:text-xl tabular-nums leading-none mt-0.5">
                    @Model.TotalWaiting
                </span>
            </div>

            <!-- Nút xem danh sách bệnh nhân đã xóa/ẩn (Phím H) -->
            <button id="hiddenPatientsBtn" onclick="toggleHiddenModal(true)"
                    class="remote-item icon-button bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-600 hover:text-danger px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer relative"
                    tabindex="0" aria-label="Danh sách bệnh nhân đã xóa/ẩn" title="Danh sách bệnh nhân đã xóa/ẩn (Phím H)">
                <i class="fas fa-user-slash"></i>
                <span id="hiddenBadgeCount"
                      class="hidden absolute -top-1.5 -right-1.5 bg-danger text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
            </button>

            <!-- Nút bật/tắt Tự động phát âm thanh (Phím T) -->
            <button id="autoSpeakToggleBtn" onclick="toggleAutoSpeak()"
                    class="remote-item icon-button bg-emerald-50 hover:bg-emerald-100 border-2 border-emerald-400 text-emerald-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer"
                    tabindex="0" title="Tự động gọi loa: BẬT/TẮT (Phím T)">
                <i id="autoSpeakIcon" class="fas fa-robot text-emerald-600"></i>
            </button>

            <!-- Nút bật âm thanh (Phím A / S) -->
            <button id="soundToggleBtn" onclick="toggleSound()"
                    class="remote-item icon-button bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer"
                    tabindex="0" aria-label="Bật hoặc tắt âm thanh" title="Bật/Tắt âm thanh (Phím A hoặc S)">
                <i id="soundIcon" class="fas fa-volume-up text-green-600"></i>
            </button>

            <!-- Nút toàn màn hình TV (F11) -->
            <button onclick="toggleFullScreen()"
                    class="remote-item icon-button bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer"
                    tabindex="0" title="Toàn màn hình TV (F11)">
                <i class="fas fa-expand"></i>
            </button>

            <!-- Nút quay lại -->
            <a href="/duoc"
               class="remote-item icon-button bg-slate-50 hover:bg-red-50 hover:border-red-300 border-2 border-slate-300 text-slate-500 hover:text-danger px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition-colors inline-flex items-center gap-1"
               tabindex="0" aria-label="Về danh sách quầy Dược" title="Về danh sách quầy Dược (Esc)">
                <i class="fas fa-arrow-left"></i>
            </a>
        </div>
    </header>

    <!-- MAIN: BẢNG DANH SÁCH HÀNG CHỜ PHÁT THUỐC (GỘP BHYT + DỊCH VỤ) -->
    <main id="mainContent" class="flex-grow p-1.5 overflow-hidden flex flex-col">
        <!-- Container phân trang — JS sẽ tạo các .queue-page-block bên trong -->
        <div id="paginationContainer" class="flex-grow overflow-hidden flex flex-col">
            <!-- SSR fallback: hiển thị bảng tĩnh (JS sẽ replace sau khi đo chiều cao) -->
            <div id="ssrTableWrapper"
                 class="room-container flex-grow overflow-hidden flex flex-col bg-white border-2 border-slate-300 rounded-xl shadow-sm">
                <table
                    class="w-full h-full border-collapse table-fixed select-none duoc-patient-table duoc-table-single">
                    <colgroup>
                        <col style="width: 7%;">
                        <col style="width: 45%;">
                        <col style="width: 12%;">
                        <col style="width: 18%;">
                        <col style="width: 18%;">
                    </colgroup>
                    <thead
                        class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300 text-blue-900 uppercase font-extrabold text-xl md:text-2xl">
                        <tr>
                            <th class="py-3 px-3 text-center">STT</th>
                            <th class="py-3 px-4 text-left">Họ và Tên</th>
                            <th class="py-3 px-3 text-center">Năm Sinh</th>
                            <th class="py-3 px-3 text-center">Số Tiền</th>
                            <th class="py-3 px-3 text-center">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody id="patientTableBody" class="divide-y divide-slate-200">
                        @if (queueList.Count == 0)
                        {
                            <tr id="empty-row">
                                <td colspan="5" class="text-center py-16 text-slate-400 text-3xl font-bold italic">
                                    Không có bệnh nhân chờ lĩnh thuốc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int index = 0; index < queueList.Count; index++)
                            {
                                var p = queueList[index];
                                var isNear = p.IsToiLuot;
                                var currentPatientName = (p.TenBenhNhan ?? "").Trim();
                                var pIsBhyt = p.IsBhyt;
                                var loaiClass = pIsBhyt
                                    ? "bg-blue-100 text-blue-800 border-blue-300"
                                    : ((p.Khochan == 13 || p.Khochan == 3)
                                        ? "bg-purple-100 text-purple-800 border-purple-300"
                                        : "bg-emerald-100 text-emerald-800 border-emerald-300");

                                <tr data-patient="@currentPatientName" data-makb="@(p.Makb ?? "")" data-mabn="@(p.Mabn ?? "")"
                                    data-room-type="duoc"
                                    class="remote-item group @(isNear ? "bg-yellow-100 border-l-[10px] border-yellow-500 shadow-md" : (pIsBhyt ? "border-l-[6px] border-blue-400 bg-blue-50/60" : "border-l-[6px] border-emerald-400 bg-emerald-50/50")) border-b border-slate-200"
                                    tabindex="0">
                                    <td
                                        class="py-4 px-3 font-bold text-center text-blue-900 @(isNear ? "text-4xl md:text-6xl font-black" : "text-3xl md:text-5xl font-bold")">
                                        @p.Stt
                                    </td>
                                    <td
                                        class="py-4 px-4 text-blue-900 @(isNear ? "text-3xl md:text-5xl font-black tracking-tight" : "text-2xl md:text-4xl font-black")">
                                        <div class="patient-name-container select-none flex items-center min-w-0">
                                            <span
                                                class="patient-name-text whitespace-normal break-words leading-tight max-w-full block">
                                                @((!string.IsNullOrEmpty(currentPatientName) ? currentPatientName : "Chưa cập nhật").ToUpper())
                                            </span>
                                        </div>
                                    </td>
                                    <td
                                        class="py-4 px-3 font-bold text-center text-blue-900 @(isNear ? "text-3xl md:text-5xl font-black" : "text-2xl md:text-4xl font-bold")">
                                        @p.NamSinh
                                    </td>
                                    <!-- Cột Loại/Tiền: DV→tiền, BHYT→badge loại toa -->
                                    <td class="py-4 px-3 text-center overflow-hidden">
                                        @if (!pIsBhyt)
                                        {
                                            <span
                                                class="inline-block px-3 py-1 rounded-lg border font-black font-mono text-base md:text-xl lg:text-2xl whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs">
                                                @(!string.IsNullOrEmpty(p.SoTienStr) ? p.SoTienStr : "—")
                                            </span>
                                        }
                                        else
                                        {
                                            <span
                                                class="inline-block px-3 py-1 rounded-lg border font-bold text-sm md:text-lg uppercase whitespace-nowrap @loaiClass">
                                                BHYT
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-3 text-center overflow-hidden">
                                        <div class="flex items-center justify-center gap-1.5 flex-nowrap min-w-0">
                                            @if (isNear)
                                            {
                                                if (!pIsBhyt && p.TrangThai == "Chờ thu")
                                                {
                                                    <span
                                                        class="inline-block bg-amber-600 text-white px-3 md:px-5 py-1.5 rounded-xl text-base md:text-xl lg:text-2xl font-black uppercase whitespace-nowrap shadow-md animate-pulse-red">
                                                        Chờ thu
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span
                                                        class="inline-block bg-red-600 text-white px-3 md:px-5 py-1.5 rounded-xl text-base md:text-xl lg:text-2xl font-black uppercase whitespace-nowrap shadow-md animate-pulse-red">
                                                        TỚI LƯỢT
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                if (!pIsBhyt)
                                                {
                                                    if (p.TrangThai == "Chờ thu")
                                                    {
                                                        <span
                                                            class="inline-block bg-amber-50 text-amber-800 px-3 md:px-4 py-1.5 rounded-xl text-sm md:text-lg font-bold border-2 border-amber-200 shadow-sm whitespace-nowrap">
                                                            Chờ thu
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span
                                                            class="inline-block bg-blue-50 text-blue-800 px-3 md:px-4 py-1.5 rounded-xl text-sm md:text-lg font-bold border-2 border-blue-200 shadow-sm whitespace-nowrap">
                                                            Đang soạn thuốc
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span
                                                        class="inline-block bg-slate-100 text-slate-600 px-3 md:px-4 py-1.5 rounded-xl text-sm md:text-lg font-bold border-2 border-slate-200 shadow-sm whitespace-nowrap">
                                                        @p.TrangThai
                                                    </span>
                                                }
                                            }
                                            <button type="button"
                                                    title="Ẩn bệnh nhân khỏi màn hình (khôi phục qua nút Ẩn trên thanh tiêu đề)"
                                                    aria-label="Xóa hoặc ẩn bệnh nhân khỏi danh sách hiển thị"
                                                    onclick="hidePatientRow(this, event)"
                                                    class="btn-hide-patient p-1.5 text-slate-400 hover:text-danger hover:bg-red-50 rounded-lg transition-all cursor-pointer shrink-0 opacity-40 group-hover:opacity-100 hover:opacity-100"
                                                    tabindex="0">
                                                <i class="fas fa-trash-alt text-base md:text-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- FOOTER THÔNG BÁO -->
    <footer
        class="bg-white border-2 border-slate-300 rounded-xl px-3 py-1 mx-1.5 mb-1 flex items-center gap-2 shrink-0 shadow-sm overflow-hidden">
        <span
            class="px-2 py-0.5 bg-red-100 text-danger border border-red-300 rounded font-bold uppercase shrink-0 text-xs">Lưu
            ý</span>
            <marquee class="text-slate-700 font-bold text-sm md:text-base">
                Quý bệnh nhân vui lòng chuẩn bị sẵn Đơn thuốc, Thẻ BHYT và CCCD khi nghe gọi tên đến quầy nhận thuốc.
            </marquee>
        </footer>

        <!-- Modal Danh Sách Bệnh Nhân Đã Xóa / Ẩn -->
        <div id="hiddenPatientsModal"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center hidden p-4">
            <div
                class="bg-white border-2 border-slate-300 rounded-2xl w-full max-w-xl p-5 text-slate-900 shadow-2xl flex flex-col max-h-[85vh]">
                <div class="flex justify-between items-center pb-3 border-b-2 border-slate-200">
                    <h3 class="text-base md:text-lg font-black text-danger flex items-center gap-2 uppercase">
                        <i class="fas fa-user-slash"></i> Danh Sách Bệnh Nhân Đã Xóa / Ẩn
                    </h3>
                    <button onclick="toggleHiddenModal(false)"
                            class="text-slate-400 hover:text-danger text-2xl font-bold cursor-pointer transition-colors">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="my-3 flex-grow overflow-y-auto" id="hiddenPatientsListContainer">
                    <!-- Danh sách render qua JS -->
                </div>

                <div class="flex justify-between items-center pt-3 border-t-2 border-slate-200 shrink-0">
                    <button onclick="restoreAllHiddenPatients()"
                            class="remote-item px-4 py-2 bg-green-50 hover:bg-green-600 hover:text-white text-green-700 rounded-xl font-black text-xs md:text-sm border border-green-300 transition-colors cursor-pointer"
                            tabindex="0">
                        <i class="fas fa-undo mr-1"></i> Khôi phục tất cả
                    </button>
                    <button onclick="toggleHiddenModal(false)"
                            class="remote-item px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs md:text-sm border border-slate-300 transition-colors cursor-pointer"
                            tabindex="0">
                        Đóng
                    </button>
                </div>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="/js/signalr.min.js"></script>
        <script src="/js/remoteNav.js"></script>
        <script src="/js/audioQueue.js"></script>
        <script>
                let DUOC_TYPE = '@Model.DuocType'; // "bhyt", "dichvu", or "all"

                // Trạng thái âm thanh: Mặc định luôn BẬT
                let isSoundEnabled = localStorage.getItem("duocSoundEnabled") !== "false";
                // Trạng thái tự động gọi loa: Mặc định TẮT (để quầy bấm chọn cửa phát loa)
                let isAutoSpeakEnabled = localStorage.getItem("duocAutoSpeakEnabled") === "true";
                let audioUnlocked = false;

                // Key lưu vết lần gọi gần nhất
                let lastCalledPatientKey = '@(queueList.Count > 0 ? $"{(queueList[0].Makb ?? queueList[0].Mabn ?? "")}_{queueList[0].TrangThai ?? ""}" : "")';
                let currentTopPatient = @Html.Raw(queueList.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(new
                    {
                                                                                tenBenhNhan = queueList[0].TenBenhNhan,
                                                                                trangThai = queueList[0].TrangThai,
                                                                                makb = queueList[0].Makb,
                                                                                mabn = queueList[0].Mabn,
                                                                                isBhyt = queueList[0].IsBhyt,
                                                                                oCua = queueList[0].OCua
                    }) : "null");

                // Quản lý bệnh nhân ẩn (dùng key "duoc_hidden_all" khi mode=all)
                let hiddenStorageKey = `duoc_hidden_${DUOC_TYPE}`;
                let hiddenPatients = JSON.parse(localStorage.getItem(hiddenStorageKey) || "[]");

                // ═══════════════ HỆ THỐNG ÂM THANH & GIỌNG ĐỌC (TTS) ═══════════════
                const audioQueue = new window.AudioQueueManager({
                    isEnabled: () => isSoundEnabled,
                    gapMs: 350,
                });

                // Mở khóa âm thanh cho trình duyệt
                function unlockAudio() {
                    if (audioUnlocked) return;
                    audioUnlocked = true;
                    try {
                        const silent = new Audio('/audio/silent.mp3');
                        silent.volume = 0.01;
                        silent.play().catch(() => { });
                    } catch (e) { }
                }

                ['click', 'keydown', 'touchstart', 'mousemove'].forEach(evt => {
                    document.addEventListener(evt, unlockAudio, { passive: true, once: true });
                });

                function updateSoundIcon() {
                    const icon = document.getElementById('soundIcon');
                    const btn = document.getElementById('soundToggleBtn');
                    if (isSoundEnabled) {
                        if (icon) icon.className = 'fas fa-volume-up text-green-600';
                        if (btn) {
                            btn.title = 'Loa tổng: ĐANG BẬT (Phím A / S để tắt, Space để đọc lại)';
                            btn.className = 'remote-item icon-button bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        }
                    } else {
                        if (icon) icon.className = 'fas fa-volume-mute text-slate-400';
                        if (btn) {
                            btn.title = 'Loa tổng: ĐANG TẮT (Phím A / S để bật)';
                            btn.className = 'remote-item icon-button bg-white border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        }
                    }
                }

                function updateAutoSpeakIcon() {
                    const icon = document.getElementById('autoSpeakIcon');
                    const btn = document.getElementById('autoSpeakToggleBtn');
                    if (!btn) return;

                    if (isAutoSpeakEnabled) {
                        btn.className = 'remote-item icon-button bg-emerald-50 hover:bg-emerald-100 border-2 border-emerald-400 text-emerald-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        btn.title = 'Tự động gọi loa: ĐANG BẬT (Phím T để tắt)';
                        if (icon) icon.className = 'fas fa-robot text-emerald-600';
                    } else {
                        btn.className = 'remote-item icon-button bg-slate-100 border-2 border-slate-300 text-slate-500 hover:bg-slate-200 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        btn.title = 'Tự động gọi loa: ĐANG TẮT (Phím T để bật)';
                        if (icon) icon.className = 'fas fa-robot text-slate-400 opacity-60';
                    }
                }

                function toggleAutoSpeak(forceVal) {
                    if (typeof forceVal === 'boolean') {
                        isAutoSpeakEnabled = forceVal;
                    } else {
                        isAutoSpeakEnabled = !isAutoSpeakEnabled;
                    }
                    localStorage.setItem("duocAutoSpeakEnabled", isAutoSpeakEnabled ? "true" : "false");
                    updateAutoSpeakIcon();
                }

                function toggleSound(forceOn) {
                    if (typeof forceOn === 'boolean') {
                        isSoundEnabled = forceOn;
                    } else {
                        isSoundEnabled = !isSoundEnabled;
                    }
                    localStorage.setItem("duocSoundEnabled", isSoundEnabled ? "true" : "false");
                    unlockAudio();
                    updateSoundIcon();

                    if (isSoundEnabled) {
                        if (currentTopPatient && isAutoSpeakEnabled) {
                            audioQueue.clear();
                            speakTargetPatient(currentTopPatient);
                        }
                    } else {
                        audioQueue.clear();
                    }
                }

                // Đọc trực tiếp khi nhấp vào ĐÚNG TÊN bệnh nhân
                function speakPatientByName(name, status, ocua) {
                    if (!name) return;
                    unlockAudio();
                    if (!isSoundEnabled) { toggleSound(true); }
                    audioQueue.clear();
                    speakTargetPatient({ tenBenhNhan: name, trangThai: status || '', isBhyt: false, oCua: ocua || '' });
                }

                // Đọc giọng nói gọi tên bệnh nhân bằng TTS Tiếng Việt chuẩn
                function speakTargetPatient(p) {
                    if (!isSoundEnabled || !p) return;
                    const name = (p.tenBenhNhan || '').trim();
                    if (!name) return;

                    const targetLoc = p.oCua ? `ô số ${p.oCua}` : "quầy";
                    const speakText = `Mời bệnh nhân, ${name}, đến ${targetLoc}`;
                    audioQueue.enqueue(speakText);
                }

                // Đồng hồ Header
                function updateTime() {
                    const now = new Date();
                    const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
                    const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
                    const dateStrEl = document.getElementById('date-str');
                    const timeStrEl = document.getElementById('time-str');
                    if (dateStrEl) dateStrEl.textContent = now.toLocaleDateString('vi-VN', dateOpts);
                    if (timeStrEl) timeStrEl.textContent = now.toLocaleTimeString('vi-VN', timeOpts);
                }
                setInterval(updateTime, 1000);
                updateTime();

                // Toàn màn hình TV
                function toggleFullScreen() {
                    if (!document.fullscreenElement) {
                        document.documentElement.requestFullscreen().catch(() => { });
                    } else {
                        if (document.exitFullscreen) document.exitFullscreen();
                    }
                }

                // Phím tắt bàn phím
                window.addEventListener('keydown', (e) => {
                    if (e.key === 'F11') {
                        e.preventDefault();
                        toggleFullScreen();
                    } else if (e.key === 'a' || e.key === 'A' || e.key === 's' || e.key === 'S') {
                        toggleSound();
                    } else if (e.key === 't' || e.key === 'T') {
                        toggleAutoSpeak();
                    } else if (e.key === 'h' || e.key === 'H') {
                        const modal = document.getElementById('hiddenPatientsModal');
                        const isHidden = modal && modal.classList.contains('hidden');
                        toggleHiddenModal(isHidden);
                    } else if (e.code === 'Space' || e.key === ' ') {
                        e.preventDefault();
                        unlockAudio();
                        if (currentTopPatient) {
                            audioQueue.clear();
                            speakTargetPatient(currentTopPatient);
                        }
                    } else if (e.key === 'Escape') {
                        const modal = document.getElementById('hiddenPatientsModal');
                        if (modal && !modal.classList.contains('hidden')) {
                            toggleHiddenModal(false);
                        } else {
                            window.location.href = '/duoc';
                        }
                    }
                });

                // Biến toàn cục lưu danh sách bệnh nhân đang hiển thị để resize mượt mà
                let currentActiveList = [];

                
                function buildSplitView(list) {
                    const container = document.getElementById('paginationContainer');
                    if (!container) return;
                    container.innerHTML = '';

                    if (!list || list.length === 0) {
                        container.innerHTML = `
                                            <div class="room-container flex-grow bg-white border-2 border-slate-300 rounded-xl flex items-center justify-center shadow-sm h-full">
                                                <p class="text-center text-slate-400 text-2xl md:text-4xl font-bold italic">Không có bệnh nhân chờ lĩnh thuốc.</p>
                                            </div>`;
                        return;
                    }

                    currentActiveList = list;

                    // BƯỚC 1: Render ở chế độ BÌNH THƯỜNG (1 bảng duy nhất toàn màn hình)
                    container.innerHTML = `
                                        <div id="singleBoardWrapper" class="room-container flex-grow w-full bg-white border-2 border-slate-300 rounded-xl flex flex-col shadow-sm overflow-hidden h-full">
                                            ${buildTableHtml(list, false, false)}
                                        </div>`;

                    const singleWrapper = document.getElementById('singleBoardWrapper');
                    if (!singleWrapper) return;

                    // BƯỚC 2: Kiểm tra xem 1 bảng bình thường có bị tràn (FULL) chiều cao không
                    const scrollBox = singleWrapper.querySelector('.overflow-y-auto') || singleWrapper;
                    const isFullAndOverflow = scrollBox.scrollHeight > (scrollBox.clientHeight + 4);

                    if (!isFullAndOverflow) {
                        // CHƯA FULL -> VẪN HIỂN THỊ BÌNH THƯỜNG (1 bảng toàn màn hình chữ siêu to)
                        return;
                    }

                    // BƯỚC 3: ĐÃ FULL MÀN HÌNH -> MỚI NHẢY SANG 2 BÊN!
                    // Render tạm vào Cột 1 để đo chính xác số hàng vừa khít từ trên xuống sát mép đáy
                    container.innerHTML = `
                                        <div class="flex-grow flex flex-row gap-3 h-full overflow-hidden w-full min-w-0">
                                            <!-- CỘT 1 -->
                                            <div id="col1Container" class="room-container flex-1 min-w-0 bg-white border-2 border-slate-300 rounded-xl flex flex-col shadow-sm overflow-hidden h-full">
                                                ${buildTableHtml(list, true, false)}
                                            </div>
                                            <!-- CỘT 2 -->
                                            <div id="col2Container" class="room-container flex-1 min-w-0 bg-white border-2 border-slate-300 rounded-xl flex flex-col shadow-sm overflow-hidden h-full">
                                                ${buildTableHtml([], true, false)}
                                            </div>
                                        </div>`;

                    const col1Box = document.getElementById('col1Container');
                    const col2Box = document.getElementById('col2Container');
                    if (!col1Box || !col2Box) return;

                    // Đo mép đáy của Cột 1
                    const maxBottom = col1Box.getBoundingClientRect().bottom - 4;
                    const rows = col1Box.querySelectorAll('tbody tr[data-patient]');

                    let fitCount = 0;
                    for (let i = 0; i < rows.length; i++) {
                        const rect = rows[i].getBoundingClientRect();
                        if (rect.bottom <= maxBottom) {
                            fitCount++;
                        } else {
                            break; // Dòng này vượt quá đáy -> dừng lại, các dòng sau tự nhảy sang Cột 2
                        }
                    }

                    if (fitCount === 0 && list.length > 0) fitCount = 1;

                    // Phân bổ: Cột 1 điền FULL, phần dôi dư nhảy sang Cột 2 (dư nhiêu nhảy nhiêu)
                    const col1Data = list.slice(0, fitCount);
                    const col2Data = list.slice(fitCount);

                    col1Box.innerHTML = buildTableHtml(col1Data, true, true);
                    col2Box.innerHTML = buildTableHtml(col2Data, true, col2Data.length >= fitCount);
                }

                function buildTableHtml(rows, isSplit, fillHeight = false) {
                    // Padding thoáng đãng, hàng cao ráo, chữ to
                    const pyClass = isSplit ? 'py-2 md:py-2.5' : 'py-2.5 md:py-3.5';
                    const modeClass = isSplit ? 'duoc-table-split' : 'duoc-table-single';

                    // Tỷ lệ cột khi chia đôi màn hình vs 1 màn hình:
                    const colWidths = isSplit
                        ? `<col style="width: 8%;">
                                   <col style="width: 42%;">
                                   <col style="width: 14%;">
                                   <col style="width: 18%;">
                                   <col style="width: 18%;">`
                        : `<col style="width: 7%;">
                                   <col style="width: 45%;">
                                   <col style="width: 12%;">
                                   <col style="width: 18%;">
                                   <col style="width: 18%;">`;

                    let tbodyContent = '';
                    if (!rows || rows.length === 0) {
                        tbodyContent = `<tr>
                                            <td colspan="5" class="text-center py-16 text-slate-300 italic font-bold text-lg">
                                                Chưa có thêm bệnh nhân
                                            </td>
                                        </tr>`;
                    } else {
                        tbodyContent = rows.map(p => buildRowHtml(p, isSplit, pyClass)).join('');
                    }

                    const fillClass = fillHeight ? 'table-fill-height' : '';

                    return `
                                        <div class="flex-grow overflow-y-auto no-scrollbar w-full flex flex-col h-full">
                                            <table class="patient-table duoc-patient-table ${modeClass} ${fillClass} w-full text-left border-collapse" style="table-layout: fixed;">
                                                <colgroup>
                                                    ${colWidths}
                                                </colgroup>
                                                <thead class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300 text-blue-900 uppercase font-black">
                                                    <tr>
                                                        <th class="text-center font-black">STT</th>
                                                        <th class="text-left font-black">Họ và Tên</th>
                                                        <th class="text-center font-black">Năm Sinh</th>
                                                        <th class="text-center font-black">Loại / Tiền</th>
                                                        <th class="text-center font-black">Trạng Thái</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-200">
                                                    ${tbodyContent}
                                                </tbody>
                                            </table>
                                        </div>`;
                }

                function buildRowHtml(p, isSplit, pyClass) {
                    const isNear = p.isToiLuot;
                    const pIsBhyt = p.isBhyt;
                    const rawName = (p.tenBenhNhan || '').trim();
                    const escapedName = escapeHtml(rawName);
                    const escapedStatus = escapeHtml(p.trangThai || '');
                    const namSinh = escapeHtml(p.namSinh || '—');
                    const makb = escapeHtml(p.makb || '');
                    const mabn = escapeHtml(p.mabn || '');

                    let rowClass;
                    if (isNear) {
                        rowClass = 'bg-yellow-100 border-l-[6px] md:border-l-[8px] border-yellow-500 shadow-sm border-b border-slate-200';
                    } else if (pIsBhyt) {
                        rowClass = 'border-l-[4px] md:border-l-[6px] border-blue-400 bg-blue-50/60 border-b border-slate-200';
                    } else {
                        rowClass = 'border-l-[4px] md:border-l-[6px] border-emerald-400 bg-emerald-50/50 border-b border-slate-200';
                    }

                    // Cột Loại / Tiền
                    let col4Html = '';
                    if (!pIsBhyt) {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                            <span class="badge-money inline-block rounded border font-mono whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs">
                                                ${escapeHtml(p.soTienStr || '—')}
                                            </span>
                                        </td>`;
                    } else {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                            <span class="badge-money inline-block rounded border p-1 uppercase whitespace-nowrap bg-blue-100 text-blue-800 border-blue-300 shadow-2xs">
                                                BHYT
                                            </span>
                                        </td>`;
                    }

                    // Cột Trạng Thái
                    let col5Badge = '';
                    if (isNear) {
                        if (!pIsBhyt && p.trangThai === "Chờ thu") {
                            col5Badge = `<span class="badge-status inline-block bg-amber-600 text-white font-black uppercase whitespace-nowrap shadow-sm animate-pulse-red rounded">TỚI LƯỢT</span>`;
                        } else {
                            col5Badge = `<span class="badge-status inline-block bg-red-600 text-white font-black uppercase whitespace-nowrap shadow-sm animate-pulse-red rounded">TỚI LƯỢT</span>`;
                        }
                    } else {
                        if (!pIsBhyt) {
                            if (p.trangThai === "Chờ thu") {
                                col5Badge = `<span class="badge-status p-1 inline-block bg-amber-50 text-amber-800 border border-amber-200 whitespace-nowrap rounded shadow-2xs">Chờ thu</span>`;
                            } else {
                                col5Badge = `<span class="badge-status p-1 inline-block bg-blue-50 text-blue-800 border border-blue-200 whitespace-nowrap rounded shadow-2xs">Đang soạn</span>`;
                            }
                        } else {
                            col5Badge = `<span class="badge-status inline-block bg-slate-100 text-slate-600 border border-slate-200 whitespace-nowrap rounded shadow-2xs">${escapedStatus || 'Chờ lượt'}</span>`;
                        }
                    }

                    return `<tr data-patient="${escapedName}" data-makb="${makb}" data-mabn="${mabn}"
                                                data-room-type="duoc"
                                                class="remote-item group ${rowClass}"
                                                tabindex="0">
                                            <td class="cell-stt ${pyClass} px-1 text-center">
                                                ${p.stt}
                                            </td>
                                            <td class="${pyClass} px-3 text-blue-900">
                                                <div class="patient-name-container select-none flex items-center min-w-0">
                                                    <span class="patient-name-text uppercase whitespace-normal break-words leading-tight max-w-full ${isNear ? 'text-red-700' : 'text-blue-900'}">
                                                        ${escapedName.toUpperCase()}
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="cell-namsinh ${pyClass} px-1 text-center">
                                                ${namSinh}
                                            </td>
                                            ${col4Html}
                                            <td class="${pyClass} px-1 text-center">
                                                <div class="flex items-center justify-center gap-1.5 flex-nowrap min-w-0">
                                                    ${col5Badge}
                                                    <button type="button"
                                                            title="Ẩn bệnh nhân khỏi màn hình"
                                                            aria-label="Ẩn bệnh nhân"
                                                            onclick="hidePatientRow(this, event)"
                                                            class="btn-hide-patient p-1 text-slate-300 hover:text-danger hover:bg-red-50 rounded transition cursor-pointer shrink-0 opacity-40 group-hover:opacity-100 hover:opacity-100"
                                                            tabindex="0">
                                                        <i class="fas fa-trash-alt text-xs"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>`;
                }

                // Tự động tính toán lại và chia cột khi thay đổi kích thước màn hình / F11
                let resizeTimer;
                window.addEventListener('resize', () => {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(() => {
                        if (currentActiveList && currentActiveList.length > 0) {
                            buildSplitView(currentActiveList);
                        }
                    }, 100);
                });

                // ═══════════════ SIGNALR REALTIME & POLLING FALLBACK ═══════════════
                let hubConnection = null;
                let isFetchingQueue = false;
                let lastQueueJson = '';

                function initSignalR() {
                    if (!window.signalR) {
                        console.warn("[SignalR] Không tìm thấy thư viện signalR. Dùng Polling 3s fallback.");
                        return;
                    }

                    hubConnection = new signalR.HubConnectionBuilder()
                        .withUrl("/queueHub")
                        .withAutomaticReconnect([0, 1000, 2000, 3000, 5000])
                        .build();

                    hubConnection.on("room_data_updated", (payload) => {
                        if (payload && payload.roomType === "duoc") {
                            // Mode all: nhận update từ cả bhyt và dichvu
                            if (DUOC_TYPE === 'all' || payload.roomId === DUOC_TYPE) {
                                fetchQueueData();
                            }
                        }
                    });

                    // Lắng nghe lệnh phát loa trực tiếp khi quầy bấm chọn ô cửa
                    hubConnection.on("duoc_trigger_speak", (payload) => {
                        if (!payload || !payload.hoTen) return;
                        unlockAudio();
                        isSoundEnabled = true;
                        localStorage.setItem("duocSoundEnabled", "true");
                        updateSoundIcon();
                        audioQueue.clear();

                        const targetLoc = payload.oCua ? `ô số ${payload.oCua}` : "quầy";
                        const speakText = `Mời bệnh nhân, ${payload.hoTen}, đến ${targetLoc}`;
                        audioQueue.enqueue(speakText);
                    });

                    async function startHub() {
                        try {
                            await hubConnection.start();
                            console.log("[SignalR] Kết nối thành công Hub.");
                            if (DUOC_TYPE === 'all') {
                                await hubConnection.invoke("JoinRoom", "duoc", "bhyt").catch(() => { });
                                await hubConnection.invoke("JoinRoom", "duoc", "dichvu").catch(() => { });
                            } else {
                                await hubConnection.invoke("JoinRoom", "duoc", DUOC_TYPE);
                            }
                        } catch (err) {
                            console.warn("[SignalR] Kết nối thất bại, tự động thử lại sau 3 giây...", err);
                            setTimeout(startHub, 3000);
                        }
                    }

                    hubConnection.onreconnected(async () => {
                        console.log("[SignalR] Đã kết nối lại Hub.");
                        if (DUOC_TYPE === 'all') {
                            await hubConnection.invoke("JoinRoom", "duoc", "bhyt").catch(() => { });
                            await hubConnection.invoke("JoinRoom", "duoc", "dichvu").catch(() => { });
                        } else {
                            await hubConnection.invoke("JoinRoom", "duoc", DUOC_TYPE);
                        }
                    });

                    startHub();
                }

                async function fetchQueueData() {
                    if (isFetchingQueue) return;
                    isFetchingQueue = true;
                    try {
                        const res = await fetch(`/api/duoc/queue?type=${DUOC_TYPE}`);
                        if (!res.ok) return;
                        const data = await res.json();
                        renderQueue(data);
                    } catch (err) {
                        console.warn('Lỗi cập nhật hàng chờ:', err);
                    } finally {
                        isFetchingQueue = false;
                    }
                }

                function isPatientHidden(p) {
                    if (!p) return false;
                    const pMakb = (p.makb || '').trim();
                    const pMabn = (p.mabn || '').trim();
                    const pName = (p.tenBenhNhan || '').trim().toLowerCase();
                    return hiddenPatients.some(h => {
                        const hMakb = (h.makb || '').trim();
                        const hMabn = (h.mabn || '').trim();
                        const hName = (h.name || '').trim().toLowerCase();
                        if (hMakb && pMakb && hMakb === pMakb) return true;
                        if (hMabn && pMabn && hMabn === pMabn) return true;
                        if (hName && pName && hName === pName) return true;
                        return false;
                    });
                }

                function renderQueue(data) {
                    if (!data) return;

                    const rawList = data.waitingList || [];
                    // Lọc bỏ ngay các bệnh nhân trong danh sách đã ẩn
                    const list = rawList.filter(p => !isPatientHidden(p));

                    // Đánh lại STT liên tục
                    list.forEach((p, idx) => {
                        p.stt = idx + 1;
                        p.isToiLuot = (idx === 0);
                    });

                    // Cập nhật thống kê
                    const waitEl = document.getElementById('totalWaiting');
                    if (waitEl) waitEl.textContent = list.length;

                    const queueJson = JSON.stringify(list);
                    if (queueJson === lastQueueJson) return; // Không đổi → giữ nguyên
                    lastQueueJson = queueJson;

                    // Xác định bệnh nhân ưu tiên cần đọc
                    const targetPatient = list.find(p => p.isToiLuot) || list[0] || null;
                    if (targetPatient) {
                        currentTopPatient = targetPatient;
                        const currentKey = `${targetPatient.makb || targetPatient.mabn || ''}_${targetPatient.trangThai || ''}`;
                        if (lastCalledPatientKey !== '' && currentKey !== lastCalledPatientKey) {
                            lastCalledPatientKey = currentKey;
                            if (isAutoSpeakEnabled) { speakTargetPatient(targetPatient); }
                        } else if (lastCalledPatientKey === '') {
                            lastCalledPatientKey = currentKey;
                        }
                    } else {
                        currentTopPatient = null;
                    }

                    // Cập nhật tiêu đề
                    const titleEl = document.querySelector('.tv-room-title');
                    if (titleEl && data.title) titleEl.textContent = data.title;

                    // Rebuild split view
                    buildSplitView(list);
                }

                // ═══════════════ QUẢN LÝ BỆNH NHÂN ĐÃ XÓA / ẨN ═══════════════
                function updateHiddenBadge() {
                    const badge = document.getElementById('hiddenBadgeCount');
                    if (!badge) return;
                    const count = hiddenPatients.length;
                    if (count > 0) {
                        badge.textContent = count;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }

                function toggleHiddenModal(show) {
                    const modal = document.getElementById('hiddenPatientsModal');
                    if (!modal) return;
                    if (show) {
                        renderHiddenModalList();
                        modal.classList.remove('hidden');
                    } else {
                        modal.classList.add('hidden');
                    }
                }

                function renderHiddenModalList() {
                    const container = document.getElementById('hiddenPatientsListContainer');
                    if (!container) return;

                    if (hiddenPatients.length === 0) {
                        container.innerHTML = `
                                                                <div class="text-center py-8 text-slate-400 font-bold italic">
                                                                    <i class="fas fa-info-circle text-2xl mb-2 block text-slate-300"></i>
                                                                    Không có bệnh nhân nào bị ẩn gần đây.
                                                                </div>`;
                        return;
                    }

                    let html = '<div class="divide-y divide-slate-100">';
                    hiddenPatients.forEach((p, idx) => {
                        html += `
                                                                <div class="py-3 px-2 flex items-center justify-between gap-3 hover:bg-slate-50 rounded-lg">
                                                                    <div class="flex flex-col">
                                                                        <span class="font-extrabold text-blue-900 text-base md:text-lg uppercase">${escapeHtml(p.name)}</span>
                                                                        <span class="text-xs text-slate-500 font-semibold">Mã: ${escapeHtml(p.makb || p.mabn || '—')} &bull; Ẩn lúc: ${escapeHtml(p.time || '')}</span>
                                                                    </div>
                                                                    <button onclick="restoreHiddenPatient(${idx})"
                                                                            class="remote-item px-3 py-1.5 bg-blue-50 hover:bg-brand hover:text-white text-brand border border-blue-200 rounded-lg text-xs md:text-sm font-black transition cursor-pointer"
                                                                            tabindex="0">
                                                                        <i class="fas fa-undo mr-1"></i> Khôi phục
                                                                    </button>
                                                                </div>`;
                    });
                    html += '</div>';
                    container.innerHTML = html;
                }

                async function hidePatientRow(btn, event) {
                    if (event) { event.stopPropagation(); event.preventDefault(); }
                    const row = btn.closest('tr');
                    if (!row) return;

                    const makb = (row.getAttribute('data-makb') || '').trim();
                    const mabn = (row.getAttribute('data-mabn') || '').trim();
                    const name = (row.getAttribute('data-patient') || '').trim();

                    // Phản hồi tức thì (0ms)
                    const now = new Date();
                    const timeStr = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                    hiddenPatients.unshift({ makb, mabn, name, time: timeStr });
                    if (hiddenPatients.length > 50) hiddenPatients.pop();
                    localStorage.setItem(hiddenStorageKey, JSON.stringify(hiddenPatients));
                    updateHiddenBadge();
                    row.remove();

                    // Cập nhật đếm
                    const waitEl = document.getElementById('totalWaiting');
                    if (waitEl) {
                        const currentCount = parseInt(waitEl.textContent || '0', 10);
                        waitEl.textContent = Math.max(0, currentCount - 1);
                    }

                    showToast(`Đã ẩn bệnh nhân ${name || ''} khỏi màn hình`, 'info');

                    // Xác định targetDagiao: DV dùng 2, BHYT dùng 1
                    // Đọc loại từ data attribute nếu có, hoặc xem row có badge DV không
                    const targetDagiao = (DUOC_TYPE === 'dichvu') ? 2 : (DUOC_TYPE === 'all' ? 2 : 1);
                    try {
                        const res = await fetch('/api/duoc-nhap/cap-nhat-trang-thai', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ makb, mabn, targetDagiao })
                        });
                        const data = await res.json();
                        if (!data.success) console.warn('Lỗi từ máy chủ khi ẩn:', data.message);
                        lastQueueJson = '';
                        fetchQueueData();
                    } catch (e) {
                        console.warn('Lỗi kết nối khi ẩn bệnh nhân:', e);
                    }
                }

                async function restoreHiddenPatient(index) {
                    if (index < 0 || index >= hiddenPatients.length) return;
                    const p = hiddenPatients[index];

                    try {
                        const res = await fetch('/api/duoc-nhap/cap-nhat-trang-thai', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ makb: p.makb, mabn: p.mabn, targetDagiao: 0 })
                        });
                        const data = await res.json();
                        if (data.success) {
                            showToast(`Đã khôi phục bệnh nhân ${p.name || ''}`, 'info');
                            hiddenPatients.splice(index, 1);
                            localStorage.setItem(hiddenStorageKey, JSON.stringify(hiddenPatients));
                            updateHiddenBadge();
                            renderHiddenModalList();
                            fetchQueueData();
                        } else {
                            showToast(data.message || 'Không thể khôi phục bệnh nhân', 'danger');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'danger');
                    }
                }

                async function restoreAllHiddenPatients() {
                    if (hiddenPatients.length === 0) return;
                    let successCount = 0;

                    for (const p of [...hiddenPatients]) {
                        try {
                            const res = await fetch('/api/duoc-nhap/cap-nhat-trang-thai', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ makb: p.makb, mabn: p.mabn, targetDagiao: 0 })
                            });
                            const data = await res.json();
                            if (data.success) successCount++;
                        } catch (e) { }
                    }

                    hiddenPatients = [];
                    localStorage.removeItem(hiddenStorageKey);
                    updateHiddenBadge();
                    renderHiddenModalList();
                    fetchQueueData();
                    showToast(`Đã khôi phục ${successCount} bệnh nhân!`, 'info');
                }

                // Toast thông báo trên màn hình TV (Đã tắt theo yêu cầu)
                function showToast(message, type = 'info') {
                    // Tắt hiển thị thông báo góc phải màn hình TV
                }

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                // ═══════════════ KHỞI ĐỘNG ═══════════════
                updateSoundIcon();
                updateAutoSpeakIcon();
                updateHiddenBadge();

                // Khởi tạo bảng phân trang từ dữ liệu SSR
                (function initFromSSR() {
                    // Lấy rows từ tbody SSR
                    const tbody = document.getElementById('patientTableBody');
                    if (!tbody) { buildSplitView([]); return; }

                    const ssrRows = Array.from(tbody.querySelectorAll('tr[data-patient]'));
                    if (ssrRows.length === 0) {
                        buildSplitView([]);
                        return;
                    }

                    // Rebuild từ data JSON ban đầu
                    const initialList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        queueList.Select(p => new
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    stt = p.Stt,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                mabn = p.Mabn,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                makb = p.Makb,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                tenBenhNhan = p.TenBenhNhan,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                namSinh = p.NamSinh,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                trangThai = p.TrangThai,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                isToiLuot = p.IsToiLuot,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                isBhyt = p.IsBhyt,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                soTienStr = p.SoTienStr,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                khochan = p.Khochan,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        dagiao = p.Dagiao,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        oCua = p.OCua
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                })
                                        ));

                    // Ẩn ssrTableWrapper sau khi dùng
                    const ssrWrapper = document.getElementById('ssrTableWrapper');
                    if (ssrWrapper) ssrWrapper.remove();

                    // Lọc hidden
                    const filteredList = initialList.filter(p => !isPatientHidden(p));
                    filteredList.forEach((p, idx) => { p.stt = idx + 1; p.isToiLuot = (idx === 0); });

                    // Cập nhật số đang chờ theo hidden
                    const waitEl = document.getElementById('totalWaiting');
                    if (waitEl) waitEl.textContent = filteredList.length;

                    buildSplitView(filteredList);
                })();

                initSignalR();

                // Đọc ngay lần đầu nếu đã có danh sách khi trang load VÀ tự động đọc đang BẬT
                if (isSoundEnabled && isAutoSpeakEnabled && currentTopPatient) {
                    document.addEventListener('click', function _firstClick() {
                        document.removeEventListener('click', _firstClick);
                        if (isAutoSpeakEnabled) speakTargetPatient(currentTopPatient);
                    }, { once: true });
                    document.addEventListener('keydown', function _firstKey() {
                        document.removeEventListener('keydown', _firstKey);
                        if (isAutoSpeakEnabled) speakTargetPatient(currentTopPatient);
                    }, { once: true });
                }

                // Fallback polling mỗi 3 giây
                setInterval(fetchQueueData, 3000);
        </script>
    </body>

</html>
