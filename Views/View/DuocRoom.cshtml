@model HangChoKhamBenh.Web.Models.DuocRoomViewModel
@{
    Layout = null;
    var isBhyt = Model.DuocType == "bhyt";
    var isDichVu = Model.DuocType == "dichvu";
    var isAll = Model.DuocType == "all";
    var queueList = Model.QueueList ?? new List<HangChoKhamBenh.Web.Models.DuocQueueItemDto>();
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title - Bệnh Viện Tâm Minh Đức</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/board.css?v=audio-autoplay-1">
    @await Html.PartialAsync("~/Views/Shared/_Favicons.cshtml")
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#1e40af',
                            danger: '#dc2626',
                            success: '#16a34a',
                            accent: '#0f172a',
                        }
                    }
                }
            }
    </script>
    <style>
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            .duoc-patient-table {
                table-layout: fixed !important;
                width: 100% !important;
            }

            .duoc-patient-table thead {
                background: #e2e8f0 !important;
            }

            .duoc-patient-table th {
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: nowrap !important;
                font-weight: 900 !important;
                letter-spacing: 0 !important;
                text-align: center !important;
                color: #1e3a8a !important;
            }

            .duoc-patient-table th:first-child {
                text-align: left !important;
            }

            .duoc-patient-table td {
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                vertical-align: middle !important;
            }

            .duoc-patient-table .patient-name-container {
                overflow: hidden !important;
                max-width: 100% !important;
                min-width: 0 !important;
            }

            .duoc-patient-table .patient-name-text {
                display: -webkit-box !important;
                -webkit-line-clamp: 2 !important;
                -webkit-box-orient: vertical !important;
                white-space: normal !important;
                word-break: break-word !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                line-height: 1.15 !important;
                max-width: 100% !important;
                font-weight: 900 !important;
                letter-spacing: -0.01em !important;
                color: #1e3a8a !important;
            }

            /* --- CHẾ ĐỘ 1 BẢNG (KHI <= 6-8 BỆNH NHÂN): CHỮ CỰC TO, ĐẬM NÉT, RÕ RÀNG TRÊN TV 43 INCH --- */
            .duoc-table-single th {
                font-size: clamp(20px, 1.8vw, 30px) !important;
                padding: 10px 3px !important;
            }

            .duoc-table-single th:first-child {
                text-align: left !important;
                padding-left: 18px !important;
            }

            .duoc-table-single .patient-name-text {
                font-size: clamp(38px, 3.8vw, 62px) !important;
                font-weight: 900 !important;
                color: #1e3a8a !important;
                line-height: 1.15 !important;
            }

            .duoc-table-single td.cell-namsinh {
                font-size: clamp(26px, 2.6vw, 42px) !important;
                font-weight: 900 !important;
                text-align: center !important;
                color: #1e3a8a !important;
            }

            .duoc-table-single .badge-money {
                font-size: clamp(22px, 2.2vw, 34px) !important;
                font-weight: 900 !important;
                padding: 4px 6px !important;
            }

            .duoc-table-single .badge-status {
                font-size: clamp(20px, 2.0vw, 30px) !important;
                font-weight: 900 !important;
                padding: 4px 6px !important;
                white-space: nowrap !important;
            }

            /* --- CHẾ ĐỘ 2 CỘT: CHỮ TO RÕ RÀNG, KHOẢNG 7-9 HÀNG MỖI BÊN --- */
            .duoc-table-split th {
                font-size: clamp(14px, 1.2vw, 20px) !important;
                padding: 8px 3px !important;
            }

            .duoc-table-split th:first-child {
                text-align: left !important;
                padding-left: 10px !important;
            }

            .duoc-table-split .patient-name-text {
                font-size: clamp(28px, 2.7vw, 44px) !important;
                font-weight: 900 !important;
                color: #1e3a8a !important;
                line-height: 1.15 !important;
            }

            .duoc-table-split td.cell-namsinh {
                font-size: clamp(18px, 1.7vw, 28px) !important;
                font-weight: 900 !important;
                text-align: center !important;
                color: #1e3a8a !important;
            }

            .duoc-table-split .badge-money {
                font-size: clamp(15px, 1.35vw, 22px) !important;
                font-weight: 900 !important;
                padding: 2px 4px !important;
            }

            .duoc-table-split .badge-status {
                font-size: clamp(13px, 1.15vw, 19px) !important;
                font-weight: 900 !important;
                padding: 2px 4px !important;
                letter-spacing: -0.01em !important;
                white-space: nowrap !important;
            }

            /* Kích thước hàng và chữ được tính theo phần màn hình thực có. */
            #mainContent, #paginationContainer {
                min-height: 0;
            }

            .duoc-patient-table thead tr,
            .duoc-patient-table th {
                height: 44px !important;
            }

            .duoc-patient-table th {
                padding: 4px 6px !important;
                font-size: var(--duoc-header-font, 17px) !important;
                line-height: 1.1 !important;
            }

            .duoc-patient-table tbody tr,
            .duoc-patient-table tbody td {
                height: var(--duoc-row-height, 74px) !important;
            }

            .duoc-patient-table tbody td {
                padding: 2px 6px !important;
                line-height: 1.1 !important;
            }

            .duoc-patient-table .patient-name-container {
                height: calc(var(--duoc-row-height, 74px) - 6px);
                width: 100%;
                align-items: center;
            }

            .duoc-patient-table .patient-name-text {
                display: -webkit-box !important;
                -webkit-line-clamp: 2 !important;
                -webkit-box-orient: vertical !important;
                font-size: var(--duoc-name-font, 24px) !important;
                /* Chừa khoảng cho dấu tiếng Việt và giữ hai dòng vừa trong chiều cao hàng. */
                line-height: 1.3 !important;
                white-space: normal !important;
                word-break: normal !important;
                overflow-wrap: anywhere;
                overflow: hidden !important;
                max-height: calc(var(--duoc-row-height, 74px) - 6px);
            }

            .duoc-patient-table td.cell-namsinh {
                font-size: var(--duoc-year-font, 24px) !important;
                font-variant-numeric: tabular-nums;
            }

            .duoc-patient-table .badge-money {
                font-size: var(--duoc-money-font, 18px) !important;
                padding: 3px 5px !important;
                max-width: 100% !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: nowrap !important;
                font-variant-numeric: tabular-nums;
            }

            .duoc-patient-table .badge-status {
                display: inline-flex !important;
                align-items: center;
                min-width: 0;
                font-size: var(--duoc-status-font, 16px) !important;
                padding: 3px 6px !important;
                max-width: 100% !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: nowrap !important;
            }

            .duoc-patient-table .badge-pickup {
                font-size: clamp(20px, 2vw, 34px) !important;
                font-weight: 900 !important;
                padding: 5px 12px !important;
                background: #1d4ed8 !important;
                color: #fff !important;
                border-color: #1e3a8a !important;
                box-shadow: 0 2px 6px rgba(30, 64, 175, 0.25);
            }

            .badge-pickup .duoc-status-window {
                margin-left: 0;
            }

            .duoc-status-label {
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .duoc-status-window {
                flex-shrink: 0;
                margin-left: 4px;
            }

            .duoc-notice {
                flex: none;
                padding: 3px 0;
                background: transparent;
                overflow: hidden;
                color: #b91c1c;
                font-size: clamp(12px, 1vw, 17px);
                font-weight: 800;
                line-height: 1.4;
            }

            .duoc-notice-text {
                display: inline-block;
                padding-left: 100%;
                white-space: nowrap;
                animation: duoc-notice-scroll 40s linear infinite;
            }

            .duoc-notice:hover .duoc-notice-text {
                animation-play-state: paused;
            }

            @@keyframes duoc-notice-scroll {
                from { transform: translateX(0); }
                to { transform: translateX(-100%); }
            }

            @@media (prefers-reduced-motion: reduce) {
                .duoc-notice-text {
                    animation: none;
                    display: block;
                    padding-left: 0;
                    white-space: normal;
                    text-align: center;
                }
            }
    </style>
</head>

<body class="tv-board bg-slate-100 text-slate-900 font-sans flex flex-col h-screen overflow-hidden select-none">

    <!-- Top Bar Header -->
    <header
        class="tv-header relative flex justify-between items-center bg-white py-1 px-3 border-2 border-slate-300 shadow-sm gap-2 shrink-0">
        <!-- Bên trái: Logo -->
        <div class="tv-brand flex items-center bg-white gap-3 shrink-0">
            <a href="/">
                <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-12 md:h-14 object-contain">
            </a>
        </div>

        <!-- Ở giữa: Đồng hồ ngày giờ lớn, căn giữa nổi bật -->
        <div class="tv-clock flex flex-col items-center justify-center text-center tabular-nums mx-auto">
            <div id="date-str"
                 class="tv-clock-date text-xs md:text-sm text-red-600 font-bold uppercase tracking-widest leading-tight">
            </div>
            <div id="time-str" class="tv-clock-time text-2xl md:text-3xl font-black text-brand leading-none mt-0.5"></div>
        </div>

        <!-- Bên phải: Controls & Counters -->
        <div class="tv-actions flex items-center gap-2 shrink-0">
            <div
                class="tv-stat tv-stat--waiting bg-red-50 px-3 py-1 text-center min-w-[90px] rounded border border-red-200">
                <span class="block text-danger font-bold text-[10px] uppercase tracking-wide">Đang chờ</span>
                <span id="totalWaiting"
                      class="block text-danger font-black text-lg md:text-xl tabular-nums leading-none mt-0.5">
                    @Model.TotalWaiting
                </span>
            </div>


            <!-- Nút quay lại -->
            <a href="/duoc"
               class="remote-item icon-button bg-slate-50 hover:bg-red-50 hover:border-red-300 border-2 border-slate-300 text-slate-500 hover:text-danger px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition-colors inline-flex items-center gap-1"
               tabindex="0" aria-label="Về danh sách quầy Dược" title="Về danh sách quầy Dược (Esc)">
                <i class="fas fa-arrow-left"></i>
            </a>
        </div>
    </header>

    <main id="mainContent" class="flex-grow overflow-hidden flex flex-col">
        <div id="paginationContainer" class="flex-grow overflow-hidden flex flex-col">
            <div id="ssrTableWrapper" class="room-container flex-grow overflow-hidden flex flex-col bg-white ">
                <table
                    class="w-full h-full border-collapse table-fixed select-none duoc-patient-table duoc-table-single">
                    <colgroup>
                        <col style="width: 47%;">
                        <col style="width: 10%;">
                        <col style="width: 18%;">
                        <col style="width: 25%;">
                    </colgroup>
                    <thead
                        class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300 text-blue-900 uppercase font-extrabold text-xl md:text-2xl">
                        <tr>
                            <th class="py-2 px-3 text-left">Họ và Tên</th>
                            <th class="py-2 px-2 text-center">Năm Sinh</th>
                            <th class="py-2 px-2 text-center">Số Tiền</th>
                            <th class="py-2 px-2 text-center">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody id="patientTableBody" class="divide-y divide-slate-200">
                        @if (queueList.Count == 0)
                        {
                            <tr id="empty-row">
                                <td colspan="4" class="text-center py-16 text-slate-400 text-3xl font-bold italic">
                                    Không có bệnh nhân chờ lĩnh thuốc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int index = 0; index < queueList.Count; index++)
                            {
                                var p = queueList[index];
                                var currentPatientName = (p.TenBenhNhan ?? "").Trim();
                                var pIsBhyt = p.IsBhyt;
                                var loaiClass = pIsBhyt
                                    ? "bg-blue-100 text-blue-800 border-blue-300"
                                    : ((p.Khochan == 13 || p.Khochan == 3)
                                        ? "bg-purple-100 text-purple-800 border-purple-300"
                                        : "bg-emerald-100 text-emerald-800 border-emerald-300");
                                var rowKey = (!string.IsNullOrEmpty(p.Makb) ? $"makb_{p.Makb}" : (!string.IsNullOrEmpty(p.Mabn) ? $"mabn_{p.Mabn}" : $"name_{currentPatientName}")).Trim();
                                var isChoThu = (p.TrangThai == "Chờ thu" || p.TrangThai == "Chờ thu tiền" || p.DaThu == false);
                                var assignedWindow = p.OCua?.Trim();
                                var windowLabel = assignedWindow is "3" or "5" ? $"→ Ô {assignedWindow}" : "";
                                var rowClass = isChoThu
                                    ? "border-l-[8px] border-amber-400 bg-amber-50/70 shadow-xs"
                                    : "border-l-[8px] border-blue-500 bg-blue-50/60 shadow-xs";

                                <tr data-key="@rowKey" data-patient="@currentPatientName" data-nam-sinh="@(p.NamSinh ?? "")" data-makb="@(p.Makb ?? "")" data-mabn="@(p.Mabn ?? "")" data-status="@(p.TrangThai ?? "")" data-ocua="@(p.OCua ?? "")"
                                    data-room-type="duoc"
                                    class="@rowClass border-b border-slate-200">
                                    <td
                                        class="py-3 px-2 text-blue-900 text-2xl md:text-4xl font-black">
                                        <div class="patient-name-container select-none flex items-center min-w-0">
                                            <span
                                                class="patient-name-text whitespace-normal break-words leading-tight max-w-full block">
                                                @((!string.IsNullOrEmpty(currentPatientName) ? currentPatientName : "Chưa cập nhật").ToUpper())
                                            </span>
                                        </div>
                                    </td>
                                    <td
                                        class="cell-namsinh py-2 px-1 font-bold text-center text-blue-900 text-2xl md:text-4xl font-bold">
                                        @p.NamSinh
                                    </td>
                                    <td class="py-3 px-1 text-center overflow-hidden">
                                        @if (!string.IsNullOrEmpty(p.SoTienStr) && p.SoTienStr != "—")
                                        {
                                            <span
                                                class="badge-money inline-block px-2 py-1 rounded-lg border font-black font-mono text-base md:text-xl lg:text-2xl whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs">
                                                @p.SoTienStr
                                            </span>
                                        }
                                        else if (!pIsBhyt)
                                        {
                                            <span
                                                class="badge-money inline-block px-2 py-1 rounded-lg border font-black font-mono text-base md:text-xl lg:text-2xl whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs">
                                                @(!string.IsNullOrEmpty(p.SoTienStr) ? p.SoTienStr : "—")
                                            </span>
                                        }
                                        else
                                        {
                                            <span
                                                class="badge-money inline-block px-3 py-1 rounded-lg border font-bold text-sm md:text-lg uppercase whitespace-nowrap @loaiClass">
                                                BHYT
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-2 text-center overflow-hidden">
                                        <div class="flex items-center justify-center gap-1.5 flex-nowrap min-w-0">
                                            @if (isChoThu)
                                            {
                                                <span
                                                    class="badge-status inline-block bg-amber-100 text-amber-900 px-3 md:px-5 py-1.5 rounded-lg text-base md:text-xl font-black uppercase whitespace-nowrap border-2 border-amber-300 shadow-sm">
                                                    <span class="duoc-status-label">Chờ thu tiền</span>
                                                    @if (windowLabel != "")
                                                    {
                                                        <span class="duoc-status-window">@windowLabel</span>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span
                                                    class="badge-status badge-pickup inline-block rounded-lg font-black uppercase whitespace-nowrap border-2">
                                                    <span class="duoc-status-window">@(windowLabel != "" ? windowLabel : "→ 3")</span>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="duoc-notice">
        <span class="duoc-notice-text">Quý khách vui lòng ngồi chờ gọi tên và kiểm tra thuốc trước khi rời quầy. Xin cảm ơn!</span>
    </footer>

    <!-- SCRIPTS -->
        <script src="/js/signalr.min.js?v=@DateTime.UtcNow.Ticks"></script>
        <script src="/js/audioQueue.js?v=@DateTime.UtcNow.Ticks"></script>
        <script>
                let DUOC_TYPE = '@Model.DuocType'; // "bhyt", "dichvu", or "all"

                function extractBirthYear(val, rowEl = null) {
                    if (val !== undefined && val !== null) {
                        const str = typeof val === "object" ? (val.namSinh || val.dobStr || val.dob || val.ngaysinh || "") : String(val).trim();
                        if (str && str !== "Chưa cập nhật" && str !== "null" && str !== "undefined") {
                            const match = str.match(/(19\d{2}|20\d{2})/);
                            if (match) return match[1];
                        }
                    }
                    if (rowEl) {
                        const attr = rowEl.getAttribute("data-nam-sinh") || rowEl.dataset?.namSinh || rowEl.getAttribute("data-dob-year") || rowEl.dataset?.dobYear || "";
                        if (attr && attr.trim() !== "Chưa cập nhật") {
                            const match = attr.match(/(19\d{2}|20\d{2})/);
                            if (match) return match[1];
                        }
                        const cells = rowEl.querySelectorAll("td");
                        for (const cell of cells) {
                            const txt = cell.textContent.trim();
                            const match = txt.match(/\b(19\d{2}|20\d{2})\b/);
                            if (match) return match[1];
                        }
                    }
                    return "";
                }
                window.extractBirthYear = extractBirthYear;

                // Mỗi lần mở màn hình đều bật loa; tắt loa chỉ áp dụng cho phiên này.
                let isSoundEnabled = true;

                // ═══════════════ HỆ THỐNG ÂM THANH & GIỌNG ĐỌC (TTS) ═══════════════
                const audioQueue = new window.AudioQueueManager({
                    isEnabled: () => isSoundEnabled,
                    gapMs: 350,
                    onPlaybackStateChange: () => updateSoundIcon(),
                });

                function updateSoundIcon() {
                    const icon = document.getElementById('soundIcon');
                    const btn = document.getElementById('soundToggleBtn');
                    if (isSoundEnabled) {
                        if (icon) icon.className = 'fas fa-volume-up text-green-600';
                        if (btn) {
                            btn.title = 'Loa tổng: ĐANG BẬT';
                            btn.className = 'icon-button bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        }
                    } else {
                        if (icon) icon.className = 'fas fa-volume-mute text-slate-400';
                        if (btn) {
                            btn.title = 'Loa tổng: ĐANG TẮT';
                            btn.className = 'icon-button bg-white border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        }
                    }
                    window.QueueAudio.updateSoundControl(audioQueue, isSoundEnabled);
                }

                function toggleSound(forceOn) {
                    if (typeof forceOn === 'boolean') {
                        isSoundEnabled = forceOn;
                    } else {
                        isSoundEnabled = !isSoundEnabled;
                    }
                    window.QueueAudio.unlock();
                    updateSoundIcon();

                    if (!isSoundEnabled) {
                        audioQueue.clear();
                    }
                }

                // Xác định nội dung hành động gọi loa: 'đóng tiền' hoặc 'nhận thuốc'
                function getActionText(status, daThu) {
                    if (status === "Chờ thu tiền" || status === "Chờ thu" || daThu === false) return "đóng tiền";
                    return "nhận thuốc";
                }

                // Đồng hồ Header
                function updateTime() {
                    const now = new Date();
                    const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
                    const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
                    const dateStrEl = document.getElementById('date-str');
                    const timeStrEl = document.getElementById('time-str');
                    if (dateStrEl) dateStrEl.textContent = now.toLocaleDateString('vi-VN', dateOpts);
                    if (timeStrEl) timeStrEl.textContent = now.toLocaleTimeString('vi-VN', timeOpts);
                }
                setInterval(updateTime, 1000);
                updateTime();

                // Biến toàn cục lưu danh sách bệnh nhân đang hiển thị
                let currentActiveList = [];

                const PAGE_ROTATION_INTERVAL = 12000;
                let currentPageIndex = 0;
                let paginationTimer = null;
                let splitLayoutActive = false;
                let duocShell = null;
                const patientRows = new Map();

                function calculateRowsPerColumn(isSplit = false) {
                    const container = document.getElementById('paginationContainer');
                    const totalHeight = container?.clientHeight || Math.max(180, window.innerHeight - 110);
                    const availableBodyHeight = Math.max(60, totalHeight - 46);
                    const targetHeight = isSplit ? 68 : 82;
                    return Math.max(1, Math.min(18, Math.floor(availableBodyHeight / targetHeight)));
                }

                function getRowHeightPx(rowsCount) {
                    const container = document.getElementById('paginationContainer');
                    const totalHeight = container?.clientHeight || Math.max(180, window.innerHeight - 110);
                    return Math.floor(Math.max(60, totalHeight - 46) / Math.max(1, rowsCount));
                }

                function getDuocLayout(patientCount) {
                    const singleRowsCapacity = calculateRowsPerColumn(false);
                    const leftColumnCapacity = calculateRowsPerColumn(true);
                    const canSplit = window.innerWidth >= 1180;
                    // Sau khi chia cột, giữ bố cục đến khi hết hàng chờ hoặc màn hình hẹp lại.
                    // Số hàng cố định giúp thêm/bớt một người không làm đổi cỡ chữ cả bảng.
                    splitLayoutActive = canSplit && patientCount > 0
                        && (splitLayoutActive || patientCount > leftColumnCapacity);
                    const isSplit = splitLayoutActive;
                    const rowsPerCol = canSplit ? leftColumnCapacity : singleRowsCapacity;
                    return { isSplit, rowsPerCol, pageCapacity: isSplit ? rowsPerCol * 2 : rowsPerCol };
                }

                function updatePageIndicator(current, total) {
                    const badge = document.getElementById('pageBadge');
                    const badgeText = document.getElementById('pageBadgeText');
                    if (!badge || !badgeText) return;
                    if (total > 1) {
                        const text = `${current}/${total}`;
                        if (badgeText.textContent !== text) badgeText.textContent = text;
                    }
                    badge.classList.toggle('hidden', total <= 1);
                }

                function ensureDuocShell(container) {
                    if (duocShell) return duocShell;
                    // Tạo khung bảng một lần; các bản cập nhật chỉ sửa những dòng thay đổi.
                    container.innerHTML = `
                        <div data-duoc-empty class="hidden room-container flex-grow bg-white border-2 border-slate-300 rounded-lg flex items-center justify-center shadow-sm h-full">
                            <p class="text-center text-slate-400 text-2xl md:text-4xl font-bold italic">Không có bệnh nhân chờ lĩnh thuốc.</p>
                        </div>
                        <div data-duoc-columns class="flex-grow flex flex-row gap-3 h-full overflow-hidden w-full min-w-0">
                            <div class="room-container flex-1 min-w-0 bg-white border-2 border-slate-300 rounded-lg flex flex-col shadow-sm overflow-hidden h-full">
                                ${buildTableHtml([], false, 74)}
                            </div>
                            <div class="hidden room-container flex-1 min-w-0 bg-white border-2 border-slate-300 rounded-lg flex flex-col shadow-sm overflow-hidden h-full">
                                ${buildTableHtml([], false, 74)}
                            </div>
                        </div>`;
                    const columns = container.querySelector('[data-duoc-columns]');
                    duocShell = {
                        empty: container.querySelector('[data-duoc-empty]'),
                        columns,
                        panels: Array.from(columns.children),
                        tables: Array.from(columns.querySelectorAll('table')),
                        bodies: Array.from(columns.querySelectorAll('tbody')),
                        layout: '',
                    };
                    return duocShell;
                }

                function getPatientRowKey(patient) {
                    const makb = String(patient.makb || '').trim();
                    const mabn = String(patient.mabn || '').trim();
                    return makb ? `makb_${makb}` : mabn ? `mabn_${mabn}`
                        : `name_${String(patient.tenBenhNhan || '').trim()}_${patient.namSinh || ''}`;
                }

                function syncAttributes(target, source) {
                    Array.from(target.attributes).forEach(attr => {
                        if (!source.hasAttribute(attr.name)) target.removeAttribute(attr.name);
                    });
                    Array.from(source.attributes).forEach(attr => {
                        if (target.getAttribute(attr.name) !== attr.value) target.setAttribute(attr.name, attr.value);
                    });
                }

                function updatePatientRows(tbody, patients, isSplit, rowHeightPx) {
                    const wanted = new Set();
                    const pyClass = isSplit ? 'py-1.5 md:py-2' : 'py-2.5 md:py-3.5';
                    let position = tbody.firstElementChild;
                    patients.forEach(patient => {
                        const key = getPatientRowKey(patient);
                        wanted.add(key);
                        const html = buildRowHtml(patient, isSplit, pyClass, rowHeightPx);
                        let cached = patientRows.get(key);
                        if (!cached || cached.html !== html) {
                            const template = document.createElement('template');
                            template.innerHTML = html.trim();
                            const fresh = template.content.firstElementChild;
                            if (!cached) {
                                cached = { row: fresh, html };
                                patientRows.set(key, cached);
                            } else {
                                // Giữ nguyên dòng và các ô không đổi, kể cả khi đổi trạng thái/ô cửa.
                                syncAttributes(cached.row, fresh);
                                Array.from(fresh.children).forEach((cell, index) => {
                                    const existing = cached.row.children[index];
                                    syncAttributes(existing, cell);
                                    if (existing.innerHTML !== cell.innerHTML) existing.innerHTML = cell.innerHTML;
                                });
                                cached.html = html;
                            }
                        }
                        if (cached.row !== position) tbody.insertBefore(cached.row, position);
                        position = cached.row.nextElementSibling;
                    });
                    Array.from(tbody.children).forEach(row => {
                        if (!wanted.has(row.dataset.key)) row.remove();
                    });
                }

                function renderDuocView(list = currentActiveList, preservePage = false) {
                    const container = document.getElementById('paginationContainer');
                    if (!container) return;

                    if (!list) list = [];
                    currentActiveList = list;
                    const shell = ensureDuocShell(container);
                    shell.empty.classList.toggle('hidden', list.length > 0);
                    shell.columns.classList.toggle('hidden', list.length === 0);
                    const activeKeys = new Set(list.map(getPatientRowKey));
                    patientRows.forEach((cached, key) => {
                        if (!activeKeys.has(key)) {
                            cached.row.remove();
                            patientRows.delete(key);
                        }
                    });

                    if (list.length === 0) {
                        if (paginationTimer) { clearInterval(paginationTimer); paginationTimer = null; }
                        splitLayoutActive = false;
                        currentPageIndex = 0;
                        updatePageIndicator(0, 0);
                        return;
                    }

                    const { isSplit, rowsPerCol, pageCapacity } = getDuocLayout(list.length);
                    const rowHeightPx = getRowHeightPx(rowsPerCol);

                    // 3. Tính số trang
                    const totalPages = Math.max(1, Math.ceil(list.length / pageCapacity));
                    currentPageIndex = preservePage ? Math.min(currentPageIndex, totalPages - 1) : 0;

                    updatePageIndicator(currentPageIndex + 1, totalPages);

                    // Lấy danh sách bệnh nhân thuộc trang hiện tại
                    const startIdx = currentPageIndex * pageCapacity;
                    const pageItems = list.slice(startIdx, startIdx + pageCapacity);
                    const layout = `${isSplit}:${rowHeightPx}:${window.innerWidth}`;
                    if (shell.layout !== layout) {
                        shell.panels[1].classList.toggle('hidden', !isSplit);
                        shell.tables.forEach(table => {
                            table.classList.toggle('duoc-table-split', isSplit);
                            table.classList.toggle('duoc-table-single', !isSplit);
                            table.setAttribute('style', `table-layout:fixed;${getTableSizeVars(isSplit, rowHeightPx)}`);
                            const widths = isSplit ? [52, 9, 16, 23] : [52, 8, 18, 22];
                            table.querySelectorAll('col').forEach((col, index) => col.style.width = `${widths[index]}%`);
                            table.querySelectorAll('th')[1].textContent = isSplit ? 'Năm' : 'Năm Sinh';
                        });
                        shell.layout = layout;
                    }
                    // Trang cuối vẫn giữ hai cột và cùng cỡ chữ như các trang trước.
                    updatePatientRows(shell.bodies[0], pageItems.slice(0, rowsPerCol), isSplit, rowHeightPx);
                    updatePatientRows(shell.bodies[1], isSplit ? pageItems.slice(rowsPerCol) : [], isSplit, rowHeightPx);

                    // Tự động xoay trang nếu có hơn 1 trang
                    if (totalPages > 1) {
                        if (!paginationTimer) {
                            paginationTimer = setInterval(() => {
                                const { pageCapacity: curCapacity } = getDuocLayout(currentActiveList.length);
                                const curTotalPages = Math.max(1, Math.ceil(currentActiveList.length / curCapacity));
                                if (curTotalPages > 1) {
                                    currentPageIndex = (currentPageIndex + 1) % curTotalPages;
                                    renderDuocView(currentActiveList, true);
                                } else {
                                    clearInterval(paginationTimer);
                                    paginationTimer = null;
                                    updatePageIndicator(1, 1);
                                }
                            }, PAGE_ROTATION_INTERVAL);
                        }
                    } else {
                        if (paginationTimer) { clearInterval(paginationTimer); paginationTimer = null; }
                    }
                }

                function getTableSizeVars(isSplit, rowHeightPx) {
                    // Cùng cỡ chữ cho mọi tên; tối đa hai dòng với line-height 1.3.
                    const nameFont = Math.max(18, Math.min(isSplit ? 40 : 52,
                        Math.floor((rowHeightPx - 6) / 2.6),
                        Math.floor(window.innerWidth * (isSplit ? 0.024 : 0.032))));

                    const yearFont = Math.max(15, Math.min(isSplit ? 26 : 32,
                        Math.floor(rowHeightPx * 0.36), Math.floor(window.innerWidth * (isSplit ? 0.015 : 0.02))));
                    const moneyFont = Math.max(12, Math.min(isSplit ? 20 : 27,
                        Math.floor(rowHeightPx * 0.28), Math.floor(window.innerWidth * (isSplit ? 0.012 : 0.016))));
                    const statusFont = Math.max(11, Math.min(isSplit ? 17 : 23,
                        Math.floor(rowHeightPx * 0.26), Math.floor(window.innerWidth * (isSplit ? 0.011 : 0.013))));
                    const headerFont = Math.max(12, Math.min(isSplit ? 18 : 22,
                        Math.floor(window.innerWidth * (isSplit ? 0.011 : 0.014))));
                    return `--duoc-row-height:${rowHeightPx}px;--duoc-name-font:${nameFont}px;--duoc-year-font:${yearFont}px;--duoc-money-font:${moneyFont}px;--duoc-status-font:${statusFont}px;--duoc-header-font:${headerFont}px`;
                }

                function buildTableHtml(rows, isSplit, rowHeightPx) {
                    const pyClass = isSplit ? 'py-1.5 md:py-2' : 'py-2.5 md:py-3.5';
                    const modeClass = isSplit ? 'duoc-table-split' : 'duoc-table-single';
                    const sizeVars = getTableSizeVars(isSplit, rowHeightPx);

                    const colWidths = isSplit
                        ? `<col style="width: 52%;">
                           <col style="width: 9%;">
                           <col style="width: 16%;">
                           <col style="width: 23%;">`
                        : `<col style="width: 52%;">
                           <col style="width: 8%;">
                           <col style="width: 18%;">
                           <col style="width: 22%;">`;

                    const rowList = rows || [];
                    let tbodyContent = '';

                    for (let i = 0; i < rowList.length; i++) {
                        tbodyContent += buildRowHtml(rowList[i], isSplit, pyClass, rowHeightPx);
                    }

                    return `
                        <div class="flex-grow overflow-hidden w-full bg-white flex flex-col h-full">
                            <table class="patient-table duoc-patient-table ${modeClass} w-full text-left border-collapse" style="table-layout: fixed;${sizeVars}">
                                <colgroup>
                                    ${colWidths}
                                </colgroup>
                                <thead class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300 text-blue-900 uppercase font-black shrink-0" style="height: 44px;">
                                    <tr>
                                        <th class="py-2.5 px-3 text-left font-black">Họ và Tên</th>
                                        <th class="py-2.5 px-1 text-center font-black">${isSplit ? 'Năm' : 'Năm Sinh'}</th>
                                        <th class="py-2.5 px-1 text-center font-black">Số Tiền</th>
                                        <th class="py-2.5 px-1 text-center font-black">Trạng Thái</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-200">
                                    ${tbodyContent}
                                </tbody>
                            </table>
                        </div>`;
                }

                function buildRowHtml(p, isSplit, pyClass, rowHeightPx) {
                    const rawName = (p.tenBenhNhan || '').trim();
                    const escapedName = escapeHtml(rawName);
                    const escapedStatus = escapeHtml(p.trangThai || '');
                    const namSinh = escapeHtml(p.namSinh || '—');
                    const makb = escapeHtml(p.makb || '');
                    const mabn = escapeHtml(p.mabn || '');
                    const pIsBhyt = p.isBhyt;

                    const rowKey = escapeHtml(getPatientRowKey(p));

                    const isChoThu = (p.trangThai === "Chờ thu" || p.trangThai === "Chờ thu tiền" || p.daThu === false);
                    const rowClass = isChoThu
                        ? 'border-l-[6px] md:border-l-[8px] border-amber-400 bg-amber-50/70 shadow-xs border-b border-slate-200'
                        : 'border-l-[6px] md:border-l-[8px] border-blue-500 bg-blue-50/60 shadow-xs border-b border-slate-200';

                    let col4Html = '';
                    if (p.soTienStr && p.soTienStr !== '—' && p.soTienStr !== '') {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                        <div class="flex items-center justify-center min-w-0 max-w-full">
                                            <span title="${escapeHtml(p.soTienStr)}" class="badge-money inline-block rounded-lg border font-mono whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs font-extrabold max-w-full">
                                                ${escapeHtml(p.soTienStr)}
                                            </span>
                                        </div>
                                    </td>`;
                    } else if (!pIsBhyt) {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                        <div class="flex items-center justify-center min-w-0 max-w-full">
                                            <span class="badge-money inline-block rounded-lg border font-mono whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs max-w-full">
                                                ${escapeHtml(p.soTienStr || '—')}
                                            </span>
                                        </div>
                                    </td>`;
                    } else {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                        <div class="flex items-center justify-center min-w-0 max-w-full">
                                            <span class="badge-money inline-block rounded-lg border font-extrabold uppercase whitespace-nowrap bg-blue-100 text-blue-800 border-blue-300 shadow-2xs max-w-full">
                                                BHYT
                                            </span>
                                        </div>
                                    </td>`;
                    }

                    // Cột Trạng Thái: Đúng 2 trạng thái chuẩn: "Chờ thu tiền" hoặc "Đang soạn thuốc"
                    const assignedWindow = String(p.oCua || '').trim();
                    const windowLabel = ['3', '5'].includes(assignedWindow) ? ` → Ô ${assignedWindow}` : '';
                    const windowBadge = windowLabel ? `<span class="duoc-status-window">${windowLabel.trim()}</span>` : '';
                    const col5Badge = isChoThu
                        ? `<span title="Chờ thu tiền${windowLabel}" class="badge-status inline-block bg-amber-100 text-amber-900 border-2 border-amber-300 font-black uppercase whitespace-nowrap rounded-lg shadow-2xs"><span class="duoc-status-label">${isSplit ? 'Chờ thu' : 'Chờ thu tiền'}</span>${windowBadge}</span>`
                        : `<span title="Nhận thuốc${windowLabel}" class="badge-status badge-pickup border-2 font-black uppercase whitespace-nowrap rounded-lg"><span class="duoc-status-window">${windowLabel.trim() || '→ 3'}</span></span>`;

                    const heightStyle = rowHeightPx ? `style="height: ${rowHeightPx}px;"` : '';

                    return `<tr data-key="${rowKey}" data-patient="${escapedName}" data-nam-sinh="${namSinh}" data-makb="${makb}" data-mabn="${mabn}" data-status="${escapedStatus || ''}" data-ocua="${p.oCua || ''}"
                                data-room-type="duoc"
                                ${heightStyle}
                                class="${rowClass}">

                                <td class="${pyClass} px-3 text-blue-900 overflow-hidden">
                                    <div class="patient-name-container select-none flex items-center min-w-0">
                                        <span title="${escapedName}" class="patient-name-text uppercase whitespace-normal break-words leading-tight max-w-full font-black text-blue-900">
                                            ${escapedName.toUpperCase()}
                                        </span>
                                    </div>
                                </td>
                                <td class="cell-namsinh ${pyClass} px-1 text-center font-black text-blue-900">
                                    ${namSinh}
                                </td>
                                ${col4Html}
                                <td class="${pyClass} px-1 text-center">
                                    <div class="flex items-center justify-center min-w-0 max-w-full">
                                        ${col5Badge}
                                    </div>
                                </td>
                            </tr>`;
                }

                let hubConnection = null;
                let isFetchingQueue = false;
                let lastSnapshotVersion = 0;
                let lastRealtimeTimestamp = 0;
                let realtimeGeneration = 0;
                let fallbackPollingTimer = null;
                let duocDisconnectStartTime = null;

                // Cơ chế tự động tải lại dự phòng khi mất kết nối kéo dài
                function triggerDuocFallbackReload(reason) {
                    try {
                        const now = Date.now();
                        const lastReload = parseInt(sessionStorage.getItem("last_duoc_reload_ts") || "0", 10);
                        if (now - lastReload < 60000) return;
                        sessionStorage.setItem("last_duoc_reload_ts", String(now));
                        console.warn(`[Duoc Watchdog] Kích hoạt Fallback Reload (${reason}). Đang làm mới màn hình...`);
                        setTimeout(() => window.location.reload(), 800);
                    } catch (e) {
                        window.location.reload();
                    }
                }

                // Tự động làm mới bộ nhớ định kỳ 04:30 sáng
                const duocPageLoadedAt = Date.now();
                setInterval(() => {
                    const now = new Date();
                    if (now.getHours() === 4 && now.getMinutes() === 30 && (Date.now() - duocPageLoadedAt > 6 * 3600 * 1000)) {
                        triggerDuocFallbackReload("Làm mới bộ nhớ định kỳ 04:30 sáng");
                    }
                }, 60000);

                function startFallbackPolling() {
                    if (fallbackPollingTimer) return;
                    console.log("[Duoc Polling] Kích hoạt Fallback Polling 5s do SignalR tạm ngắt...");
                    fetchQueueData();
                    fallbackPollingTimer = setInterval(fetchQueueData, 5000);
                }

                function stopFallbackPolling() {
                    if (fallbackPollingTimer) {
                        clearInterval(fallbackPollingTimer);
                        fallbackPollingTimer = null;
                        console.log("[Duoc Polling] Dừng Fallback Polling (SignalR đã hoạt động lại).");
                    }
                }

                function initSignalR() {
                    if (!window.signalR) {
                        console.warn("[SignalR] Không tìm thấy thư viện signalR. Kích hoạt Polling định kỳ 5s.");
                        startFallbackPolling();
                        return;
                    }

                    hubConnection = new signalR.HubConnectionBuilder()
                        .withUrl("/queueHub")
                        .withAutomaticReconnect({
                            nextRetryDelayInMilliseconds: (retryContext) => {
                                const delays = [0, 1000, 2000, 3000, 5000];
                                return delays[retryContext.previousAttempts] || 5000;
                            }
                        })
                        .build();

                    hubConnection.on("room_data_updated", (payload) => {
                        duocDisconnectStartTime = null;
                        if (payload && payload.roomType === "duoc") {
                            if (payload.roomId === DUOC_TYPE && payload.data) {
                                const version = Number(payload.data.snapshotVersion || 0);
                                // Tương thích máy chủ cũ; máy chủ mới dùng phiên bản từ lúc bắt đầu đọc.
                                if (!version && payload.timestamp && payload.timestamp < lastRealtimeTimestamp) return;
                                if (renderQueue(payload.data)) {
                                    realtimeGeneration++;
                                    lastRealtimeTimestamp = Math.max(lastRealtimeTimestamp, payload.timestamp || 0);
                                }
                            } else if (DUOC_TYPE === 'all' || payload.roomId === DUOC_TYPE) {
                                fetchQueueData();
                            }
                        }
                    });

                    // Lắng nghe lệnh phát loa trực tiếp khi quầy bấm chọn ô cửa
                    hubConnection.on("duoc_trigger_speak", (payload) => {
                        duocDisconnectStartTime = null;
                        if (!payload || !payload.hoTen) return;
                        window.QueueAudio.unlock();
                        isSoundEnabled = true;
                        updateSoundIcon();

                        const targetLoc = payload.oCua ? `ô số ${payload.oCua}` : "quầy";
                        const dobClean = extractBirthYear(payload.namSinh || payload.dobYear || payload.dobStr);
                        const dobText = dobClean ? `, sinh năm ${dobClean}` : "";
                        const actionText = getActionText(payload.trangThai, payload.daThu);
                        const speakText = `Mời bệnh nhân, ${payload.hoTen}${dobText}. Đến ${targetLoc}, ${actionText}.`;
                        audioQueue.enqueue(speakText, {
                            hoTen: payload.hoTen,
                            oCua: payload.oCua,
                            makb: payload.makb,
                            mabn: payload.mabn
                        });
                    });

                    hubConnection.onreconnecting(() => {
                        if (!duocDisconnectStartTime) duocDisconnectStartTime = Date.now();
                        startFallbackPolling();
                    });

                    hubConnection.onreconnected(async () => {
                        const wasDisconnectedLong = duocDisconnectStartTime && (Date.now() - duocDisconnectStartTime > 60000);
                        duocDisconnectStartTime = null;
                        stopFallbackPolling();
                        console.log("[SignalR] Đã kết nối lại Hub.");
                        await hubConnection.invoke("JoinRoom", "duoc", DUOC_TYPE).catch(() => { });
                        fetchQueueData();
                        if (wasDisconnectedLong) {
                            triggerDuocFallbackReload("Mạng gián đoạn hơn 60 giây và vừa phục hồi");
                        }
                    });

                    hubConnection.onclose(() => {
                        if (!duocDisconnectStartTime) duocDisconnectStartTime = Date.now();
                        startFallbackPolling();
                        console.warn("[SignalR] Kết nối Hub bị đóng. Tự động kết nối lại...");
                        setTimeout(startHub, 3000);
                    });

                    async function startHub() {
                        if (hubConnection.state === signalR.HubConnectionState.Connected) return;
                        try {
                            await hubConnection.start();
                            duocDisconnectStartTime = null;
                            stopFallbackPolling();
                            console.log("[SignalR] Kết nối thành công Hub.");
                            await hubConnection.invoke("JoinRoom", "duoc", DUOC_TYPE).catch(() => { });
                            fetchQueueData();
                        } catch (err) {
                            if (!duocDisconnectStartTime) duocDisconnectStartTime = Date.now();
                            startFallbackPolling();
                            console.warn("[SignalR] Kết nối thất bại, tự động thử lại sau 3 giây...", err);
                            setTimeout(startHub, 3000);
                        }
                    }

                    if (typeof window !== "undefined") {
                        window.addEventListener("online", () => {
                            console.log("[Duoc TV] Thiết bị có mạng lại (Online). Đang kết nối lại SignalR...");
                            startHub();
                        });
                        window.addEventListener("offline", () => {
                            console.warn("[Duoc TV] Mất kết nối mạng (Offline).");
                            if (!duocDisconnectStartTime) duocDisconnectStartTime = Date.now();
                            startFallbackPolling();
                        });
                    }

                    startHub();
                }

                async function fetchQueueData() {
                    if (isFetchingQueue) return;
                    isFetchingQueue = true;
                    const generationAtStart = realtimeGeneration;
                    try {
                        const res = await fetch(`/api/duoc/queue?type=${DUOC_TYPE}`, { cache: 'no-store' });
                        if (!res.ok) return;
                        const data = await res.json();
                        // Một phản hồi cũ không có phiên bản không được ghi đè SignalR vừa nhận.
                        if (!data.snapshotVersion && generationAtStart !== realtimeGeneration) return;
                        renderQueue(data);
                    } catch (err) {
                        console.warn('Lỗi cập nhật hàng chờ:', err);
                    } finally {
                        isFetchingQueue = false;
                    }
                }

                function renderQueue(data) {
                    if (!data) return false;
                    const version = Number(data.snapshotVersion || 0);
                    if (version && version <= lastSnapshotVersion) return false;
                    if (!version && lastSnapshotVersion) return false;
                    if (version) lastSnapshotVersion = version;
                    const list = Array.isArray(data.waitingList) ? data.waitingList : [];

                    // Cập nhật thống kê
                    const waitEl = document.getElementById('totalWaiting');
                    if (waitEl && waitEl.textContent !== String(list.length)) waitEl.textContent = list.length;

                    // Cập nhật tiêu đề
                    const titleEl = document.querySelector('.tv-room-title');
                    if (titleEl && data.title && titleEl.textContent !== data.title) titleEl.textContent = data.title;

                    // Render danh sách (bảo lưu trang đang xem nếu hợp lệ)
                    renderDuocView(list, true);
                    return true;
                }

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                // ═══════════════ KHỞI ĐỘNG ═══════════════
                updateSoundIcon();

                // Khởi tạo bảng phân trang từ dữ liệu SSR
                (function initFromSSR() {
                    const initialList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(queueList));
                    renderQueue({ waitingList: initialList });
                })();

                // Lắng nghe thay đổi kích thước màn hình / zoom để tự động điều chỉnh số hàng (+1, +2...)
                let resizeDebounce = null;
                window.addEventListener('resize', () => {
                    clearTimeout(resizeDebounce);
                    resizeDebounce = setTimeout(() => {
                        renderDuocView(currentActiveList, true);
                    }, 150);
                });

                initSignalR();

        </script>
    </body>

</html>
