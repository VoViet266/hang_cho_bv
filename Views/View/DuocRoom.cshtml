@model HangChoKhamBenh.Web.Models.DuocRoomViewModel
@{
    Layout = null;
    var isBhyt = Model.DuocType == "bhyt";
    var isDichVu = Model.DuocType == "dichvu";
    var isAll = Model.DuocType == "all";
    var queueList = Model.QueueList ?? new List<HangChoKhamBenh.Web.Models.DuocQueueItemDto>();
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title - Bệnh Viện Tâm Minh Đức</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/board.css">
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#1e40af',
                            danger: '#dc2626',
                            success: '#16a34a',
                            accent: '#0f172a',
                        }
                    }
                }
            }
    </script>
    <style>
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            @@keyframes pulse-red {
                0%,
                100% {
                    transform: scale(1);
                    opacity: 1;
                }
                50% {
                    transform: scale(1.02);
                    opacity: 0.95;
                }
            }

            .animate-pulse-red {
                animation: pulse-red 2s infinite ease-in-out;
            }

            /* --- ANIMATION MƯỢT MÀ CHO HÀNG & CHUYỂN ĐỐI TƯỢNG (FLIP & GLIDE) --- */
            .duoc-patient-table tbody tr {
                /* Giữ nền tảng mượt mà, KHÔNG đặt animation mặc định ở đây để tránh chớp cả bảng */
                transition: background-color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
                will-change: transform;
            }

            .duoc-patient-table tbody tr.row-glide-enter {
                animation: rowGlideEnter 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
            }

            @@keyframes rowGlideEnter {
                0% {
                    opacity: 0;
                    transform: translateY(16px);
                }
                100% {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Hiệu ứng nổi bật, phát sáng êm dịu khi bệnh nhân lên đầu / tới lượt (Không chớp giật) */
            @@keyframes smoothTopPulse {
                0%, 100% {
                    background-color: #fef08a; /* amber-200 / yellow-200 */
                    box-shadow: inset 0 0 0 2px #eab308, 0 4px 16px -2px rgba(234, 179, 8, 0.35);
                }
                50% {
                    background-color: #fef9c3; /* yellow-100 */
                    box-shadow: inset 0 0 0 2px #ca8a04, 0 6px 22px -2px rgba(234, 179, 8, 0.55);
                }
            }

            .row-toi-luot-active {
                animation: smoothTopPulse 2.4s infinite ease-in-out !important;
                position: relative;
                z-index: 10;
            }

            .duoc-patient-table tbody tr:hover {
                transform: translateY(-1px) scale(1.002);
                box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.08);
            }

            .badge-money, .badge-status, .badge-ocua {
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .duoc-patient-table {
                table-layout: fixed !important;
                width: 100% !important;
            }

            .duoc-patient-table thead {
                background: #e2e8f0 !important;
            }

            .duoc-patient-table th {
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: nowrap !important;
                font-weight: 900 !important;
                letter-spacing: 0 !important;
                text-align: center !important;
                color: #1e3a8a !important;
            }

            .duoc-patient-table th:first-child {
                text-align: left !important;
            }

            .duoc-patient-table td {
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                vertical-align: middle !important;
            }

            .duoc-patient-table .patient-name-container {
                overflow: hidden !important;
                max-width: 100% !important;
                min-width: 0 !important;
            }

            .duoc-patient-table .patient-name-text {
                display: -webkit-box !important;
                -webkit-line-clamp: 2 !important;
                -webkit-box-orient: vertical !important;
                white-space: normal !important;
                word-break: break-word !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                line-height: 1.15 !important;
                max-width: 100% !important;
                font-weight: 900 !important;
                letter-spacing: -0.01em !important;
                color: #1e3a8a !important;
            }

            /* --- CHẾ ĐỘ 1 BẢNG (KHI ÍT BỆNH NHÂN <= 10): CHỮ VỪA VẶN, HÀI HÒA, KHÔNG BỊ PHÓNG TO QUÁ ĐÀ --- */
            .duoc-table-single th {
                font-size: clamp(13px, 1.15vw, 17px) !important;
                padding: 6px 3px !important;
            }

            .duoc-table-single th:first-child {
                padding-left: 12px !important;
            }

            .duoc-table-single .patient-name-text {
                font-size: clamp(16px, 1.45vw, 24px) !important;
                color: #1e3a8a !important;
            }

            .duoc-table-single td.cell-namsinh {
                font-size: clamp(15px, 1.3vw, 20px) !important;
                font-weight: 800 !important;
                text-align: center !important;
            }

            .duoc-table-single .badge-money {
                font-size: clamp(13px, 1.15vw, 17px) !important;
                font-weight: 800 !important;
                padding: 3px 8px !important;
            }

            .duoc-table-single .badge-status {
                font-size: clamp(12px, 1.0vw, 15.5px) !important;
                font-weight: 800 !important;
                padding: 3px 6px !important;
                white-space: nowrap !important;
            }

            /* --- CHẾ ĐỘ 2 BẢNG (KHI NHIỀU BỆNH NHÂN HOẶC PHÂN TRANG): CHỮ CÂN ĐỐI 2 BÊN --- */
            .duoc-table-split th {
                font-size: clamp(12px, 1.05vw, 16px) !important;
                padding: 6px 2px !important;
            }

            .duoc-table-split th:first-child {
                padding-left: 10px !important;
            }

            .duoc-table-split .patient-name-text {
                font-size: clamp(14px, 1.25vw, 21px) !important;
                color: #1e3a8a !important;
            }

            .duoc-table-split td.cell-namsinh {
                font-size: clamp(13px, 1.15vw, 18px) !important;
                font-weight: 800 !important;
                text-align: center !important;
            }

            .duoc-table-split .badge-money {
                font-size: clamp(11px, 0.95vw, 15px) !important;
                font-weight: 800 !important;
                padding: 2px 5px !important;
            }

            .duoc-table-split .badge-status {
                font-size: clamp(10px, 0.85vw, 13.5px) !important;
                font-weight: 800 !important;
                padding: 2px 4px !important;
                letter-spacing: -0.01em !important;
                white-space: nowrap !important;
            }
    </style>
</head>

<body class="tv-board bg-slate-100 text-slate-900 font-sans flex flex-col h-screen overflow-hidden select-none">

    <!-- Top Bar Header -->
    <header
        class="tv-header flex flex-col md:flex-row justify-between items-start md:items-center bg-white py-1 px-2.5 border-2 border-slate-300 shadow-sm gap-2 shrink-0">
        <!-- Logo & Đồng hồ -->
        <div class="tv-brand flex items-center bg-white gap-3">
            <a href="/">
                <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-12 md:h-14 object-contain">
            </a>
            <div class="tabular-nums">
                <div id="date-str"
                     class="tv-clock-date text-xs text-slate-500 font-bold uppercase tracking-widest leading-tight">
                </div>
                <div id="time-str" class="tv-clock-time text-xl md:text-2xl font-black text-brand leading-none"></div>
            </div>
        </div>

        <!-- Tiêu đề -->
        <div class="tv-room-heading flex flex-col flex-1 text-center items-center justify-center">
            <h1
                class="tv-room-title tv-numbered-room-title text-danger text-xl md:text-4xl font-extrabold uppercase tracking-wide">
                Hàng Chờ Dược
            </h1>
        </div>

        <!-- Controls & Counters -->
        <div class="tv-actions flex items-center gap-2">

            <div
                class="tv-stat tv-stat--waiting bg-red-50 px-3 py-1 text-center min-w-[90px] rounded border border-red-200">
                <span class="block text-danger font-bold text-[10px] uppercase tracking-wide">Đang chờ</span>
                <span id="totalWaiting"
                      class="block text-danger font-black text-lg md:text-xl tabular-nums leading-none mt-0.5">
                    @Model.TotalWaiting
                </span>
            </div>

            <!-- Badge Phân Trang (Hiện khi có nhiều trang) -->
            <div id="pageBadge"
                class="hidden bg-blue-50 px-2.5 py-1 text-center min-w-[70px] rounded border border-blue-200">
                <span class="block text-brand font-bold text-[10px] uppercase tracking-wide">Trang</span>
                <span id="pageBadgeText"
                      class="block text-brand font-black text-lg md:text-xl tabular-nums leading-none mt-0.5">
                    1/1
                </span>
            </div>

            <!-- Nút bật âm thanh (Phím A / S) -->
            <button id="soundToggleBtn" onclick="toggleSound()"
                    class="remote-item icon-button bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer"
                    tabindex="0" aria-label="Bật hoặc tắt âm thanh" title="Bật/Tắt âm thanh (Phím A hoặc S)">
                <i id="soundIcon" class="fas fa-volume-up text-green-600"></i>
            </button>

            <!-- Nút quay lại -->
            <a href="/duoc"
               class="remote-item icon-button bg-slate-50 hover:bg-red-50 hover:border-red-300 border-2 border-slate-300 text-slate-500 hover:text-danger px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition-colors inline-flex items-center gap-1"
               tabindex="0" aria-label="Về danh sách quầy Dược" title="Về danh sách quầy Dược (Esc)">
                <i class="fas fa-arrow-left"></i>
            </a>
        </div>
    </header>

    <!-- MAIN: BẢNG DANH SÁCH HÀNG CHỜ PHÁT THUỐC (GỘP BHYT + DỊCH VỤ) -->
    <main id="mainContent" class="flex-grow p-1.5 overflow-hidden flex flex-col">
        <!-- Container phân trang — JS sẽ tạo các .queue-page-block bên trong -->
        <div id="paginationContainer" class="flex-grow overflow-hidden flex flex-col">
            <!-- SSR fallback: hiển thị bảng tĩnh (JS sẽ replace sau khi đo chiều cao) -->
            <div id="ssrTableWrapper"
                 class="room-container flex-grow overflow-hidden flex flex-col bg-white border-2 border-slate-300 rounded-lg shadow-sm">
                <table
                    class="w-full h-full border-collapse table-fixed select-none duoc-patient-table duoc-table-single">
                    <colgroup>
                        <col style="width: 50%;">
                        <col style="width: 14%;">
                        <col style="width: 18%;">
                        <col style="width: 18%;">
                    </colgroup>
                    <thead
                        class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300 text-blue-900 uppercase font-extrabold text-xl md:text-2xl">
                        <tr>
                            <th class="py-3 px-4 text-left">Họ và Tên</th>
                            <th class="py-3 px-3 text-center">Năm Sinh</th>
                            <th class="py-3 px-3 text-center">Số Tiền</th>
                            <th class="py-3 px-3 text-center">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody id="patientTableBody" class="divide-y divide-slate-200">
                        @if (queueList.Count == 0)
                        {
                            <tr id="empty-row">
                                <td colspan="4" class="text-center py-16 text-slate-400 text-3xl font-bold italic">
                                    Không có bệnh nhân chờ lĩnh thuốc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int index = 0; index < queueList.Count; index++)
                            {
                                var p = queueList[index];
                                var isNear = p.IsToiLuot;
                                var currentPatientName = (p.TenBenhNhan ?? "").Trim();
                                var pIsBhyt = p.IsBhyt;
                                var loaiClass = pIsBhyt
                                    ? "bg-blue-100 text-blue-800 border-blue-300"
                                    : ((p.Khochan == 13 || p.Khochan == 3)
                                        ? "bg-purple-100 text-purple-800 border-purple-300"
                                        : "bg-emerald-100 text-emerald-800 border-emerald-300");
                                var rowKey = (!string.IsNullOrEmpty(p.Makb) ? $"makb_{p.Makb}" : (!string.IsNullOrEmpty(p.Mabn) ? $"mabn_{p.Mabn}" : $"name_{currentPatientName}")).Trim();

                                <tr data-key="@rowKey" data-patient="@currentPatientName" data-nam-sinh="@(p.NamSinh ?? "")" data-makb="@(p.Makb ?? "")" data-mabn="@(p.Mabn ?? "")" data-status="@(p.TrangThai ?? "")" data-ocua="@(p.OCua ?? "")"
                                    data-room-type="duoc"
                                    class="@(isNear ? "row-toi-luot-active bg-yellow-100 border-l-[10px] border-yellow-500 shadow-md" : (pIsBhyt ? "border-l-[6px] border-blue-400 bg-blue-50/60" : "border-l-[6px] border-emerald-400 bg-emerald-50/50")) border-b border-slate-200">
                                    <td
                                        class="py-4 px-4 text-blue-900 @(isNear ? "text-3xl md:text-5xl font-black tracking-tight" : "text-2xl md:text-4xl font-black")">
                                        <div class="patient-name-container select-none flex items-center min-w-0">
                                            <span
                                                class="patient-name-text whitespace-normal break-words leading-tight max-w-full block">
                                                @((!string.IsNullOrEmpty(currentPatientName) ? currentPatientName : "Chưa cập nhật").ToUpper())
                                            </span>
                                        </div>
                                    </td>
                                    <td
                                        class="py-4 px-3 font-bold text-center text-blue-900 @(isNear ? "text-3xl md:text-5xl font-black" : "text-2xl md:text-4xl font-bold")">
                                        @p.NamSinh
                                    </td>
                                    <td class="py-4 px-3 text-center overflow-hidden">
                                        @if (!string.IsNullOrEmpty(p.SoTienStr) && p.SoTienStr != "—")
                                        {
                                            <span
                                                class="inline-block px-3 py-1 rounded-lg border font-black font-mono text-base md:text-xl lg:text-2xl whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs">
                                                @p.SoTienStr
                                            </span>
                                        }
                                        else if (!pIsBhyt)
                                        {
                                            <span
                                                class="inline-block px-3 py-1 rounded-lg border font-black font-mono text-base md:text-xl lg:text-2xl whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs">
                                                @(!string.IsNullOrEmpty(p.SoTienStr) ? p.SoTienStr : "—")
                                            </span>
                                        }
                                        else
                                        {
                                            <span
                                                class="inline-block px-3 py-1 rounded-lg border font-bold text-sm md:text-lg uppercase whitespace-nowrap @loaiClass">
                                                BHYT
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-3 text-center overflow-hidden">
                                        <div class="flex items-center justify-center gap-1.5 flex-nowrap min-w-0">
                                            @if (p.TrangThai == "Chờ thu")
                                            {
                                                <span
                                                    class="inline-block bg-amber-50 text-amber-800 px-3 md:px-5 py-1.5 rounded-lg text-base md:text-xl font-black uppercase whitespace-nowrap border-2 border-amber-300 shadow-sm @(isNear ? "animate-pulse-red" : "")">
                                                    Chờ thu tiền
                                                </span>
                                            }
                                            else
                                            {
                                                <span
                                                    class="inline-block bg-blue-50 text-blue-800 px-3 md:px-5 py-1.5 rounded-lg text-base md:text-xl font-black uppercase whitespace-nowrap border-2 border-blue-300 shadow-sm @(isNear ? "animate-pulse-red" : "")">
                                                    Đang soạn thuốc
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- FOOTER THÔNG BÁO -->
    <footer
        class="bg-white border-2 border-slate-300 rounded-lg px-3 py-1 mx-1.5 mb-1 flex items-center gap-2 shrink-0 shadow-sm overflow-hidden">
        <span
            class="px-2 py-0.5 bg-red-100 text-danger border border-red-300 rounded font-bold uppercase shrink-0 text-xs">Lưu
            ý</span>
        <marquee class="text-slate-700 font-bold text-sm md:text-base">
            Quý bệnh nhân vui lòng chuẩn bị sẵn Đơn thuốc, Thẻ BHYT và CCCD khi nghe gọi tên đến quầy nhận thuốc.
        </marquee>
    </footer>

    <!-- SCRIPTS -->
        <script src="/js/signalr.min.js?v=@DateTime.UtcNow.Ticks"></script>
        <script src="/js/audioQueue.js?v=@DateTime.UtcNow.Ticks"></script>
        <script>
                let DUOC_TYPE = '@Model.DuocType'; // "bhyt", "dichvu", or "all"

                function extractBirthYear(val, rowEl = null) {
                    if (val !== undefined && val !== null) {
                        const str = typeof val === "object" ? (val.namSinh || val.dobStr || val.dob || val.ngaysinh || "") : String(val).trim();
                        if (str && str !== "Chưa cập nhật" && str !== "null" && str !== "undefined") {
                            const match = str.match(/(19\d{2}|20\d{2})/);
                            if (match) return match[1];
                        }
                    }
                    if (rowEl) {
                        const attr = rowEl.getAttribute("data-nam-sinh") || rowEl.dataset?.namSinh || rowEl.getAttribute("data-dob-year") || rowEl.dataset?.dobYear || "";
                        if (attr && attr.trim() !== "Chưa cập nhật") {
                            const match = attr.match(/(19\d{2}|20\d{2})/);
                            if (match) return match[1];
                        }
                        const cells = rowEl.querySelectorAll("td");
                        for (const cell of cells) {
                            const txt = cell.textContent.trim();
                            const match = txt.match(/\b(19\d{2}|20\d{2})\b/);
                            if (match) return match[1];
                        }
                    }
                    return "";
                }
                window.extractBirthYear = extractBirthYear;

                // Trạng thái âm thanh: Mặc định luôn BẬT
                let isSoundEnabled = localStorage.getItem("duocSoundEnabled") !== "false";
                let isAutoSpeakEnabled = localStorage.getItem("duocAutoSpeakEnabled") === "true";
                let audioUnlocked = false;

                // Key lưu vết lần gọi gần nhất
                let lastCalledPatientKey = '@(queueList.Count > 0 ? $"{(queueList[0].Makb ?? queueList[0].Mabn ?? "")}_{queueList[0].TrangThai ?? ""}" : "")';
                let currentTopPatient = @Html.Raw(queueList.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(new
                    {
                        tenBenhNhan = queueList[0].TenBenhNhan,
                        trangThai = queueList[0].TrangThai,
                        makb = queueList[0].Makb,
                        mabn = queueList[0].Mabn,
                        namSinh = queueList[0].NamSinh,
                        isBhyt = queueList[0].IsBhyt,
                        oCua = queueList[0].OCua
                    }) : "null");

                // ═══════════════ HỆ THỐNG ÂM THANH & GIỌNG ĐỌC (TTS) ═══════════════
                const audioQueue = new window.AudioQueueManager({
                    isEnabled: () => isSoundEnabled,
                    gapMs: 350,
                });

                function unlockAudio() {
                    if (audioUnlocked) return;
                    audioUnlocked = true;
                    try {
                        const silent = new Audio('/audio/silent.mp3');
                        silent.volume = 0.01;
                        silent.play().catch(() => { });
                    } catch (e) { }
                }

                function updateSoundIcon() {
                    const icon = document.getElementById('soundIcon');
                    const btn = document.getElementById('soundToggleBtn');
                    if (isSoundEnabled) {
                        if (icon) icon.className = 'fas fa-volume-up text-green-600';
                        if (btn) {
                            btn.title = 'Loa tổng: ĐANG BẬT';
                            btn.className = 'icon-button bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        }
                    } else {
                        if (icon) icon.className = 'fas fa-volume-mute text-slate-400';
                        if (btn) {
                            btn.title = 'Loa tổng: ĐANG TẮT';
                            btn.className = 'icon-button bg-white border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer';
                        }
                    }
                }

                function toggleSound(forceOn) {
                    if (typeof forceOn === 'boolean') {
                        isSoundEnabled = forceOn;
                    } else {
                        isSoundEnabled = !isSoundEnabled;
                    }
                    localStorage.setItem("duocSoundEnabled", isSoundEnabled ? "true" : "false");
                    unlockAudio();
                    updateSoundIcon();

                    if (!isSoundEnabled) {
                        audioQueue.clear();
                    }
                }

                // Xác định nội dung hành động gọi loa: 'đóng tiền' hoặc 'nhận thuốc'
                function getActionText(status, daThu) {
                    if (daThu === false) return "đóng tiền";
                    if (daThu === true) return "nhận thuốc";
                    const s = String(status || '').trim().toLowerCase();
                    if (!s) return "nhận thuốc";
                    if (s === "chờ thu" || s === "chưa thu" || s === "chưa đóng tiền" || s.includes("chờ thu") || s.includes("chưa thu") || s.includes("thu tiền") || s.includes("đóng tiền") || s.includes("chưa thanh toán")) {
                        return "đóng tiền";
                    }
                    return "nhận thuốc";
                }

                // Đọc giọng nói gọi tên bệnh nhân bằng TTS Tiếng Việt chuẩn
                function speakTargetPatient(p) {
                    if (!isSoundEnabled || !p) return;
                    const name = (p.tenBenhNhan || '').trim();
                    if (!name) return;

                    const targetLoc = p.oCua ? `ô số ${p.oCua}` : "quầy";
                    const dobClean = extractBirthYear(p.namSinh || p.ngaySinh || p.dobStr || p.dobYear);
                    const dobText = dobClean ? `, sinh năm ${dobClean}` : "";
                    const actionText = getActionText(p.trangThai, p.daThu);
                    const speakText = `Mời bệnh nhân, ${name}${dobText}, đến ${targetLoc} ${actionText}`;
                    audioQueue.enqueue(speakText);
                }

                // Đồng hồ Header
                function updateTime() {
                    const now = new Date();
                    const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
                    const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
                    const dateStrEl = document.getElementById('date-str');
                    const timeStrEl = document.getElementById('time-str');
                    if (dateStrEl) dateStrEl.textContent = now.toLocaleDateString('vi-VN', dateOpts);
                    if (timeStrEl) timeStrEl.textContent = now.toLocaleTimeString('vi-VN', timeOpts);
                }
                setInterval(updateTime, 1000);
                updateTime();

                // Biến toàn cục lưu danh sách bệnh nhân đang hiển thị
                let currentActiveList = [];

                // ═══════════════ HIỆU ỨNG FLIP CHUYỂN HÀNG MƯỢT MÀ (GLIDE TO TOP / REORDER) ═══════════════
                function applyFlipAnimation(container, oldPositions) {
                    if (!container || !oldPositions || oldPositions.size === 0) {
                        const allRows = container.querySelectorAll('tbody tr[data-key]');
                        allRows.forEach((r, idx) => {
                            r.style.animationDelay = `${Math.min(idx * 0.03, 0.3)}s`;
                            r.classList.add('row-glide-enter');
                        });
                        return;
                    }

                    const currentRows = Array.from(container.querySelectorAll('tbody tr[data-key]'));
                    const animatingRows = [];

                    currentRows.forEach(row => {
                        const key = row.getAttribute('data-key');
                        if (!key) return;

                        const newRect = row.getBoundingClientRect();
                        const oldRect = oldPositions.get(key);

                        if (oldRect) {
                            const deltaX = oldRect.left - newRect.left;
                            const deltaY = oldRect.top - newRect.top;

                            if (Math.abs(deltaX) > 1 || Math.abs(deltaY) > 1) {
                                row.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
                                row.style.transition = 'none';
                                row.style.zIndex = deltaY > 0 ? '40' : '15';
                                animatingRows.push(row);
                            }
                        } else {
                            row.classList.add('row-glide-enter');
                        }
                    });

                    if (animatingRows.length > 0) {
                        void container.offsetHeight;

                        requestAnimationFrame(() => {
                            requestAnimationFrame(() => {
                                animatingRows.forEach(row => {
                                    row.style.transition = 'transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.4s ease, box-shadow 0.4s ease';
                                    row.style.transform = 'translate(0px, 0px)';
                                });

                                setTimeout(() => {
                                    animatingRows.forEach(row => {
                                        row.style.transform = '';
                                        row.style.transition = '';
                                        row.style.zIndex = '';
                                    });
                                }, 700);
                            });
                        });
                    }
                }

                const PAGE_ROTATION_INTERVAL = 8000;
                let currentPageIndex = 0;
                let paginationTimer = null;

                function calculateRowsPerColumn() {
                    const container = document.getElementById('paginationContainer');
                    const totalHeight = container ? container.clientHeight : (window.innerHeight - 145);
                    const theadHeight = 44;
                    const availableBodyHeight = Math.max(200, totalHeight - theadHeight);
                    
                    // Chiều cao tiêu chuẩn 1 hàng: ~68px (rõ nét trên TV)
                    // Tối thiểu 10 hàng / 1 ô. Nếu màn hình to hoặc zoom nhỏ -> tự động +1, +2... hàng
                    const TARGET_ROW_HEIGHT = 68;
                    let rows = Math.floor(availableBodyHeight / TARGET_ROW_HEIGHT);
                    if (rows < 10) rows = 10;
                    if (rows > 30) rows = 30;
                    return rows;
                }

                function getRowHeightPx(rowsCount) {
                    const container = document.getElementById('paginationContainer');
                    const totalHeight = container ? container.clientHeight : (window.innerHeight - 145);
                    const theadHeight = 44;
                    const availableBodyHeight = Math.max(200, totalHeight - theadHeight);
                    return Math.floor(availableBodyHeight / rowsCount);
                }

                function updatePageIndicator(current, total) {
                    const badge = document.getElementById('pageBadge');
                    const badgeText = document.getElementById('pageBadgeText');
                    if (!badge || !badgeText) return;
                    if (total > 1) {
                        badgeText.textContent = `${current}/${total}`;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }

                function renderDuocView(list = currentActiveList, preservePage = false) {
                    const container = document.getElementById('paginationContainer');
                    if (!container) return;

                    if (!list) list = [];
                    currentActiveList = list;

                    // 1. Lưu vết tọa độ các hàng hiện tại cho hiệu ứng FLIP
                    const oldPositions = new Map();
                    const existingRows = container.querySelectorAll('tbody tr[data-key]');
                    existingRows.forEach(row => {
                        const key = row.getAttribute('data-key');
                        if (key) {
                            oldPositions.set(key, row.getBoundingClientRect());
                        }
                    });

                    if (list.length === 0) {
                        if (paginationTimer) { clearInterval(paginationTimer); paginationTimer = null; }
                        updatePageIndicator(0, 0);
                        container.innerHTML = `
                            <div class="room-container flex-grow bg-white border-2 border-slate-300 rounded-lg flex items-center justify-center shadow-sm h-full">
                                <p class="text-center text-slate-400 text-2xl md:text-4xl font-bold italic">Không có bệnh nhân chờ lĩnh thuốc.</p>
                            </div>`;
                        return;
                    }

                    // 2. Tính số hàng mỗi ô động theo chiều cao màn hình (tối thiểu 10 hàng / ô)
                    const rowsPerCol = calculateRowsPerColumn();
                    const pageCapacity = rowsPerCol * 2;
                    const rowHeightPx = getRowHeightPx(rowsPerCol);

                    // 3. Tính số trang
                    const totalPages = Math.ceil(list.length / pageCapacity);
                    if (!preservePage || currentPageIndex >= totalPages) {
                        currentPageIndex = 0;
                    }

                    updatePageIndicator(currentPageIndex + 1, totalPages);

                    // Lấy danh sách bệnh nhân thuộc trang hiện tại
                    const startIdx = currentPageIndex * pageCapacity;
                    const pageItems = list.slice(startIdx, startIdx + pageCapacity);

                    // Nếu số bệnh nhân <= rowsPerCol: Hiện 1 BẢNG DUY NHẤT TOÀN MÀN HÌNH (gộp lại thành 1)
                    if (list.length <= rowsPerCol) {
                        container.innerHTML = `
                            <div class="room-container flex-grow bg-white border-2 border-slate-300 rounded-lg flex flex-col shadow-sm overflow-hidden h-full w-full">
                                ${buildTableHtml(pageItems, false, rowHeightPx)}
                            </div>`;
                    } else {
                        // Khi > rowsPerCol bệnh nhân: SPLIT THÀNH 2 CỘT (Cột 1: rowsPerCol BN đầu, Cột 2: các BN tiếp theo)
                        const col1Data = pageItems.slice(0, rowsPerCol);
                        const col2Data = pageItems.slice(rowsPerCol, pageCapacity);

                        container.innerHTML = `
                            <div class="flex-grow flex flex-row gap-3 h-full overflow-hidden w-full min-w-0">
                                <!-- Ô 1 (CỘT 1) -->
                                <div id="col1Container" class="room-container flex-1 min-w-0 bg-white border-2 border-slate-300 rounded-lg flex flex-col shadow-sm overflow-hidden h-full">
                                    ${buildTableHtml(col1Data, true, rowHeightPx)}
                                </div>
                                <!-- Ô 2 (CỘT 2) -->
                                <div id="col2Container" class="room-container flex-1 min-w-0 bg-white border-2 border-slate-300 rounded-lg flex flex-col shadow-sm overflow-hidden h-full">
                                    ${buildTableHtml(col2Data, true, rowHeightPx)}
                                </div>
                            </div>`;
                    }

                    applyFlipAnimation(container, oldPositions);

                    // Tự động xoay trang nếu có hơn 1 trang
                    if (totalPages > 1) {
                        if (!paginationTimer) {
                            paginationTimer = setInterval(() => {
                                const currentRowsPerCol = calculateRowsPerColumn();
                                const currentCapacity = currentRowsPerCol * 2;
                                const currentTotalPages = Math.ceil(currentActiveList.length / currentCapacity);
                                if (currentTotalPages > 1) {
                                    currentPageIndex = (currentPageIndex + 1) % currentTotalPages;
                                    renderDuocView(currentActiveList, true);
                                } else {
                                    clearInterval(paginationTimer);
                                    paginationTimer = null;
                                    updatePageIndicator(1, 1);
                                }
                            }, PAGE_ROTATION_INTERVAL);
                        }
                    } else {
                        if (paginationTimer) { clearInterval(paginationTimer); paginationTimer = null; }
                    }
                }

                function buildTableHtml(rows, isSplit, rowHeightPx) {
                    const pyClass = isSplit ? 'py-1' : 'py-2';
                    const modeClass = isSplit ? 'duoc-table-split' : 'duoc-table-single';

                    const colWidths = `<col style="width: 42%;">
                                       <col style="width: 10%;">
                                       <col style="width: 20%;">
                                       <col style="width: 28%;">`;

                    const rowList = rows || [];
                    let tbodyContent = '';

                    for (let i = 0; i < rowList.length; i++) {
                        tbodyContent += buildRowHtml(rowList[i], isSplit, pyClass, rowHeightPx);
                    }

                    return `
                        <div class="flex-grow overflow-hidden w-full bg-white" style="height: 100%; display: block;">
                            <table class="patient-table duoc-patient-table ${modeClass} w-full text-left border-collapse" style="table-layout: fixed; height: auto !important; margin-bottom: auto;">
                                <colgroup>
                                    ${colWidths}
                                </colgroup>
                                <thead class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300 text-blue-900 uppercase font-black" style="height: 44px;">
                                    <tr>
                                        <th class="py-2.5 px-3 text-left font-black">Họ và Tên</th>
                                        <th class="py-2.5 px-1 text-center font-black">Năm Sinh</th>
                                        <th class="py-2.5 px-1 text-center font-black">Số Tiền</th>
                                        <th class="py-2.5 px-1 text-center font-black">Trạng Thái</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-200">
                                    ${tbodyContent}
                                </tbody>
                            </table>
                        </div>`;
                }

                function buildRowHtml(p, isSplit, pyClass, rowHeightPx) {
                    const isNear = p.isToiLuot;
                    const pIsBhyt = p.isBhyt;
                    const rawName = (p.tenBenhNhan || '').trim();
                    const escapedName = escapeHtml(rawName);
                    const escapedStatus = escapeHtml(p.trangThai || '');
                    const namSinh = escapeHtml(p.namSinh || '—');
                    const makb = escapeHtml(p.makb || '');
                    const mabn = escapeHtml(p.mabn || '');

                    // Khóa duy nhất cho bệnh nhân để theo dõi FLIP animation
                    const rowKey = (makb ? ('makb_' + makb) : (mabn ? ('mabn_' + mabn) : ('name_' + escapedName))).trim();

                    let rowClass;
                    if (isNear) {
                        rowClass = 'row-toi-luot-active bg-yellow-100 border-l-[8px] md:border-l-[12px] border-yellow-500 shadow-md border-b border-slate-200';
                    } else if (pIsBhyt) {
                        rowClass = 'border-l-[4px] md:border-l-[6px] border-blue-400 bg-blue-50/60 border-b border-slate-200';
                    } else {
                        rowClass = 'border-l-[4px] md:border-l-[6px] border-emerald-400 bg-emerald-50/50 border-b border-slate-200';
                    }

                    // Cột Tiền / BHYT
                    let col4Html = '';
                    if (p.soTienStr && p.soTienStr !== '—' && p.soTienStr !== '') {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                        <div class="flex items-center justify-center min-w-0 max-w-full">
                                            <span class="badge-money inline-block rounded-lg border font-mono whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs font-extrabold max-w-full">
                                                ${escapeHtml(p.soTienStr)}
                                            </span>
                                        </div>
                                    </td>`;
                    } else if (!pIsBhyt) {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                        <div class="flex items-center justify-center min-w-0 max-w-full">
                                            <span class="badge-money inline-block rounded-lg border font-mono whitespace-nowrap bg-emerald-50 text-emerald-700 border-emerald-300 shadow-2xs max-w-full">
                                                ${escapeHtml(p.soTienStr || '—')}
                                            </span>
                                        </div>
                                    </td>`;
                    } else {
                        col4Html = `<td class="${pyClass} px-1 text-center">
                                        <div class="flex items-center justify-center min-w-0 max-w-full">
                                            <span class="badge-money inline-block rounded-lg border font-extrabold uppercase whitespace-nowrap bg-blue-100 text-blue-800 border-blue-300 shadow-2xs max-w-full">
                                                BHYT
                                            </span>
                                        </div>
                                    </td>`;
                    }

                    // Cột Trạng Thái
                    let col5Badge = '';
                    const isChoThu = (p.trangThai === "Chờ thu" || escapedStatus === "Chờ thu");
                    if (isChoThu) {
                        col5Badge = `<span class="badge-status inline-block bg-amber-50 text-amber-800 border-2 border-amber-300 font-extrabold uppercase whitespace-nowrap rounded-lg shadow-2xs ${isNear ? 'animate-pulse-red' : ''}">Chờ thu tiền</span>`;
                    } else {
                        col5Badge = `<span class="badge-status inline-block bg-blue-50 text-blue-800 border-2 border-blue-300 font-extrabold uppercase whitespace-nowrap rounded-lg shadow-2xs ${isNear ? 'animate-pulse-red' : ''}">Đang soạn thuốc</span>`;
                    }

                    const heightStyle = rowHeightPx ? `style="height: ${rowHeightPx}px;"` : '';

                    return `<tr data-key="${rowKey}" data-patient="${escapedName}" data-nam-sinh="${namSinh}" data-makb="${makb}" data-mabn="${mabn}" data-status="${escapedStatus || ''}" data-ocua="${p.oCua || ''}"
                                data-room-type="duoc"
                                ${heightStyle}
                                class="${rowClass}">
                            
                                <td class="${pyClass} px-2.5 text-blue-900">
                                    <div class="patient-name-container select-none flex items-center min-w-0">
                                        <span class="patient-name-text uppercase whitespace-normal break-words leading-tight max-w-full ${isNear ? 'text-red-700 font-black' : 'text-blue-900 font-black'}">
                                            ${escapedName.toUpperCase()}
                                        </span>
                                    </div>
                                </td>
                                <td class="cell-namsinh ${pyClass} px-1 text-center font-black text-blue-900">
                                    ${namSinh}
                                </td>
                                ${col4Html}
                                <td class="${pyClass} px-1 text-center">
                                    <div class="flex items-center justify-center min-w-0 max-w-full">
                                        ${col5Badge}
                                    </div>
                                </td>
                            </tr>`;
                }

                // ═══════════════ SIGNALR REALTIME & POLLING FALLBACK ═══════════════
                let hubConnection = null;
                let isFetchingQueue = false;
                let lastQueueJson = '';

                function initSignalR() {
                    if (!window.signalR) {
                        console.warn("[SignalR] Không tìm thấy thư viện signalR. Dùng Polling 3s fallback.");
                        return;
                    }

                    hubConnection = new signalR.HubConnectionBuilder()
                        .withUrl("/queueHub")
                        .withAutomaticReconnect([0, 1000, 2000, 3000, 5000])
                        .build();

                    hubConnection.on("room_data_updated", (payload) => {
                        if (payload && payload.roomType === "duoc") {
                            if (payload.roomId === DUOC_TYPE && payload.data) {
                                renderQueue(payload.data);
                            } else if (DUOC_TYPE === 'all' || payload.roomId === DUOC_TYPE) {
                                fetchQueueData();
                            }
                        }
                    });

                    // Lắng nghe lệnh phát loa trực tiếp khi quầy bấm chọn ô cửa
                    hubConnection.on("duoc_trigger_speak", (payload) => {
                        if (!payload || !payload.hoTen) return;
                        unlockAudio();
                        isSoundEnabled = true;
                        localStorage.setItem("duocSoundEnabled", "true");
                        updateSoundIcon();
                        audioQueue.clear();

                        const targetLoc = payload.oCua ? `ô số ${payload.oCua}` : "quầy";
                        const dobClean = extractBirthYear(payload.namSinh || payload.dobYear || payload.dobStr);
                        const dobText = dobClean ? `, sinh năm ${dobClean}` : "";
                        const actionText = getActionText(payload.trangThai, payload.daThu);
                        const speakText = `Mời bệnh nhân, ${payload.hoTen}${dobText}, đến ${targetLoc} ${actionText}`;
                        audioQueue.enqueue(speakText);
                    });

                    async function startHub() {
                        try {
                            await hubConnection.start();
                            console.log("[SignalR] Kết nối thành công Hub.");
                            await hubConnection.invoke("JoinRoom", "duoc", DUOC_TYPE).catch(() => { });
                        } catch (err) {
                            console.warn("[SignalR] Kết nối thất bại, tự động thử lại sau 3 giây...", err);
                            setTimeout(startHub, 3000);
                        }
                    }

                    hubConnection.onreconnected(async () => {
                        console.log("[SignalR] Đã kết nối lại Hub.");
                        await hubConnection.invoke("JoinRoom", "duoc", DUOC_TYPE).catch(() => { });
                        fetchQueueData();
                    });

                    startHub();
                }

                async function fetchQueueData() {
                    if (isFetchingQueue) return;
                    isFetchingQueue = true;
                    try {
                        const res = await fetch(`/api/duoc/queue?type=${DUOC_TYPE}`);
                        if (!res.ok) return;
                        const data = await res.json();
                        renderQueue(data);
                    } catch (err) {
                        console.warn('Lỗi cập nhật hàng chờ:', err);
                    } finally {
                        isFetchingQueue = false;
                    }
                }

                function renderQueue(data) {
                    if (!data) return;

                    const list = data.waitingList || [];

                    // Đánh lại STT liên tục
                    list.forEach((p, idx) => {
                        p.stt = idx + 1;
                        p.isToiLuot = (idx === 0);
                    });

                    // Cập nhật thống kê
                    const waitEl = document.getElementById('totalWaiting');
                    if (waitEl) waitEl.textContent = list.length;

                    const queueJson = JSON.stringify(list);
                    if (queueJson === lastQueueJson) return; // Không đổi → giữ nguyên
                    lastQueueJson = queueJson;

                    // Xác định bệnh nhân ưu tiên cần đọc
                    const targetPatient = list.find(p => p.isToiLuot) || list[0] || null;
                    if (targetPatient) {
                        currentTopPatient = targetPatient;
                        const currentKey = `${targetPatient.makb || targetPatient.mabn || ''}_${targetPatient.trangThai || ''}`;
                        if (lastCalledPatientKey !== '' && currentKey !== lastCalledPatientKey) {
                            lastCalledPatientKey = currentKey;
                            if (isAutoSpeakEnabled) { speakTargetPatient(targetPatient); }
                        } else if (lastCalledPatientKey === '') {
                            lastCalledPatientKey = currentKey;
                        }
                    } else {
                        currentTopPatient = null;
                    }

                    // Cập nhật tiêu đề
                    const titleEl = document.querySelector('.tv-room-title');
                    if (titleEl && data.title) titleEl.textContent = data.title;

                    // Render danh sách (bảo lưu trang đang xem nếu hợp lệ)
                    renderDuocView(list, true);
                }

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                // ═══════════════ KHỞI ĐỘNG ═══════════════
                updateSoundIcon();

                // Khởi tạo bảng phân trang từ dữ liệu SSR
                (function initFromSSR() {
                    const tbody = document.getElementById('patientTableBody');
                    if (!tbody) { renderDuocView([]); return; }

                    const ssrRows = Array.from(tbody.querySelectorAll('tr[data-patient]'));
                    if (ssrRows.length === 0) {
                        renderDuocView([]);
                        return;
                    }

                    // Rebuild từ data JSON ban đầu
                    const initialList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        queueList.Select(p => new {
                            stt = p.Stt,
                            mabn = p.Mabn,
                            makb = p.Makb,
                            tenBenhNhan = p.TenBenhNhan,
                            namSinh = p.NamSinh,
                            trangThai = p.TrangThai,
                            isToiLuot = p.IsToiLuot,
                            isBhyt = p.IsBhyt,
                            hasBhyt = p.HasBhyt,
                            hasDichVu = p.HasDichVu,
                            hasBoth = p.HasBoth,
                            soTienStr = p.SoTienStr,
                            khochan = p.Khochan,
                            dagiao = p.Dagiao,
                            oCua = p.OCua
                        })
                    ));

                    // Ẩn ssrTableWrapper sau khi dùng
                    const ssrWrapper = document.getElementById('ssrTableWrapper');
                    if (ssrWrapper) ssrWrapper.remove();

                    renderDuocView(initialList);
                })();

                // Lắng nghe thay đổi kích thước màn hình / zoom để tự động điều chỉnh số hàng (+1, +2...)
                let resizeDebounce = null;
                window.addEventListener('resize', () => {
                    clearTimeout(resizeDebounce);
                    resizeDebounce = setTimeout(() => {
                        renderDuocView(currentActiveList, true);
                    }, 150);
                });

                initSignalR();

        </script>
    </body>

</html>
