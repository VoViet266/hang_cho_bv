                            const sohdVal = item.sohd || item.maba || '';
                            const sohdBadge = sohdVal
                                ? `<span class="px-2 py-0.5 bg-slate-100 text-slate-800 border border-slate-300 rounded font-mono text-xs font-bold flex items-center gap-1" title="Số đơn / Số hóa đơn"><i class="fa-solid fa-file-invoice text-slate-500"></i> Đơn: <strong class="text-blue-800 font-black">${escapeHtml(sohdVal)}</strong></span>`
                                : '';

                            html += `
                                            <div class="bg-white border border-rose-200 hover:border-rose-300 rounded-xl p-3 shadow-2xs flex items-center justify-between gap-2 transition overflow-hidden">
                                                <div class="flex-1 min-w-0">
                                                    <div class="font-black text-slate-800 text-xs md:text-sm uppercase truncate leading-tight tracking-wide">
                                                        ${escapeHtml(item.hoTen)}
                                                    </div>
                                                    <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                                        <span class="px-2.5 py-0.5 bg-purple-700 text-white rounded font-black text-[10px] uppercase tracking-wide flex items-center gap-1 shadow-2xs"><i class="fa-solid fa-receipt"></i> TOA DỊCH VỤ</span>
                                                        <span class="text-[11px] font-black text-rose-700 bg-rose-50 px-2 py-0.5 rounded border border-rose-200 flex items-center gap-1">
                                                            <i class="fa-solid fa-ban text-rose-600"></i> Không mua
                                                        </span>
                                                        ${sohdBadge}
                                                        <span class="text-xs font-black text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 flex items-center gap-1">
                                                            <i class="fa-solid fa-coins text-amber-500"></i> ${item.soTienStr || '—'}
                                                        </span>
                                                        <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                                                title="Bấm để sao chép mã khám"
                                                                class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-brand border border-slate-200 font-mono text-[10px] font-bold transition cursor-pointer active:scale-95">
                                                            <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                                            <i class="fa-regular fa-copy text-[10px]"></i>
                                                        </button>
                                                        ${item.ngayNhapStr ? `<span class="text-[10px] text-slate-400 whitespace-nowrap"><i class="fa-regular fa-clock"></i> ${item.ngayNhapStr}</span>` : ''}
