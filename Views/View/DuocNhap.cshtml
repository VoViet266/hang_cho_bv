            }

            const prevScrollTop = container.scrollTop;
            let html = '';
            for (const item of filtered) {
                const isDv = !item.isBhyt;
                const badge = isDv
                    ? `<span class="px-2 py-0.5 bg-purple-100 text-purple-800 border border-purple-200 rounded font-black text-[10px] uppercase tracking-wide">Dịch Vụ</span>`
                    : `<span class="px-2 py-0.5 bg-blue-100 text-blue-800 border border-blue-200 rounded font-black text-[10px] uppercase tracking-wide">BHYT</span>`;

                const curOcua = String(item.oCua || '').trim();
                const hasBeenCalled = Boolean(curOcua && curOcua !== '' && curOcua !== 'null');
                const safeHoTen = escapeHtml(item.hoTen).replace(/'/g, "\\'");
                const safeTrangThai = 'Đang soạn thuốc thuốc';

                const assignBtns = ['1', '2', '3', '4'].map(num => {
                    const isCurrent = curOcua === num;
                    const activeCls = isCurrent
                        ? 'bg-blue-600 text-white font-black border-blue-600 ring-2 ring-blue-300 shadow-xs'
                        : 'bg-white text-slate-700 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-300 border-slate-300';
                    return `<button type="button" onclick="actionGoiCua('${item.makb}', '${item.mabn}', '${safeHoTen}', '${escapeHtml(item.namSinh || '')}', '${num}', ${item.isBhyt}, '${safeTrangThai}')"
                                class="px-2 py-1 text-xs rounded-lg border font-black transition cursor-pointer flex items-center gap-1 active:scale-95 ${activeCls}"
                                title="Chọn Ô ${num} & phát loa gọi ${escapeHtml(item.hoTen)}">${isCurrent ? '<i class="fa-solid fa-volume-high text-[11px] text-yellow-300"></i> ' : ''}Ô ${num}</button>`;
                }).join('');

                const isHighlighted = (item.makb && item.makb === highlightedKey) || (item.mabn && item.mabn === highlightedKey);
                const cardCls = isHighlighted
                    ? 'border-2 border-emerald-500 bg-emerald-50/80 ring-4 ring-emerald-200 shadow-md animate-pulse'
                    : (hasBeenCalled
                        ? 'border-2 border-blue-300 bg-blue-50/40 shadow-xs'
                        : 'border-2 border-slate-200 hover:border-slate-300 bg-white shadow-xs');

                const phatBtnHtml = hasBeenCalled
                    ? `<button onclick="actionPhatThuoc('${item.makb}', '${item.mabn}', '${safeHoTen}')"
                                title="Đã phát thuốc hoàn tất (Ẩn khỏi TV)"
                                class="px-3.5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-black text-xs uppercase flex items-center gap-1.5 shadow-md transition active:scale-95 whitespace-nowrap cursor-pointer shrink-0">
                            <i class="fa-solid fa-check"></i> Đã phát
                       </button>`
                    : '';

                html += `
                    <div class="${cardCls} rounded-xl p-3 flex items-center justify-between gap-2 transition overflow-hidden">
                        <div class="flex-1 min-w-0">
                            <div class="font-black text-slate-900 text-sm md:text-base uppercase truncate leading-tight tracking-wide flex items-center gap-2">
                                <span>${escapeHtml(item.hoTen)}</span>
                            </div>
                            <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                ${badge}
                                ${getOcuaBadge(item.oCua)}
                                <span class="text-xs font-black text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200 flex items-center gap-1">
                                    <i class="fa-solid fa-box-open text-blue-500"></i> Đang soạn thuốc thuốc
                                </span>
                                <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                        title="Bấm để sao chép mã khám"
                                        class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-brand border border-slate-200 font-mono text-[10px] font-bold transition cursor-pointer active:scale-95">
                                    <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                    <i class="fa-regular fa-copy text-[10px]"></i>
                                </button>
                                ${item.ngayNhapStr ? `<span class="text-[10px] text-slate-400 whitespace-nowrap"><i class="fa-regular fa-clock"></i> ${item.ngayNhapStr}</span>` : ''}
                            </div>
                            <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                                <span class="text-[11px] font-black text-slate-500 uppercase tracking-wider flex items-center gap-1">
                                    <i class="fa-solid fa-bullhorn text-brand text-xs"></i> Gọi loa:
                                </span>
                                ${assignBtns}
                            </div>
                        </div>
                        ${phatBtnHtml}
                    </div>`;
            }

            container.innerHTML = html;
            container.scrollTop = prevScrollTop;
        }

        async function loadDanhSachDaGiao() {
            try {
                const r = await fetch('/api/duoc-nhap/danh-sach-da-giao');
                rawDaGiaoData = await r.json() || [];
                renderDaGiaoList();
            } catch (e) {
                console.warn('Lỗi load danh sách đã giao:', e);
            }
        }

        function renderDaGiaoList() {
            const container = $id('da-giao-list');
            const countEl = $id('da-giao-count');
            const query = ($id('search-giao-input')?.value || '').trim().toLowerCase();

            if (countEl) countEl.textContent = rawDaGiaoData.length;
            if (!container) return;

            const filtered = query
                ? rawDaGiaoData.filter(i => (i.hoTen || '').toLowerCase().includes(query) || (i.makb || '').toLowerCase().includes(query) || (i.mabn || '').toLowerCase().includes(query))
                : rawDaGiaoData;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div id="da-giao-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                        <i class="fa-solid fa-clock-rotate-left text-3xl text-slate-300"></i>
                        <p class="text-xs font-bold text-slate-400">${query ? 'Không tìm thấy bệnh nhân phù hợp' : 'Chưa có đơn nào đã phát hôm nay'}</p>
                    </div>`;
                return;
            }

            const prevScrollTop = container.scrollTop;
            let html = '';
            for (const item of filtered) {
                const isDv = !item.isBhyt;
                const badge = isDv
                    ? `<span class="px-2 py-0.5 bg-purple-100 text-purple-800 border border-purple-200 rounded font-black text-[10px] uppercase tracking-wide">Dịch Vụ</span>`
                    : `<span class="px-2 py-0.5 bg-blue-100 text-blue-800 border border-blue-200 rounded font-black text-[10px] uppercase tracking-wide">BHYT</span>`;
                const safeHoTen = escapeHtml(item.hoTen).replace(/'/g, "\\'");

                html += `
                    <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs flex items-center justify-between gap-2 transition overflow-hidden">
                        <div class="flex-1 min-w-0">
                            <div class="font-black text-slate-800 text-xs md:text-sm uppercase truncate leading-tight tracking-wide">
                                ${escapeHtml(item.hoTen)}
                            </div>
                            <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                ${badge}
                                ${getOcuaBadge(item.oCua)}
                                <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 flex items-center gap-1">
                                    <i class="fa-solid fa-circle-check text-emerald-600"></i> Đã phát thuốc
                                </span>
                                <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                        title="Bấm để sao chép mã khám"
                                        class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-brand border border-slate-200 font-mono text-[10px] font-bold transition cursor-pointer active:scale-95">
                                    <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                    <i class="fa-regular fa-copy text-[10px]"></i>
                                </button>
                                ${item.ngayGiaoStr ? `<span class="text-[10px] text-slate-400 whitespace-nowrap"><i class="fa-regular fa-clock"></i> ${item.ngayGiaoStr}</span>` : ''}
                            </div>
                        </div>
                        <button onclick="actionHoanTac('${item.makb}', '${item.mabn}', '${safeHoTen}')"
                                title="Hoàn tác phát thuốc (đưa bệnh nhân trở lại danh sách Chờ phát)"
                                class="px-2.5 py-1.5 bg-slate-100 hover:bg-amber-50 hover:border-amber-300 hover:text-amber-800 text-slate-600 border border-slate-200 rounded-lg font-bold text-xs flex items-center gap-1 transition cursor-pointer shrink-0 active:scale-95">
                            <i class="fa-solid fa-rotate-left"></i> Hoàn tác
                        </button>
                    </div>`;
            }

            container.innerHTML = html;
            container.scrollTop = prevScrollTop;
        }

        async function actionPhatThuoc(makb, mabn, hoTen) {
            try {
                const r = await fetch('/api/duoc-nhap/cap-nhat-trang-thai', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ makb, mabn, targetDagiao: 1 })
                });
                const res = await r.json();
                if (res.success) {
                    playScanBeep(true);
                    showUndoToast(`✓ Đã phát thuốc cho ${hoTen} (Ẩn khỏi TV)`, { makb, mabn, hoTen });
                    refreshAllColumns();
                } else {
                    playScanBeep(false);
                    showError(res.message || 'Lỗi khi phát thuốc');
                }
            } catch (e) {
                showError('Lỗi kết nối server.');
            }
        }

        // ========================================================
        // HÀNH ĐỘNG GỌI CỬA & HOÀN TÁC
        // ========================================================
        async function actionGoiCua(makb, mabn, hoTen, namSinh, oCua, isBhyt, trangThai) {
            try {
                triggerHighlight(makb || mabn);

                // Cập nhật ngay local cache để tên người được gọi nhảy lên đầu danh sách và hiện nút Phát tức thì
                const key = (makb || mabn || '').trim();
                if (key && rawChuaGiaoData && rawChuaGiaoData.length > 0) {
                    const idx = rawChuaGiaoData.findIndex(i => (i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key));
                    if (idx !== -1) {
                        const item = rawChuaGiaoData[idx];
                        item.oCua = oCua;
                        rawChuaGiaoData.splice(idx, 1);
                        rawChuaGiaoData.unshift(item);
                        renderChoGiaoList();
                        renderChoThuList();
                    }
                }

                const r = await fetch('/api/duoc-nhap/chi-dinh-o-cua', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ makb, mabn, oCua, hoTen, namSinh, isBhyt, trangThai })
                });
                const res = await r.json();
                if (res.success) {
                    showUndoToast(`✓ Đang phát loa TV: Gọi ${hoTen} đến Ô ${oCua}`, null);
                    refreshAllColumns();
                } else {
                    showError(res.message || 'Lỗi khi gọi ô cửa');
                }
            } catch (e) {
                showError('Lỗi kết nối server.');
            }
        }

        async function actionHoanTac(makb, mabn, hoTen) {
            try {
                const r = await fetch('/api/duoc-nhap/hoan-tac', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ makb, mabn })
                });
                const res = await r.json();
                if (res.success) {
                    playScanBeep(true);
                    showUndoToast(`✓ ${res.message || 'Đã hoàn tác thành công'}`, null);
                    triggerHighlight(makb || mabn);
                    switchGiaoTab('cho-giao');
                    refreshAllColumns();
                } else {
                    playScanBeep(false);
                    showError(res.message || 'Lỗi khi hoàn tác');
                }
            } catch (e) {
                showError('Lỗi kết nối server.');
            }
        }

        // ========================================================
        // ĐỒNG BỘ DỮ LIỆU ĐỊNH KỲ
        // ========================================================
        let isFetchingChuaGiao = false;
        async function loadDanhSachChuaGiao() {
            if (isFetchingChuaGiao) return;
            isFetchingChuaGiao = true;
            try {
                const r = await fetch('/api/duoc-nhap/danh-sach-chua-giao');
                const list = await r.json() || [];
                rawChuaGiaoData = list;
                renderChoThuList();
                renderChoGiaoList();
            } catch (e) {
                console.warn('Lỗi load danh sách chưa giao:', e);
            } finally {
                isFetchingChuaGiao = false;
            }
        }

        function refreshAllColumns() {
            loadDanhSachChuaGiao();
            if (currentGiaoTab === 'da-giao') loadDanhSachDaGiao();
        }

        // ========================================================
        // BÀN PHÍM & QUÉT MÃ VẠCH
        // ========================================================
        if (scanInput) {
            scanInput.addEventListener('keydown', e => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(autoTimer);
                    const v = scanInput.value.trim();
                    if (v) handleScan(v);
                }
            });

            scanInput.addEventListener('input', () => {
                const now = Date.now();
                const delta = now - lastInputTime;
                lastInputTime = now;
                clearTimeout(autoTimer);
                if (delta < 25 && scanInput.value.length >= 6) {
                    autoTimer = setTimeout(() => {
                        const v = scanInput.value.trim();
                        if (v.length >= 6) handleScan(v);
                    }, 100);
                }
            });
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                resetAll();
                return;
            }
            if (e.key === 'F11') {
                e.preventDefault();
                toggleFullScreen();
                return;
            }
            const tag = document.activeElement ? document.activeElement.tagName : '';
            if (['BUTTON', 'INPUT', 'TEXTAREA', 'A'].includes(tag)) {
                return;
            }
            const ignoredKeys = [
                'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10', 'F12',
                'Tab', 'CapsLock', 'Shift', 'Control', 'Alt', 'Meta',
                'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'
            ];
            if (!ignoredKeys.includes(e.key) && scanInput && document.activeElement !== scanInput) {
                scanInput.focus({ preventScroll: true });
            }
        });

        function toggleFullScreen() {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => { });
            else document.exitFullscreen?.().catch(() => { });
        }

        // ========================================================
        // SIGNALR REAL-TIME SYNC
        // ========================================================
        let hubConnection = null;
        function initSignalR() {
            if (typeof signalR === 'undefined') return;
            try {
                hubConnection = new signalR.HubConnectionBuilder()
                    .withUrl('/queueHub')
                    .withAutomaticReconnect([0, 2000, 5000, 10000])
                    .build();

                hubConnection.on('room_data_updated', payload => {
                    if (payload && (payload.roomType === 'duoc' || !payload.roomType)) {
                        loadDanhSachChuaGiao();
                    }
                });

                hubConnection.start().then(() => {
                    hubConnection.invoke('JoinRoom', 'duoc', 'dichvu').catch(() => { });
                    hubConnection.invoke('JoinRoom', 'duoc', 'bhyt').catch(() => { });
                    hubConnection.invoke('JoinRoom', 'duoc', 'all').catch(() => { });
                }).catch(err => console.warn('SignalR start error:', err));
            } catch (e) {
                console.warn('Lỗi init SignalR:', e);
            }
        }

        // Khởi tạo
        resetAll();
        initSignalR();
        setInterval(refreshAllColumns, 4000);
    </script>
</body>

</html>
