                    async function loadDanhSachKhongMua() {
                        try {
                            const r = await fetch('/api/duoc-nhap/danh-sach-khong-mua');
                            rawKhongMuaData = await r.json() || [];
                            renderKhongMuaList();
                        } catch (e) {
                            console.warn('Lỗi load danh sách không mua:', e);
                        }
                    }

                    function renderKhongMuaList() {
                        const container = $id('khong-mua-list');
                        const countEl = $id('khong-mua-count');
                        const query = ($id('search-thu-input')?.value || '').trim().toLowerCase();

                        if (countEl) countEl.textContent = rawKhongMuaData.length;
                        if (!container) return;

                        const filtered = query
                            ? rawKhongMuaData.filter(i => (i.hoTen || '').toLowerCase().includes(query) || (i.makb || '').toLowerCase().includes(query) || (i.mabn || '').toLowerCase().includes(query) || (i.sohd || '').toLowerCase().includes(query))
                            : rawKhongMuaData;

                        if (filtered.length === 0) {
                            container.innerHTML = `
