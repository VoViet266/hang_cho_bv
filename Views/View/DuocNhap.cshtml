                        ? choGiaoItems.filter(i => (i.hoTen || '').toLowerCase().includes(query) || (i.makb || '').toLowerCase().includes(query) || (i.mabn || '').toLowerCase().includes(query) || (i.sohd || '').toLowerCase().includes(query))
                        : choGiaoItems;

                    if (filtered.length === 0) {
                        container.innerHTML = `
                                                            <div id="cho-giao-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-16">
                                                                <i class="fa-solid fa-clipboard-check text-3xl text-slate-300"></i>
                                                                <p class="text-xs font-semibold text-slate-400">${query ? 'Không tìm thấy bệnh nhân phù hợp' : 'Không có đơn nào đang chờ phát'}</p>
                                                            </div>`;
                        return;
                    }

                    const prevScrollTop = container.scrollTop;
                    let html = '';
                    for (const item of filtered) {
                        let typeTag = '';
                        if (item.hasBoth) {
                            typeTag = `<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800 border border-indigo-300">BHYT + Dịch vụ</span>`;
                        } else if (item.hasDichVu) {
                            typeTag = `<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">Dịch vụ</span>`;
                        } else {
                            typeTag = `<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">BHYT</span>`;
                        }

                        const sohdVal = item.sohd || item.maba || '';
                        const curOcua = String(item.oCua || '').trim();
                        const hasBeenCalled = Boolean(curOcua && curOcua !== '' && curOcua !== 'null');
                        const safeHoTen = escapeHtml(item.hoTen).replace(/'/g, "\\'");
                        const safeTrangThai = 'Nhận thuốc';
                        const hasMoney = (item.hasDichVu || item.hasBoth) && item.soTienStr && item.soTienStr !== '—';

                        // Segmented button group gọn gàng
                        const assignBtns = ['1', '2', '3', '4', '5'].map(num => {
                            const isCurrent = curOcua === num;
                            const activeCls = isCurrent
                                ? 'bg-brand text-white font-black border-brand shadow-2xs ring-2 ring-blue-200'
                                : 'bg-white text-slate-600 hover:bg-blue-50 hover:text-brand border-slate-200';
                            return `<button type="button" onclick="actionGoiCua('${item.makb}', '${item.mabn}', '${safeHoTen}', '${escapeHtml(item.namSinh || '')}', '${num}', ${item.isBhyt}, '${safeTrangThai}', ${item.khochan || 0})"
                                                                        class="px-2.5 py-1 text-xs rounded-lg border font-bold transition cursor-pointer flex items-center gap-1 active:scale-95 ${activeCls}"
                                                                        title="Gọi Ô ${num} nhận thuốc">${isCurrent ? '<i class="fa-solid fa-volume-high text-[10px] text-white"></i> ' : ''}Ô ${num}</button>`;
                        }).join('');

                        const isHighlighted = (item.makb && item.makb === highlightedKey) || (item.mabn && item.mabn === highlightedKey);
                        const cardCls = isHighlighted
                            ? 'border-2 border-emerald-500 bg-emerald-50/60 ring-2 ring-emerald-200 shadow-md'
                            : (hasBeenCalled
                                ? 'border border-blue-300 bg-blue-50/30 hover:shadow-xs'
                                : 'border border-slate-200 hover:border-slate-300 bg-white hover:shadow-xs');

                        const phatBtnHtml = hasBeenCalled
                            ? `<button onclick="actionPhatThuoc('${item.makb}', '${item.mabn}', '${safeHoTen}', ${item.khochan || 0})"
                                                                    title="Xác nhận đã phát thuốc"
                                                                    class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold text-xs uppercase flex items-center gap-1.5 shadow-xs transition active:scale-95 whitespace-nowrap cursor-pointer shrink-0">
                                                                <i class="fa-solid fa-check text-xs"></i> Đã phát
                                                               </button>`
                            : '';

                        html += `
                                                            <div class="patient-card-item ${cardCls} rounded-lg p-2.5 flex flex-col gap-2 transition">
                                                                <!-- Top: Họ tên & Tiền / Ô cửa -->
                                                                <div class="flex items-start justify-between gap-2">
                                                                    <div class="min-w-0">
                                                                        <div class="font-black text-slate-900 text-sm md:text-base uppercase tracking-tight truncate leading-tight">
                                                                            ${escapeHtml(item.hoTen)}
                                                                        </div>
                                                                        <div class="text-xs text-slate-500 flex items-center gap-2 mt-1 flex-wrap">
                                                                            ${typeTag}
                                                                            ${sohdVal ? `<span>Đơn: <strong class="text-slate-700 font-mono">${escapeHtml(sohdVal)}</strong></span><span>•</span>` : ''}
                                                                            <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                                                                    title="Sao chép mã khám"
                                                                                    class="inline-flex items-center gap-1 text-slate-500 hover:text-brand font-mono font-bold transition cursor-pointer">
                                                                                <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                                                                <i class="fa-regular fa-copy text-[10px]"></i>
                                                                            </button>
                                                                            ${item.ngayNhapStr ? `<span>•</span><span class="text-slate-400">${item.ngayNhapStr}</span>` : ''}
                                                                        </div>
                                                                    </div>
                            
                                                                    <div class="text-right shrink-0 flex flex-col items-end gap-1">
                                                                        ${hasMoney ? `<div class="text-xs md:text-sm lg:text-base font-black text-emerald-700 font-mono bg-emerald-50 px-2.5 py-0.5 rounded-lg border border-emerald-300 shadow-2xs">${item.soTienStr}</div>` : ''}
                                                                        <div>${getOcuaBadge(item.oCua)}</div>
                                                                    </div>
                                                                </div>

                                                                <!-- Bottom: Segmented Call Buttons & Action -->
                                                                <div class="flex items-center justify-between border-t border-slate-100 pt-2 gap-2 flex-wrap">
                                                                    <div class="flex items-center gap-1">
                                                                        ${assignBtns}
                                                                    </div>
                                                                    ${phatBtnHtml}
                                                                </div>
                                                            </div>`;
                    }

                    container.innerHTML = html;
                    container.scrollTop = prevScrollTop;
                }

                function renderDaGiaoList() {
                    const container = $id('da-giao-list');
                    const countEl = $id('da-giao-count');
                    const query = ($id('search-giao-input')?.value || '').trim().toLowerCase();

                    if (countEl) countEl.textContent = rawDaGiaoData.length;
                    if (!container) return;

                    const filtered = query
                        ? rawDaGiaoData.filter(i => (i.hoTen || '').toLowerCase().includes(query) || (i.makb || '').toLowerCase().includes(query) || (i.mabn || '').toLowerCase().includes(query) || (i.sohd || '').toLowerCase().includes(query))
                        : rawDaGiaoData;

                    if (filtered.length === 0) {
                        container.innerHTML = `
                                                            <div id="da-giao-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-16">
                                                                <i class="fa-solid fa-clock-rotate-left text-3xl text-slate-300"></i>
                                                                <p class="text-xs font-semibold text-slate-400">${query ? 'Không tìm thấy bệnh nhân phù hợp' : 'Chưa có đơn nào đã phát hôm nay'}</p>
                                                            </div>`;
                        return;
                    }

                    const prevScrollTop = container.scrollTop;
                    let html = '';
                    for (const item of filtered) {
                        let typeTag = '';
                        if (item.hasBoth) {
                            typeTag = `<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800 border border-indigo-300">BHYT + Dịch vụ</span>`;
                        } else if (item.hasDichVu) {
                            typeTag = `<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">Dịch vụ</span>`;
                        } else {
                            typeTag = `<span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">BHYT</span>`;
                        }
                        const safeHoTen = escapeHtml(item.hoTen).replace(/'/g, "\\'");
                        const sohdVal = item.sohd || item.maba || '';
                        const hasMoney = (item.hasDichVu || item.hasBoth) && item.soTienStr && item.soTienStr !== '—';

                        html += `
                                                            <div class="patient-card-item bg-white border border-slate-200 rounded-lg p-2.5 flex items-center justify-between gap-2 hover:shadow-xs transition">
                                                                <div class="min-w-0">
                                                                    <div class="font-bold text-slate-800 text-sm uppercase truncate leading-tight">
                                                                        ${escapeHtml(item.hoTen)}
                                                                    </div>
                                                                    <div class="text-xs text-slate-500 flex items-center gap-2 mt-0.5 flex-wrap">
                                                                        ${typeTag}
                                                                        ${hasMoney ? `<span>•</span><span class="text-xs md:text-sm font-black text-emerald-700 font-mono bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">${item.soTienStr}</span>` : ''}
                                                                        ${sohdVal ? `<span>•</span><span>Đơn: <strong class="text-slate-700 font-mono">${escapeHtml(sohdVal)}</strong></span>` : ''}
                                                                        ${getOcuaBadge(item.oCua)}
                                                                        <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                                                                title="Sao chép mã khám"
                                                                                class="inline-flex items-center gap-1 text-slate-400 hover:text-brand font-mono transition cursor-pointer">
                                                                            <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                                                        </button>
                                                                        ${item.ngayGiaoStr ? `<span>•</span><span class="text-slate-400">${item.ngayGiaoStr}</span>` : ''}
                                                                    </div>
                                                                </div>
                                                                <button onclick="actionHoanTac('${item.makb}', '${item.mabn}', '${safeHoTen}')"
                                                                        title="Đưa bệnh nhân trở lại danh sách Chờ phát"
                                                                        class="px-3 py-1.5 bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-lg font-bold text-xs flex items-center gap-1 transition cursor-pointer shrink-0 active:scale-95">
                                                                    <i class="fa-solid fa-rotate-left text-[11px]"></i> Hoàn tác
                                                                </button>
                                                            </div>`;
                    }

                    container.innerHTML = html;
                    container.scrollTop = prevScrollTop;
                }

                // ========================================================
                // SERVER ACTIONS (OPTIMISTIC + REALTIME)
                // ========================================================
                let lastKhongMuaJson = '';
                async function loadDanhSachKhongMua() {
                    try {
                        const r = await fetch('/api/duoc-nhap/danh-sach-khong-mua');
                        const list = await r.json() || [];
                        const json = JSON.stringify(list);
                        if (json === lastKhongMuaJson) return;
                        lastKhongMuaJson = json;
                        rawKhongMuaData = list;
                        renderKhongMuaList();
                    } catch (e) {
                        console.warn('Lỗi load danh sách không mua:', e);
                    }
                }

                let lastDaGiaoJson = '';
                async function loadDanhSachDaGiao() {
                    try {
                        const r = await fetch('/api/duoc-nhap/danh-sach-da-giao');
                        const list = await r.json() || [];
                        const json = JSON.stringify(list);
                        if (json === lastDaGiaoJson) return;
                        lastDaGiaoJson = json;
                        rawDaGiaoData = list;
                        renderDaGiaoList();
                    } catch (e) {
                        console.warn('Lỗi load danh sách đã giao:', e);
                    }
                }

                async function actionKhongMua(makb, mabn, hoTen) {
                    try {
                        const key = (makb || mabn || '').trim();
                        if (key && rawChuaGiaoData && rawChuaGiaoData.length > 0) {
                            const idx = rawChuaGiaoData.findIndex(i => (i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key));
                            if (idx !== -1) {
                                const removed = rawChuaGiaoData.splice(idx, 1)[0];
                                renderChoThuList();
                                if (rawKhongMuaData) {
                                    rawKhongMuaData.unshift({
                                        ...removed,
                                        dagiao: 3,
                                        ngayNhapStr: new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                                    });
                                    if (currentThuTab === 'khong-mua') renderKhongMuaList();
                                }
                            }
                        }

                        playScanBeep(true);
                        showUndoToast(`Đã chuyển ${hoTen} sang Lịch sử không mua`, { makb, mabn, hoTen, actionType: 'khong_mua' });

                        const r = await fetch('/api/duoc-nhap/khong-mua', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ makb, mabn })
                        });
                        const res = await r.json();
                        if (res.success) {
                            refreshAllColumns();
                        } else {
                            playScanBeep(false);
                            showError(res.message || 'Lỗi khi chuyển sang không mua');
                            refreshAllColumns(true);
                        }
                    } catch (e) {
                        showError('Lỗi kết nối máy chủ.');
                        refreshAllColumns(true);
                    }
                }

                async function actionHoanTacKhongMua(makb, mabn, hoTen) {
                    try {
                        const key = (makb || mabn || '').trim();
                        if (key && rawKhongMuaData && rawKhongMuaData.length > 0) {
                            const idx = rawKhongMuaData.findIndex(i => (i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key));
                            if (idx !== -1) {
                                const removed = rawKhongMuaData.splice(idx, 1)[0];
                                renderKhongMuaList();
                                if (rawChuaGiaoData) {
                                    rawChuaGiaoData.unshift({
                                        ...removed,
                                        dagiao: 0
                                    });
                                    renderChoThuList();
                                    renderChoGiaoList();
                                }
                            }
                        }

                        playScanBeep(true);
                        showUndoToast(`✓ Đã đưa ${hoTen} trở lại Chưa Thu Tiền`, null);
                        triggerHighlight(makb || mabn);
                        switchThuTab('cho-thu');

                        const r = await fetch('/api/duoc-nhap/hoan-tac', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ makb, mabn })
                        });
                        const res = await r.json();
                        if (res.success) {
                            refreshAllColumns();
                        } else {
                            playScanBeep(false);
                            showError(res.message || 'Lỗi khi khôi phục');
                            refreshAllColumns(true);
                        }
                    } catch (e) {
                        showError('Lỗi kết nối máy chủ.');
                        refreshAllColumns(true);
                    }
                }

                async function actionPhatThuoc(makb, mabn, hoTen, khochan) {
                    try {
                        const key = (makb || mabn || '').trim();
                        if (key && rawChuaGiaoData && rawChuaGiaoData.length > 0) {
                            const idx = rawChuaGiaoData.findIndex(i => ((i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key)) && (!khochan || i.khochan === khochan || khochan === 0));
                            if (idx !== -1) {
                                const removed = rawChuaGiaoData.splice(idx, 1)[0];
                                renderChoGiaoList();
                                renderChoThuList();
                                if (rawDaGiaoData) {
                                    rawDaGiaoData.unshift({
                                        ...removed,
                                        dagiao: 1,
                                        ngayGiaoStr: new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                                    });
                                    if (currentGiaoTab === 'da-giao') renderDaGiaoList();
                                }
                            }
                        }

                        playScanBeep(true);
                        showUndoToast(`Đã phát thuốc cho ${hoTen}`, { makb, mabn, hoTen, actionType: 'phat_thuoc' });

                        const r = await fetch('/api/duoc-nhap/cap-nhat-trang-thai', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ makb, mabn, targetDagiao: 1, khochan: khochan || 0 })
                        });
                        const res = await r.json();
                        if (res.success) {
                            refreshAllColumns();
                        } else {
                            playScanBeep(false);
                            showError(res.message || 'Lỗi khi phát thuốc');
                            refreshAllColumns(true);
                        }
                    } catch (e) {
                        showError('Lỗi kết nối máy chủ.');
                        refreshAllColumns(true);
                    }
                }

                async function actionGoiCua(makb, mabn, hoTen, namSinh, oCua, isBhyt, trangThai, khochan) {
                    try {
                        triggerHighlight(makb || mabn);

                        const key = (makb || mabn || '').trim();
                        if (key && rawChuaGiaoData && rawChuaGiaoData.length > 0) {
                            const idx = rawChuaGiaoData.findIndex(i => 
                                ((i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key))
                                && (!khochan || !i.khochan || i.khochan === khochan || khochan === 0)
                            );
                            if (idx !== -1) {
                                const item = rawChuaGiaoData[idx];
                                item.oCua = oCua;
                                rawChuaGiaoData.splice(idx, 1);
                                rawChuaGiaoData.unshift(item);
                                renderChoGiaoList();
                                renderChoThuList();
                            }
                        }

                        const isChoDongTien = (trangThai && (String(trangThai).toLowerCase().includes('chờ thu') || String(trangThai).toLowerCase().includes('chưa thu') || String(trangThai).toLowerCase().includes('thu tiền') || String(trangThai).toLowerCase().includes('đóng tiền'))) || trangThai === 'Chờ thu';
                        const actionLabel = isChoDongTien ? 'đóng tiền' : 'nhận thuốc';
                        showUndoToast(`Đang phát loa TV: Gọi ${hoTen} đến Ô ${oCua} ${actionLabel}`, null);

                        const r = await fetch('/api/duoc-nhap/chi-dinh-o-cua', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ makb, mabn, oCua, hoTen, namSinh, isBhyt, trangThai, khochan: khochan || 0 })
                        });
                        const res = await r.json();
                        if (res.success) {
                            refreshAllColumns();
                        } else {
                            showError(res.message || 'Lỗi khi gọi ô cửa');
                            refreshAllColumns(true);
                        }
                    } catch (e) {
                        showError('Lỗi kết nối máy chủ.');
                        refreshAllColumns(true);
                    }
                }

                async function actionHoanTac(makb, mabn, hoTen) {
                    try {
                        const key = (makb || mabn || '').trim();
                        if (key && rawDaGiaoData && rawDaGiaoData.length > 0) {
                            const idx = rawDaGiaoData.findIndex(i => (i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key));
                            if (idx !== -1) {
                                const removed = rawDaGiaoData.splice(idx, 1)[0];
                                renderDaGiaoList();
                                if (rawChuaGiaoData) {
                                    rawChuaGiaoData.unshift({
                                        ...removed,
                                        dagiao: 0
                                    });
                                    renderChoGiaoList();
                                    renderChoThuList();
                                }
                            }
                        }

                        playScanBeep(true);
                        showUndoToast(`✓ ${hoTen ? 'Đã hoàn tác phát thuốc cho ' + hoTen : 'Đã hoàn tác thành công'}`, null);
                        triggerHighlight(makb || mabn);
                        switchGiaoTab('cho-giao');

                        const r = await fetch('/api/duoc-nhap/hoan-tac', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ makb, mabn })
                        });
                        const res = await r.json();
                        if (res.success) {
                            refreshAllColumns();
                        } else {
                            playScanBeep(false);
                            showError(res.message || 'Lỗi khi hoàn tác');
                            refreshAllColumns(true);
                        }
                    } catch (e) {
                        showError('Lỗi kết nối máy chủ.');
                        refreshAllColumns(true);
                    }
                }

                // ========================================================
                // ĐỒNG BỘ DỮ LIỆU ĐỊNH KỲ (DEBOUNCED & RACE-GUARDED)
                // ========================================================
                let isFetchingChuaGiao = false;
                let pendingChuaGiaoFetch = false;
                let lastChuaGiaoJson = '';
                async function loadDanhSachChuaGiao(forceRender = false) {
                    if (isFetchingChuaGiao) {
                        pendingChuaGiaoFetch = true;
                        return;
                    }
                    isFetchingChuaGiao = true;
                    pendingChuaGiaoFetch = false;
                    try {
                        const r = await fetch('/api/duoc-nhap/danh-sach-chua-giao');
                        const list = await r.json() || [];
                        const json = JSON.stringify(list);
                        if (!forceRender && json === lastChuaGiaoJson) return;
                        lastChuaGiaoJson = json;
                        rawChuaGiaoData = list;
                        renderChoThuList();
                        renderChoGiaoList();
                    } catch (e) {
                        console.warn('Lỗi load danh sách chưa giao:', e);
                    } finally {
                        isFetchingChuaGiao = false;
                        if (pendingChuaGiaoFetch) {
                            pendingChuaGiaoFetch = false;
                            loadDanhSachChuaGiao();
                        }
                    }
                }

                let refreshDebounceTimer = null;
                function refreshAllColumns(immediate = false) {
                    if (immediate) {
                        if (refreshDebounceTimer) clearTimeout(refreshDebounceTimer);
                        doRefreshAll();
                        return;
                    }
                    if (refreshDebounceTimer) clearTimeout(refreshDebounceTimer);
                    refreshDebounceTimer = setTimeout(() => {
                        doRefreshAll();
                    }, 120);
                }

                function doRefreshAll() {
                    loadDanhSachChuaGiao();
                    if (currentThuTab === 'khong-mua') loadDanhSachKhongMua();
                    if (currentGiaoTab === 'da-giao') loadDanhSachDaGiao();
                }

                
                if (scanInput) {
                    scanInput.addEventListener('keydown', e => {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            clearTimeout(autoTimer);
                            const v = scanInput.value.trim();
                            if (v) handleScan(v);
                        }
                    });

                    scanInput.addEventListener('input', () => {
                        const now = Date.now();
                        const delta = now - lastInputTime;
                        lastInputTime = now;
                        clearTimeout(autoTimer);
                        if (delta < 25 && scanInput.value.length >= 6) {
                            autoTimer = setTimeout(() => {
                                const v = scanInput.value.trim();
                                if (v.length >= 6) handleScan(v);
                            }, 100);
                        }
                    });
                }

                document.addEventListener('keydown', e => {
                    if (e.key === 'Escape') {
                        resetAll();
                        return;
                    }
                    if (e.key === 'F11') {
                        e.preventDefault();
                        toggleFullScreen();
                        return;
                    }
                    const tag = document.activeElement ? document.activeElement.tagName : '';
                    if (['BUTTON', 'INPUT', 'TEXTAREA', 'A'].includes(tag)) {
                        return;
                    }
                    const ignoredKeys = [
                        'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10', 'F12',
                        'Tab', 'CapsLock', 'Shift', 'Control', 'Alt', 'Meta',
                        'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'
                    ];
                    if (!ignoredKeys.includes(e.key) && scanInput && document.activeElement !== scanInput) {
                        scanInput.focus({ preventScroll: true });
                    }
                });

                function toggleFullScreen() {
                    if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => { });
                    else document.exitFullscreen?.().catch(() => { });
                }
                let hubConnection = null;
                function initSignalR() {
                    if (typeof signalR === 'undefined') return;
                    try {
                        hubConnection = new signalR.HubConnectionBuilder()
                            .withUrl('/queueHub')
                            .withAutomaticReconnect([0, 2000, 5000, 10000])
                            .build();

                        hubConnection.on('room_data_updated', payload => {
                            if (payload && (payload.roomType === 'duoc' || !payload.roomType)) {
                                refreshAllColumns();
                            }
                        });

                        hubConnection.onreconnected(() => {
                            hubConnection.invoke('JoinRoom', 'duoc', 'all').catch(() => { });
                            refreshAllColumns(true);
                        });

                        hubConnection.start().then(() => {
                            hubConnection.invoke('JoinRoom', 'duoc', 'all').catch(() => { });
                        }).catch(err => console.warn('SignalR start error:', err));
                    } catch (e) {
                        console.warn('Lỗi init SignalR:', e);
                    }
                }

                // Khởi tạo
                resetAll();
                initSignalR();
        </script>
    </body>

</html>
