@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nhập Hàng Chờ Dược - Khoa Dược</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/board.css">
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script src="/js/audioQueue.js?v=@DateTime.UtcNow.Ticks"></script>
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#1e40af',
                            danger: '#dc2626',
                            success: '#16a34a',
                            accent: '#0f172a',
                        }
                    }
                }
            }
    </script>
</head>

<body class="bg-slate-100 text-slate-900 font-sans flex flex-col h-screen overflow-hidden select-none p-2">

    <!-- HEADER -->
    <header
        class="flex justify-between items-center bg-white py-1 px-3 border-2 border-slate-300 shadow-sm gap-2 shrink-0 rounded-lg mb-2">
        <div class="flex items-center gap-3">
            <a href="/duoc" title="Quay lại (Esc)"
               class="flex items-center justify-center w-9 h-9 text-slate-400 hover:text-brand border border-slate-200 hover:border-brand rounded-lg transition shrink-0">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-12 md:h-14 object-contain">
            <div class="tabular-nums">
                <div id="date-str" class="text-xs text-slate-500 font-bold uppercase tracking-widest leading-tight">
                </div>
                <div id="time-str" class="text-xl md:text-2xl font-black text-brand leading-none"></div>
            </div>
        </div>

        <div class="flex-1 text-center">
            <h1 class="text-xl md:text-2xl lg:text-3xl font-black text-brand tracking-wider uppercase leading-none">
                NHẬP HÀNG CHỜ DƯỢC
            </h1>
           
        </div>

        <div class="flex items-center gap-3">
            <div
                class="hidden sm:flex items-center gap-2 bg-blue-50 px-3 py-1.5 rounded-xl border border-blue-200 text-xs font-bold text-blue-800">
                <i class="fa-solid fa-bullhorn text-brand"></i>
                <span>Bấm Ô 1 - 4 tại danh sách để phát loa</span>
            </div>
            <button onclick="toggleFullScreen()" title="Toàn màn hình (F11)"
                    class="flex items-center justify-center w-9 h-9 bg-white border-2 border-slate-300 text-slate-600 hover:text-brand rounded-lg transition cursor-pointer">
                <i class="fa-solid fa-expand"></i>
            </button>
        </div>
    </header>

    <!-- MAIN -->
    <main class="flex-grow grid grid-cols-1 lg:grid-cols-12 gap-2 min-h-0">

        <!-- CỘT TRÁI: Quét mã vạch và thông tin bệnh nhân -->
        <section class="lg:col-span-7 flex flex-col gap-2 min-h-0">
            <div id="scan-box"
                 class="bg-white border-2 border-slate-300 rounded-xl p-4 flex flex-col gap-2.5 shrink-0 transition-all duration-200 shadow-xs">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i id="scan-icon" class="fa-solid fa-barcode text-brand text-2xl w-8 text-center shrink-0"></i>
                        <div id="scan-label" class="font-black text-slate-800 text-sm uppercase tracking-wide">
                            Quét barcode hoặc gõ mã khám
                        </div>
                    </div>
                    <span class="text-xs text-slate-400 font-semibold hidden sm:inline"><kbd
                        class="bg-slate-100 border border-slate-300 rounded px-1.5 py-0.5 font-mono text-slate-700">Enter</kbd>
                        để tiếp nhận</span>
                    </div>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="scan-input"
                               class="w-full pl-10 pr-4 py-3.5 border-2 border-slate-200 rounded-xl font-mono font-bold text-lg text-slate-800 focus:outline-none focus:border-brand bg-slate-50 tracking-wider transition"
                               placeholder="Quét mã vạch hoặc nhập makh rồi nhấn Enter..." autocomplete="off" autocorrect="off"
                               spellcheck="false" autofocus>
                    </div>
                </div>

                <!-- THÔNG TIN BỆNH NHÂN -->
                <div id="patient-card" class="hidden bg-white border-2 border-slate-300 rounded-xl p-4 shrink-0 shadow-xs">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-user-injured text-brand text-sm"></i>
                            <span class="text-xs font-black uppercase tracking-wider text-slate-500">Thông tin bệnh
                                nhân</span>
                            </div>
                            <button type="button" id="btn-copy-makb-card" onclick="copyCurrentPatientMakb(this, event)"
                                    title="Bấm để sao chép mã khám"
                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-blue-50 hover:bg-blue-100 text-brand border border-blue-200 rounded-lg font-mono text-xs font-bold transition cursor-pointer active:scale-95 shadow-2xs">
                                <i class="fa-regular fa-copy text-xs text-brand"></i>
                                <span>Mã KB: <span id="p-makb" class="font-black"></span></span>
                            </button>
                        </div>
                        <div class="flex items-start gap-4">
                            <div
                                class="w-12 h-12 rounded-xl bg-slate-100 border-2 border-slate-200 flex items-center justify-center shrink-0">
                                <i id="bn-gender-icon" class="fa-solid fa-person text-brand text-xl"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div id="p-hoten"
                                     class="text-xl font-black text-slate-900 uppercase tracking-wide leading-tight truncate">
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1.5">
                                    <span class="text-xs text-slate-500 flex items-center gap-1">
                                        <i class="fa-regular fa-calendar text-slate-400"></i>
                                        <span id="p-ngaysinh"></span>
                                    </span>
                                    <span class="text-xs text-slate-500 flex items-center gap-1">
                                        <i class="fa-solid fa-venus-mars text-slate-400"></i>
                                        <span id="p-gioitinh"></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- DANH SÁCH ĐƠN THUỐC DỊCH VỤ (loại 13) -->
                    <div id="thuoc-section"
                         class="hidden bg-white border-2 border-slate-300 rounded-xl p-4 flex flex-col gap-2 flex-grow min-h-0">
                        <div class="flex items-center gap-2 border-b border-slate-100 pb-2 shrink-0">
                            <i class="fa-solid fa-prescription-bottle-medical text-brand text-sm"></i>
                            <span class="text-xs font-black uppercase tracking-wider text-slate-500">Đơn thuốc dịch vụ</span>
                            <span id="thuoc-count"
                                  class="ml-auto px-2 py-0.5 bg-slate-100 rounded-full text-xs font-bold text-slate-500">0
                                đơn</span>
                            </div>
                            <div id="thuoc-list" class="flex flex-col gap-1.5 overflow-y-auto flex-grow min-h-0"></div>
                            <div id="total-row"
                                 class="hidden shrink-0 flex items-center justify-between bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 mt-1">
                                <span class="text-sm font-black text-slate-600 uppercase tracking-wide flex items-center gap-2">
                                    <i class="fa-solid fa-coins text-amber-500"></i> Tổng tiền
                                </span>
                                <span id="total-val" class="text-xl font-black text-success tabular-nums">0 ₫</span>
                            </div>
                        </div>

                    </section>

                    <!-- CỘT PHẢI: Đơn thuốc & Lịch sử -->
                    <section
                        class="lg:col-span-5 bg-white border-2 border-slate-300 rounded-xl flex flex-col min-h-0 shadow-sm overflow-hidden">
                        <div
                            class="flex items-center justify-between border-b-2 border-slate-200 px-3 py-2 shrink-0 bg-slate-50 gap-2">
                            <div class="flex items-center gap-1.5">
                                <button type="button" id="tab-btn-chua-giao" onclick="switchRightTab('chua-giao')"
                                        class="px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-brand text-white shadow-xs cursor-pointer">
                                    <i class="fa-solid fa-clock"></i> Chờ Phát
                                    <span class="px-2 py-0.2 bg-white text-brand rounded-full text-[11px] font-black"
                                          id="chua-giao-count">0</span>
                                </button>
                                <button type="button" id="tab-btn-da-giao" onclick="switchRightTab('da-giao')"
                                        class="px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer">
                                    <i class="fa-solid fa-clock-rotate-left"></i> Lịch Sử Đã Phát
                                    <span class="px-2 py-0.2 bg-slate-200 text-slate-700 rounded-full text-[11px] font-black"
                                          id="da-giao-count">0</span>
                                </button>
                            </div>
                            <button onclick="refreshBothTabs()" title="Làm mới danh sách"
                                    class="text-xs text-brand hover:text-blue-700 font-bold px-2 py-1 rounded-lg border border-slate-200 hover:border-brand bg-white transition flex items-center gap-1 cursor-pointer">
                                <i class="fa-solid fa-rotate"></i> Làm mới
                            </button>
                        </div>

                        <!-- Tab 1: Đơn thuốc chưa giao -->
                        <div class="flex-grow overflow-y-auto overflow-x-hidden p-3 space-y-2 min-h-0 bg-slate-50/40"
                             id="chua-giao-list">
                            <div id="chua-giao-empty"
                                 class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                                <i class="fa-solid fa-clipboard-check text-4xl text-slate-300"></i>
                                <p class="text-sm font-bold text-slate-400">Không có đơn thuốc nào đang chờ</p>
                            </div>
                        </div>

                        <!-- Tab 2: Lịch sử đã phát -->
                        <div class="hidden flex-grow overflow-y-auto overflow-x-hidden p-3 space-y-2 min-h-0 bg-slate-50/40"
                             id="da-giao-list">
                            <div id="da-giao-empty"
                                 class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                                <i class="fa-solid fa-clock-rotate-left text-4xl text-slate-300"></i>
                                <p class="text-sm font-bold text-slate-400">Chưa có đơn thuốc nào đã phát hôm nay</p>
                            </div>
                        </div>
            </section>
        </main>

        <script>
                        const $id = id => document.getElementById(id);
                        const scanInput = $id('scan-input');
                        let autoResetTimer = null;
                        let autoTimer = null;
                        let lastInputTime = 0;
                        let thuocList = [];
                        let currentRightTab = 'chua-giao';

                        // Đồng hồ
                        function updateTime() {
                            const now = new Date();
                            const dateEl = $id('date-str');
                            const timeEl = $id('time-str');
                            if (dateEl) dateEl.textContent = now.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
                            if (timeEl) timeEl.textContent = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
                        }
                        setInterval(updateTime, 1000);
                        updateTime();

                        function fmtMoney(n) {
                            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n || 0);
                        }

                        function setDots(active, total) {
                            for (let i = 0; i < 3; i++) {
                                const d = $id(`dot-${i}`);
                                if (!d) continue;
                                if (i < active)
                                    d.className = 'w-3 h-3 rounded-full bg-success transition-all duration-300';
                                else if (i === active && i < total)
                                    d.className = 'w-3 h-3 rounded-full bg-brand transition-all duration-300 ring-2 ring-blue-300';
                                else
                                    d.className = 'w-3 h-3 rounded-full bg-slate-200 transition-all duration-300';
                            }
                        }

                        function setLoaiBadge(loai) {
                            const el = $id('loai-badge-inner');
                            const badgeWrap = $id('loai-badge');
                            if (!el || !badgeWrap) return;
                            if (loai === 13) {
                                el.textContent = 'Dịch Vụ';
                                el.className = 'px-3 py-0.5 rounded-full text-xs font-black uppercase tracking-wider border bg-purple-50 text-purple-700 border-purple-200';
                            } else {
                                el.textContent = 'BHYT';
                                el.className = 'px-3 py-0.5 rounded-full text-xs font-black uppercase tracking-wider border bg-blue-50 text-brand border-blue-200';
                            }
                            badgeWrap.classList.remove('hidden');
                        }

                        function setScanState(type) {
                            const box = $id('scan-box');
                            const icon = $id('scan-icon');
                            if (box) {
                                box.className = 'bg-white border-2 rounded-xl p-4 flex flex-col gap-3 shrink-0 transition-all duration-200';
                            }
                            if (type === 'loading') {
                                if (box) box.classList.add('border-amber-300');
                                if (icon) icon.className = 'fa-solid fa-spinner fa-spin text-amber-500 text-2xl w-8 text-center shrink-0';
                            } else if (type === 'success') {
                                if (box) box.classList.add('border-green-400', 'bg-green-50');
                                if (icon) icon.className = 'fa-solid fa-circle-check text-success text-2xl w-8 text-center shrink-0';
                            } else if (type === 'error') {
                                if (box) {
                                    box.classList.add('border-danger', 'bg-red-50');
                                    box.animate([
                                        { transform: 'translateX(-5px)' }, { transform: 'translateX(5px)' },
                                        { transform: 'translateX(-4px)' }, { transform: 'translateX(4px)' },
                                        { transform: 'translateX(0)' }
                                    ], { duration: 350 });
                                }
                                if (icon) icon.className = 'fa-solid fa-circle-xmark text-danger text-2xl w-8 text-center shrink-0';
                            } else {
                                if (box) box.classList.add('border-slate-300');
                                if (icon) icon.className = 'fa-solid fa-barcode text-brand text-2xl w-8 text-center shrink-0';
                            }
                        }

                        function setStatus(msg) {
                            const el = $id('state-label');
                            if (el) el.textContent = msg;
                        }
                        function setFooter(msg) { }

                        // Sao chép mã khám & Toast thông báo
                        let currentScannedMakb = '';
                        let toastTimer = null;
                        function showToast(msg) {
                            let toast = $id('global-toast');
                            if (!toast) {
                                toast = document.createElement('div');
                                toast.id = 'global-toast';
                                toast.className = 'fixed bottom-12 right-6 z-50 bg-slate-900/90 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-xl backdrop-blur border border-slate-700 flex items-center gap-2 transition-all duration-300 opacity-0 translate-y-2 pointer-events-none';
                                document.body.appendChild(toast);
                            }
                            toast.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i> <span>${escapeHtml(msg)}</span>`;
                            toast.classList.remove('opacity-0', 'translate-y-2');
                            toast.classList.add('opacity-100', 'translate-y-0');

                            if (toastTimer) clearTimeout(toastTimer);
                            toastTimer = setTimeout(() => {
                                toast.classList.remove('opacity-100', 'translate-y-0');
                                toast.classList.add('opacity-0', 'translate-y-2');
                            }, 2000);
                        }

                        function copyToClipboard(text, btnElement, event) {
                            if (event) {
                                event.stopPropagation();
                                event.preventDefault();
                            }
                            if (!text) return;
                            const str = String(text).trim();
                            if (!str) return;

                            const doFeedback = () => {
                                showToast(`Đã sao chép mã KB: ${str}`);
                                if (btnElement) {
                                    const icon = btnElement.querySelector('i');
                                    if (icon) {
                                        const oldClass = icon.className;
                                        icon.className = 'fa-solid fa-check text-emerald-600';
                                        setTimeout(() => {
                                            icon.className = oldClass;
                                        }, 1500);
                                    }
                                }
                            };

                            if (navigator.clipboard && window.isSecureContext) {
                                navigator.clipboard.writeText(str).then(doFeedback).catch(() => fallbackCopy(str, doFeedback));
                            } else {
                                fallbackCopy(str, doFeedback);
                            }
                        }

                        function fallbackCopy(text, callback) {
                            try {
                                const textarea = document.createElement('textarea');
                                textarea.value = text;
                                textarea.style.position = 'fixed';
                                textarea.style.left = '-999999px';
                                textarea.style.top = '-999999px';
                                document.body.appendChild(textarea);
                                textarea.focus();
                                textarea.select();
                                document.execCommand('copy');
                                document.body.removeChild(textarea);
                                if (callback) callback();
                            } catch (e) {
                                showToast(`Không thể sao chép: ${text}`);
                            }
                        }

                        function copyCurrentPatientMakb(btnEl, event) {
                            if (currentScannedMakb) {
                                copyToClipboard(currentScannedMakb, btnEl, event);
                            }
                        }

                        function showPatient(data) {
                            currentScannedMakb = (data.makb || data.makh || data.mabn || '').trim();
                            if ($id('p-hoten')) $id('p-hoten').textContent = data.hoTen || '—';
                            if ($id('p-ngaysinh')) $id('p-ngaysinh').textContent = data.ngaySinh || '—';
                            if ($id('p-gioitinh')) $id('p-gioitinh').textContent = data.gioiTinh || '—';
                            if ($id('p-makb')) $id('p-makb').textContent = currentScannedMakb || '—';
                            if ($id('btn-copy-makb-card')) {
                                $id('btn-copy-makb-card').classList.toggle('hidden', !currentScannedMakb);
                            }
                            if ($id('bn-gender-icon')) {
                                $id('bn-gender-icon').className = data.gioiTinh === 'Nữ'
                                    ? 'fa-solid fa-person-dress text-pink-500 text-xl'
                                    : 'fa-solid fa-person text-brand text-xl';
                            }
                            const patientCard = $id('patient-card');
                            if (patientCard) patientCard.classList.remove('hidden');
                        }

                        function addThuocRow(t, idx) {
                            const listEl = $id('thuoc-list');
                            if (!listEl) return;
                            const div = document.createElement('div');
                            div.className = 'flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200 rounded-xl overflow-hidden';
                            div.innerHTML = `
                                                                                        <div class="flex items-center gap-3 min-w-0">
                                                                                            <span class="w-8 h-8 rounded-lg bg-brand text-white flex items-center justify-center font-black text-sm shrink-0">${idx + 1}</span>
                                                                                            <div class="min-w-0">
                                                                                                <div class="text-xs font-bold text-slate-700">Đơn thuốc ${idx + 1}</div>
                                                                                                <div class="text-[11px] text-slate-400 font-mono truncate">SHĐ: ${t.sohd || '—'} &bull; MBA: ${t.maba || '—'}</div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="text-base font-black text-success tabular-nums shrink-0">${fmtMoney(t.tienVat)}</div>`;
                            listEl.appendChild(div);
                            updateTotal();
                        }

                        function updateTotal() {
                            const total = thuocList.reduce((s, t) => s + (t.tienVat || 0), 0);
                            const totalVal = $id('total-val');
                            const totalRow = $id('total-row');
                            const thuocCount = $id('thuoc-count');
                            if (totalVal) totalVal.textContent = fmtMoney(total);
                            if (totalRow) totalRow.classList.toggle('hidden', thuocList.length === 0);
                            if (thuocCount) thuocCount.textContent = `${thuocList.length} đơn`;
                        }

                        // Âm thanh Web Audio API
                        let nhapAudioCtx = null;
                        function getNhapAudioContext() {
                            if (!nhapAudioCtx) {
                                const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                                if (AudioCtxClass) nhapAudioCtx = new AudioCtxClass();
                            }
                            if (nhapAudioCtx && nhapAudioCtx.state === 'suspended') {
                                nhapAudioCtx.resume().catch(() => { });
                            }
                            return nhapAudioCtx;
                        }

                        function unlockAudio() {
                            try {
                                getNhapAudioContext();
                                const silent = new Audio('/audio/silent.mp3');
                                silent.volume = 0.01;
                                silent.play().catch(() => { });
                            } catch (e) { }
                        }

                        ['click', 'keydown', 'input', 'touchstart'].forEach(type => {
                            document.addEventListener(type, () => {
                                getNhapAudioContext();
                                unlockAudio();
                            }, { passive: true, once: true });
                        });

                        function playScanBeep(isSuccess) {
                            try {
                                const ctx = getNhapAudioContext();
                                if (!ctx) return;
                                const osc = ctx.createOscillator();
                                const gain = ctx.createGain();
                                const now = ctx.currentTime;
                                if (isSuccess) {
                                    osc.frequency.setValueAtTime(880, now);
                                    gain.gain.setValueAtTime(0.35, now);
                                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.28);
                                    osc.connect(gain);
                                    gain.connect(ctx.destination);
                                    osc.start(now);
                                    osc.stop(now + 0.28);
                                } else {
                                    osc.frequency.setValueAtTime(220, now);
                                    gain.gain.setValueAtTime(0.4, now);
                                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                                    osc.connect(gain);
                                    gain.connect(ctx.destination);
                                    osc.start(now);
                                    osc.stop(now + 0.35);
                                }
                            } catch (e) { }
                        }

                        let lastChuaGiaoJson = '';
                        let lastDaGiaoJson = '';
                        let isScanning = false;

                        function resetAll() {
                            if (autoResetTimer) {
                                clearTimeout(autoResetTimer);
                                autoResetTimer = null;
                            }
                            thuocList = [];
                            currentScannedMakb = '';
                            if (scanInput) scanInput.value = '';
                            setScanState('');
                            setDots(0, 3);
                            setStatus('Sẵn sàng quét...');
                            setFooter('Quét mã khám &rarr; Tự động xử lý theo quy trình');
                            const stateLabel = $id('state-label');
                            if (stateLabel) stateLabel.textContent = 'Sẵn sàng – Quét mã vạch để tự động tiếp nhận';
                            const loaiBadge = $id('loai-badge');
                            if (loaiBadge) loaiBadge.classList.add('hidden');
                            const btnCancel = $id('btn-cancel');
                            if (btnCancel) btnCancel.classList.replace('flex', 'hidden');
                            const pCard = $id('patient-card');
                            if (pCard) pCard.classList.add('hidden');
                            if ($id('p-makb')) $id('p-makb').textContent = '';
                            const thuocSec = $id('thuoc-section');
                            if (thuocSec) thuocSec.classList.add('hidden');
                            const thuocListEl = $id('thuoc-list');
                            if (thuocListEl) thuocListEl.innerHTML = '';
                            updateTotal();
                            if (scanInput) scanInput.focus({ preventScroll: true });
                            refreshBothTabs();
                        }

                        function showError(msg) {
                            setScanState('error');
                            setStatus(msg || 'Lỗi không xác định');
                            setFooter('Có lỗi: ' + (msg || ''));
                            if (scanInput) {
                                scanInput.select();
                                scanInput.focus({ preventScroll: true });
                            }
                            autoResetTimer = setTimeout(() => {
                                setScanState('');
                                setStatus('Sẵn sàng – Quét hoặc nhập mã để tiếp nhận');
                                setFooter('Quét mã khám → Tự động xử lý theo quy trình');
                            }, 4000);
                        }

                        function triggerScanFromInput() {
                            if (!scanInput) return;
                            const v = scanInput.value.trim();
                            if (v) {
                                handleScan(v);
                            } else {
                                scanInput.focus();
                            }
                        }

                        // QUÉT TỰ ĐỘNG THEO BƯỚC
                        async function handleScan(raw) {
                            let code = (raw || '').replace(/[\r\n\t]/g, '').trim();
                            if (!code || isScanning) return;
                            isScanning = true;

                            clearTimeout(autoTimer);
                            if (autoResetTimer) {
                                clearTimeout(autoResetTimer);
                                autoResetTimer = null;
                            }

                            setScanState('loading');
                            setStatus('Đang tra cứu mã: ' + code + '...');
                            setFooter('Đang tra cứu dữ liệu chứng từ & bệnh nhân...');

                            try {
                                // 1. Tra cứu thông tin chứng từ & bệnh nhân
                                let data;
                                try {
                                    const r = await fetch(`/api/duoc-nhap/scan?makh=${encodeURIComponent(code)}`);
                                    data = await r.json();
                                } catch (err) {
                                    playScanBeep(false);
                                    showError('Lỗi kết nối server.');
                                    return;
                                }

                                if (!data.success) {
                                    playScanBeep(false);
                                    showError(data.message || `Không tìm thấy mã '${code}'.`);
                                    return;
                                }

                                // Xoá ô nhập sau khi tìm thấy
                                if (scanInput) scanInput.value = '';

                                // 2. Hiển thị thông tin bệnh nhân
                                setLoaiBadge(data.loai);
                                showPatient(data);
                                const btnCancel = $id('btn-cancel');
                                if (btnCancel) btnCancel.classList.replace('hidden', 'flex');

                                if (data.loai === 13) {
                                    thuocList = (data.danhSachThuoc && data.danhSachThuoc.length > 0)
                                        ? data.danhSachThuoc
                                        : [{ sohd: data.sohd, maba: data.maba, tienVat: data.tienVat }];
                                    const thuocSec = $id('thuoc-section');
                                    if (thuocSec) thuocSec.classList.remove('hidden');
                                    const tListEl = $id('thuoc-list');
                                    if (tListEl) tListEl.innerHTML = '';
                                    thuocList.forEach((t, i) => addThuocRow(t, i));
                                    updateTotal();
                                } else {
                                    const thuocSec = $id('thuoc-section');
                                    if (thuocSec) thuocSec.classList.add('hidden');
                                    const tListEl = $id('thuoc-list');
                                    if (tListEl) tListEl.innerHTML = '';
                                }

                                // 3. Tự động tiếp nhận vào hàng chờ (không gán sẵn ô cửa)
                                const targetKhochan = (data.loai === 13) ? 13 : 14;
                                let res;
                                try {
                                    const r = await fetch('/api/duoc-nhap/them-hang-cho', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            makb: data.makb,
                                            mabn: data.mabn,
                                            loai: data.loai,
                                            khochan: targetKhochan,
                                            maba: data.maba,
                                            ngayKcb: data.ngayKcb,
                                            oCua: null
                                        })
                                    });
                                    res = await r.json();
                                } catch (err) {
                                    playScanBeep(false);
                                    showError('Lỗi lưu vào hàng chờ.');
                                    return;
                                }

                                if (!res.success) {
                                    playScanBeep(false);
                                    showError(res.message || 'Lỗi khi lưu vào hàng chờ.');
                                    return;
                                }

                                // 4. Thành công
                                playScanBeep(true);
                                setScanState('success');

                                const msg = res.message || 'Đã tiếp nhận vào hàng chờ!';
                                setStatus('✓ ' + msg);
                                setFooter(msg);
                                const stateLabel = $id('state-label');
                                if (stateLabel) stateLabel.textContent = `✓ ${msg} – Sẵn sàng tiếp nhận tiếp...`;
                                setDots(3, 3);

                                // Cập nhật danh sách bên cột phải
                                refreshBothTabs();

                                if (scanInput) scanInput.focus({ preventScroll: true });
                            } finally {
                                isScanning = false;
                            }
                        }

                        // CHUYỂN TAB CỘT PHẢI
                        function switchRightTab(tab) {
                            currentRightTab = tab;
                            const btnChuaGiao = $id('tab-btn-chua-giao');
                            const btnDaGiao = $id('tab-btn-da-giao');
                            const listChuaGiao = $id('chua-giao-list');
                            const listDaGiao = $id('da-giao-list');

                            if (tab === 'chua-giao') {
                                if (btnChuaGiao) btnChuaGiao.className = 'px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-brand text-white shadow-xs cursor-pointer';
                                if (btnDaGiao) btnDaGiao.className = 'px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer';
                                if (listChuaGiao) listChuaGiao.classList.remove('hidden');
                                if (listDaGiao) listDaGiao.classList.add('hidden');
                                loadDanhSachChuaGiao();
                            } else {
                                if (btnDaGiao) btnDaGiao.className = 'px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-emerald-600 text-white shadow-xs cursor-pointer';
                                if (btnChuaGiao) btnChuaGiao.className = 'px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer';
                                if (listDaGiao) listDaGiao.classList.remove('hidden');
                                if (listChuaGiao) listChuaGiao.classList.add('hidden');
                                loadDanhSachDaGiao();
                            }
                        }

                        function refreshBothTabs() {
                            loadDanhSachChuaGiao();
                            loadDanhSachDaGiao();
                        }

                        function escapeHtml(str) {
                            if (!str) return '';
                            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                        }

                        function getOcuaBadge(ocua) {
                            if (!ocua) return `<span class="px-2 py-0.5 rounded font-black text-[10px] bg-slate-100 text-slate-400 border border-slate-200">Chưa chọn ô</span>`;
                            const val = String(ocua).trim();
                            let cls = 'bg-blue-100 text-blue-800 border-blue-200';
                            if (val === '2') cls = 'bg-emerald-100 text-emerald-800 border-emerald-200';
                            else if (val === '3') cls = 'bg-purple-100 text-purple-800 border-purple-200';
                            else if (val === '4') cls = 'bg-amber-100 text-amber-800 border-amber-200';
                            return `<span class="px-2 py-0.5 rounded font-black text-[10px] uppercase tracking-wide border shadow-2xs ${cls}"><i class="fa-solid fa-door-open mr-0.5"></i> Ô ${escapeHtml(val)}</span>`;
                        }

                        // 1. TẢI DANH SÁCH CHỜ PHÁT
                        let isFetchingChuaGiao = false;
                        async function loadDanhSachChuaGiao() {
                            if (isFetchingChuaGiao) return;
                            isFetchingChuaGiao = true;
                            try {
                                const r = await fetch('/api/duoc-nhap/danh-sach-chua-giao');
                                const list = await r.json();
                                renderDanhSachChuaGiao(list);
                            } catch (e) {
                                console.warn('Lỗi load danh sách chưa giao:', e);
                            } finally {
                                isFetchingChuaGiao = false;
                            }
                        }

                        function renderDanhSachChuaGiao(list) {
                            const container = $id('chua-giao-list');
                            const countEl = $id('chua-giao-count');
                            const currentList = list || [];
                            if (countEl) countEl.textContent = currentList.length;
                            if (!container) return;

                            const currentJson = JSON.stringify(currentList);
                            if (currentJson === lastChuaGiaoJson) return;
                            lastChuaGiaoJson = currentJson;

                            const prevScrollTop = container.scrollTop;

                            if (currentList.length === 0) {
                                container.innerHTML = `
                                                                                            <div id="chua-giao-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                                                                                                <i class="fa-solid fa-clipboard-check text-4xl text-slate-300"></i>
                                                                                                <p class="text-sm font-bold text-slate-400">Không có đơn thuốc nào đang chờ</p>
                                                                                            </div>`;
                                return;
                            }

                            let html = '';
                            for (const item of currentList) {
                                const isDv = !item.isBhyt;
                                const badge = isDv
                                    ? `<span class="px-2 py-0.5 bg-purple-100 text-purple-800 border border-purple-200 rounded font-black text-[10px] uppercase tracking-wide">Dịch Vụ</span>`
                                    : `<span class="px-2 py-0.5 bg-blue-100 text-blue-800 border border-blue-200 rounded font-black text-[10px] uppercase tracking-wide">BHYT</span>`;

                                let statusText = '';
                                let btnHtml = '';

                                if (!isDv) {
                                    statusText = `<span class="text-xs font-black text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200 flex items-center gap-1">
                                        <i class="fa-solid fa-box-open text-blue-500"></i> Đang soạn
                                    </span>`;
                                    btnHtml = `
                                        <button onclick="actionCapNhat('${item.makb}', '${item.mabn}', 1, 'Đã phát thuốc BHYT cho ${escapeHtml(item.hoTen)}')"
                                            class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-black text-xs uppercase flex items-center gap-1.5 shadow-sm transition active:scale-95 whitespace-nowrap cursor-pointer shrink-0">
                                            <i class="fa-solid fa-check"></i> Đã phát
                                        </button>`;
                                } else {
                                    if (item.dagiao === 0) {
                                        statusText = `<span class="text-xs font-black text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 flex items-center gap-1">
                                            <i class="fa-solid fa-coins text-amber-500"></i> Chờ thu: ${item.soTienStr || '—'}
                                        </span>`;
                                        btnHtml = `
                                            <button onclick="actionCapNhat('${item.makb}', '${item.mabn}', 1, 'Đã thu tiền cho ${escapeHtml(item.hoTen)}')"
                                                title="Xác nhận đã thu tiền (chuyển sang Đang soạn)"
                                                class="px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-xl font-black text-xs uppercase flex items-center gap-1.5 shadow-sm transition active:scale-95 whitespace-nowrap cursor-pointer shrink-0">
                                                <i class="fa-solid fa-coins"></i> Thu tiền
                                            </button>`;
                                    } else {
                                        statusText = `<span class="text-xs font-black text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200 flex items-center gap-1">
                                            <i class="fa-solid fa-box-open text-blue-500"></i> Đang soạn: ${item.soTienStr || '—'}
                                        </span>`;
                                        btnHtml = `
                                            <button onclick="actionCapNhat('${item.makb}', '${item.mabn}', 2, 'Đã phát thuốc cho ${escapeHtml(item.hoTen)}')"
                                                title="Đã phát thuốc hoàn tất (Ẩn khỏi TV)"
                                                class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-black text-xs uppercase flex items-center gap-1.5 shadow-sm transition active:scale-95 whitespace-nowrap cursor-pointer shrink-0">
                                                <i class="fa-solid fa-check"></i> Đã phát
                                            </button>`;
                                    }
                                }

                                // Nút bấm phát loa gọi theo ô cửa
                                const curOcua = String(item.oCua || '').trim();
                                const safeHoTen = escapeHtml(item.hoTen).replace(/'/g, "\\'");
                                const safeTrangThai = escapeHtml(item.trangThai || '').replace(/'/g, "\\'");
                                const assignBtns = ['1', '2', '3', '4'].map(num => {
                                    const isCurrent = curOcua === num;
                                    const activeCls = isCurrent
                                        ? 'bg-blue-600 text-white font-black border-blue-600 ring-2 ring-blue-300 shadow-xs'
                                        : 'bg-white text-slate-700 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-300 border-slate-300';
                                    return `<button type="button" onclick="actionGoiCua('${item.makb}', '${item.mabn}', '${safeHoTen}', '${escapeHtml(item.namSinh || '')}', '${num}', ${item.isBhyt}, '${safeTrangThai}')"
                                                                                                class="px-2.5 py-1 text-xs rounded-lg border font-black transition cursor-pointer flex items-center gap-1 active:scale-95 ${activeCls}"
                                                                                                title="Chọn Ô ${num} & phát loa gọi ${escapeHtml(item.hoTen)}">${isCurrent ? '<i class="fa-solid fa-volume-high text-[11px] text-yellow-300"></i> ' : ''}Ô ${num}</button>`;
                                }).join('');

                                html += `
                                                                                            <div class="bg-white border-2 border-slate-200 hover:border-slate-300 rounded-xl p-3 shadow-xs flex items-center justify-between gap-2 transition overflow-hidden">
                                                                                                <div class="flex-1 min-w-0">
                                                                                                    <div class="font-black text-slate-900 text-base uppercase truncate leading-tight tracking-wide">
                                                                                                        ${escapeHtml(item.hoTen)}
                                                                                                    </div>
                                                                                                    <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                                                                                        ${badge}
                                                                                                        ${getOcuaBadge(item.oCua)}
                                                                                                        ${statusText}
                                                                                                        <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                                                                                            title="Bấm để sao chép mã khám: ${escapeHtml(item.makb || item.mabn)}"
                                                                                                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 hover:bg-blue-50 hover:border-blue-300 text-slate-600 hover:text-brand border border-slate-200 font-mono text-[11px] font-bold transition cursor-pointer active:scale-95">
                                                                                                            <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                                                                                            <i class="fa-regular fa-copy text-[11px]"></i>
                                                                                                        </button>
                                                                                                        ${item.ngayNhapStr ? `<span class="text-[11px] text-slate-400 whitespace-nowrap"><i class="fa-regular fa-clock"></i> ${item.ngayNhapStr}</span>` : ''}
                                                                                                    </div>
                                                                                                    <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                                                                                                        <span class="text-xs font-black text-slate-500 uppercase tracking-wider flex items-center gap-1">
                                                                                                            <i class="fa-solid fa-bullhorn text-brand text-xs"></i> Gọi loa:
                                                                                                        </span>
                                                                                                        ${assignBtns}
                                                                                                    </div>
                                                                                                </div>
                                                                                                ${btnHtml}
                                                                                            </div>`;
                            }

                            container.innerHTML = html;
                            container.scrollTop = prevScrollTop;
                        }

                        // 2. TẢI DANH SÁCH LỊCH SỬ ĐÃ PHÁT
                        let isFetchingDaGiao = false;
                        async function loadDanhSachDaGiao() {
                            if (isFetchingDaGiao) return;
                            isFetchingDaGiao = true;
                            try {
                                const r = await fetch('/api/duoc-nhap/danh-sach-da-giao');
                                const list = await r.json();
                                renderDanhSachDaGiao(list);
                            } catch (e) {
                                console.warn('Lỗi load danh sách đã giao:', e);
                            } finally {
                                isFetchingDaGiao = false;
                            }
                        }

                        function renderDanhSachDaGiao(list) {
                            const container = $id('da-giao-list');
                            const countEl = $id('da-giao-count');
                            const currentList = list || [];
                            if (countEl) countEl.textContent = currentList.length;
                            if (!container) return;

                            const currentJson = JSON.stringify(currentList);
                            if (currentJson === lastDaGiaoJson) return;
                            lastDaGiaoJson = currentJson;

                            const prevScrollTop = container.scrollTop;

                            if (currentList.length === 0) {
                                container.innerHTML = `
                                                                                            <div id="da-giao-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                                                                                                <i class="fa-solid fa-clock-rotate-left text-4xl text-slate-300"></i>
                                                                                                <p class="text-sm font-bold text-slate-400">Chưa có đơn thuốc nào đã phát hôm nay</p>
                                                                                            </div>`;
                                return;
                            }

                            let html = '';
                            for (const item of currentList) {
                                const isDv = !item.isBhyt;
                                const badge = isDv
                                    ? `<span class="px-2 py-0.5 bg-purple-100 text-purple-800 border border-purple-200 rounded font-black text-[10px] uppercase tracking-wide">Dịch Vụ</span>`
                                    : `<span class="px-2 py-0.5 bg-blue-100 text-blue-800 border border-blue-200 rounded font-black text-[10px] uppercase tracking-wide">BHYT</span>`;

                                html += `
                                                                                            <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs flex items-center justify-between gap-2 transition overflow-hidden">
                                                                                                <div class="flex-1 min-w-0">
                                                                                                    <div class="font-black text-slate-800 text-sm md:text-base uppercase truncate leading-tight tracking-wide">
                                                                                                        ${escapeHtml(item.hoTen)}
                                                                                                    </div>
                                                                                                    <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                                                                                        ${badge}
                                                                                                        ${getOcuaBadge(item.oCua)}
                                                                                                        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 flex items-center gap-1">
                                                                                                            <i class="fa-solid fa-circle-check text-emerald-600"></i> Đã phát thuốc
                                                                                                        </span>
                                                                                                        <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                                                                                            title="Bấm để sao chép mã khám: ${escapeHtml(item.makb || item.mabn)}"
                                                                                                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 hover:bg-blue-50 hover:border-blue-300 text-slate-600 hover:text-brand border border-slate-200 font-mono text-[11px] font-bold transition cursor-pointer active:scale-95">
                                                                                                            <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                                                                                            <i class="fa-regular fa-copy text-[11px]"></i>
                                                                                                        </button>
                                                                                                        ${item.ngayGiaoStr ? `<span class="text-[11px] text-slate-400 whitespace-nowrap"><i class="fa-regular fa-clock"></i> ${item.ngayGiaoStr}</span>` : ''}
                                                                                                    </div>
                                                                                                </div>
                                                                                                <button onclick="actionCapNhat('${item.makb}', '${item.mabn}', 0, 'Đã khôi phục bệnh nhân ' + escapeHtml(item.hoTen) + ' về hàng chờ!')"
                                                                                                    title="Khôi phục bệnh nhân trở lại danh sách chờ"
                                                                                                    class="px-2.5 py-1.5 bg-slate-100 hover:bg-amber-50 hover:border-amber-300 hover:text-amber-800 text-slate-600 border border-slate-200 rounded-lg font-bold text-xs flex items-center gap-1 transition cursor-pointer shrink-0">
                                                                                                    <i class="fa-solid fa-rotate-left"></i> Hoàn tác
                                                                                                </button>
                                                                                            </div>`;
                            }

                            container.innerHTML = html;
                            container.scrollTop = prevScrollTop;
                        }

                        // 3. CHỈ ĐỊNH Ô CỬA & PHÁT LOA GỌI BỆNH NHÂN TRÊN TV (KHÔNG PHÁT ÂM TẠI MÁY NHẬP)
                        async function actionGoiCua(makb, mabn, hoTen, namSinh, oCua, isBhyt, trangThai) {
                            try {
                                const r = await fetch('/api/duoc-nhap/chi-dinh-o-cua', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ makb, mabn, oCua, hoTen, namSinh, isBhyt, trangThai })
                                });
                                const res = await r.json();
                                if (res.success) {
                                    const msg = `Đang phát loa TV: Gọi ${hoTen} đến Ô ${oCua}`;
                                    setFooter(msg);
                                    setStatus(`✓ Đã phát loa TV: ${hoTen} -> Ô ${oCua}`);
                                    refreshBothTabs();
                                } else {
                                    showError(res.message || 'Lỗi khi gọi ô cửa');
                                }
                            } catch (e) {
                                showError('Lỗi kết nối server.');
                            }
                        }

                        // 4. CẬP NHẬT TRẠNG THÁI (ĐÃ PHÁT / THU TIỀN)
                        async function actionCapNhat(makb, mabn, targetDagiao, successMsg) {
                            try {
                                const r = await fetch('/api/duoc-nhap/cap-nhat-trang-thai', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ makb, mabn, targetDagiao })
                                });
                                const res = await r.json();
                                if (res.success) {
                                    playScanBeep(true);
                                    const msg = successMsg || res.message || 'Cập nhật thành công!';
                                    setFooter(msg);
                                    setStatus(msg);
                                    refreshBothTabs();
                                } else {
                                    playScanBeep(false);
                                    showError(res.message || 'Lỗi cập nhật');
                                }
                            } catch (e) {
                                showError('Lỗi kết nối server.');
                            }
                        }



                        // Input & Keyboard
                        if (scanInput) {
                            scanInput.addEventListener('keydown', e => {
                                if (e.key === 'Enter') {
                                    e.preventDefault();
                                    clearTimeout(autoTimer);
                                    const v = scanInput.value.trim();
                                    if (v) handleScan(v);
                                }
                            });

                            scanInput.addEventListener('input', () => {
                                const now = Date.now();
                                const delta = now - lastInputTime;
                                lastInputTime = now;
                                clearTimeout(autoTimer);
                                // Nếu là máy quét mã vạch (tốc độ gõ siêu nhanh < 25ms mỗi ký tự) và độ dài đã đủ (>= 6)
                                if (delta < 25 && scanInput.value.length >= 6) {
                                    autoTimer = setTimeout(() => {
                                        const v = scanInput.value.trim();
                                        if (v.length >= 6) handleScan(v);
                                    }, 100);
                                }
                            });
                        }

                        document.addEventListener('keydown', e => {
                            if (e.key === 'Escape') {
                                resetAll();
                                return;
                            }
                            if (e.key === 'F11') {
                                e.preventDefault();
                                toggleFullScreen();
                                return;
                            }
                            const tag = document.activeElement ? document.activeElement.tagName : '';
                            if (['BUTTON', 'INPUT', 'TEXTAREA', 'A'].includes(tag)) {
                                return;
                            }
                            const ignoredKeys = [
                                'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10', 'F12',
                                'Tab', 'CapsLock', 'Shift', 'Control', 'Alt', 'Meta',
                                'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'
                            ];
                            if (!ignoredKeys.includes(e.key) && scanInput && document.activeElement !== scanInput) {
                                scanInput.focus({ preventScroll: true });
                            }
                        });

                        function toggleFullScreen() {
                            if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => { });
                            else document.exitFullscreen?.().catch(() => { });
                        }

                        // Init
                        resetAll();
                        setInterval(refreshBothTabs, 4000);
                </script>
            </body>

        </html>
