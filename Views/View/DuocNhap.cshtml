                    async function actionKhongMua(makb, mabn, hoTen) {
                        try {
                            // Optimistic UI: Xóa ngay lập tức khỏi local cache
                            const key = (makb || mabn || '').trim();
                            if (key && rawChuaGiaoData && rawChuaGiaoData.length > 0) {
                                const idx = rawChuaGiaoData.findIndex(i => (i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key));
                                if (idx !== -1) {
                                    const removed = rawChuaGiaoData.splice(idx, 1)[0];
                                    renderChoThuList();
                                    if (rawKhongMuaData) {
                                        rawKhongMuaData.unshift({
                                            ...removed,
                                            dagiao: 3,
                                            ngayNhapStr: new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                                        });
                                        if (currentThuTab === 'khong-mua') renderKhongMuaList();
                                    }
                                }
                            }

                            playScanBeep(true);
                            showUndoToast(`Đã chuyển ${hoTen} sang Lịch sử không mua`, { makb, mabn, hoTen, actionType: 'khong_mua' });

                            const r = await fetch('/api/duoc-nhap/khong-mua', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ makb, mabn })
                            });
                            const res = await r.json();
                            if (res.success) {
                                refreshAllColumns();
                            } else {
                                playScanBeep(false);
                                showError(res.message || 'Lỗi khi chuyển sang không mua');
                                refreshAllColumns(true);
                            }
                        } catch (e) {
                            showError('Lỗi kết nối server.');
                            refreshAllColumns(true);
                        }
                    }

                    async function actionHoanTacKhongMua(makb, mabn, hoTen) {
                        try {
                            // Optimistic UI: Xóa ngay khỏi lịch sử không mua và đưa về Chưa Thu
                            const key = (makb || mabn || '').trim();
                            if (key && rawKhongMuaData && rawKhongMuaData.length > 0) {
                                const idx = rawKhongMuaData.findIndex(i => (i.makb && i.makb.trim() === key) || (i.mabn && i.mabn.trim() === key));
                                if (idx !== -1) {
                                    const removed = rawKhongMuaData.splice(idx, 1)[0];
                                    renderKhongMuaList();
                                    if (rawChuaGiaoData) {
                                        rawChuaGiaoData.unshift({
                                            ...removed,
                                            dagiao: 0
                                        });
                                        renderChoThuList();
                                        renderChoGiaoList();
                                    }
                                }
                            }

                            playScanBeep(true);
                            showUndoToast(`✓ Đã đưa ${hoTen} trở lại Chưa Thu Tiền`, null);
                            triggerHighlight(makb || mabn);
                            switchThuTab('cho-thu');

                            const r = await fetch('/api/duoc-nhap/hoan-tac', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ makb, mabn })
                            });
                            const res = await r.json();
                            if (res.success) {
                                refreshAllColumns();
                            } else {
                                playScanBeep(false);
                                showError(res.message || 'Lỗi khi khôi phục');
                                refreshAllColumns(true);
                            }
                        } catch (e) {
                            showError('Lỗi kết nối server.');
                            refreshAllColumns(true);
                        }
                    }

            
                    function switchGiaoTab(tab) {
                        currentGiaoTab = tab;
                        const btnChoGiao = $id('tab-btn-cho-giao');
                        const btnDaGiao = $id('tab-btn-da-giao');
                        const listChoGiao = $id('cho-giao-list');
                        const listDaGiao = $id('da-giao-list');

                        if (tab === 'cho-giao') {
                            if (btnChoGiao) btnChoGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-brand text-white shadow-xs cursor-pointer';
                            if (btnDaGiao) btnDaGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer';
                            if (listChoGiao) listChoGiao.classList.remove('hidden');
                            if (listDaGiao) listDaGiao.classList.add('hidden');
                            renderChoGiaoList();
                        } else {
                            if (btnDaGiao) btnDaGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-emerald-600 text-white shadow-xs cursor-pointer';
                            if (btnChoGiao) btnChoGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer';
                            if (listDaGiao) listDaGiao.classList.remove('hidden');
                            if (listChoGiao) listChoGiao.classList.add('hidden');
                            loadDanhSachDaGiao();
                        }
                    }

                    function refreshGiaoTab() {
                        loadDanhSachChuaGiao();
                        if (currentGiaoTab === 'da-giao') loadDanhSachDaGiao();
                    }

                    function filterGiaoList() {
                        const clearBtn = $id('clear-giao-search-btn');
                        const query = ($id('search-giao-input')?.value || '').trim().toLowerCase();
                        if (clearBtn) clearBtn.classList.toggle('hidden', !query);

                        if (currentGiaoTab === 'cho-giao') renderChoGiaoList();
                        else renderDaGiaoList();
                    }

                    function clearGiaoSearch() {
                        const input = $id('search-giao-input');
                        if (input) input.value = '';
                        filterGiaoList();
                        if (input) input.focus();
                    }

                    function renderChoGiaoList() {
