@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quầy Dược - Tiếp Nhận & Xử Lý Hàng Chờ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/board.css">
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script src="/js/signalr.min.js"></script>
    <script src="/js/audioQueue.js?v=@DateTime.UtcNow.Ticks"></script>
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#1e40af',
                            danger: '#dc2626',
                            success: '#16a34a',
                            accent: '#0f172a',
                        }
                    }
                }
            }
    </script>
    <style>
            /* Tùy chỉnh thanh cuộn nhỏ gọn */
            ::-webkit-scrollbar {
                width: 5px;
                height: 5px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f5f9;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 4px;
            }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }
    </style>
</head>

<body class="bg-slate-100 text-slate-900 font-sans flex flex-col h-screen overflow-hidden select-none p-2">

    <!-- HEADER -->
    <header
        class="flex justify-between items-center bg-white py-1.5 px-3.5 border-2 border-slate-300 shadow-xs gap-2 shrink-0 rounded-xl mb-2">
        <div class="flex items-center gap-3">
            <a href="/duoc" title="Về danh sách hàng chờ Dược (Esc)"
               class="flex items-center justify-center w-9 h-9 text-slate-500 hover:text-brand border border-slate-200 hover:border-brand rounded-lg transition shrink-0 bg-slate-50 hover:bg-blue-50">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-10 md:h-12 object-contain">
            <div class="tabular-nums">
                <div id="date-str" class="text-[11px] text-slate-500 font-bold uppercase tracking-widest leading-tight">
                </div>
                <div id="time-str" class="text-lg md:text-xl font-black text-brand leading-none"></div>
            </div>
        </div>

        <div class="flex-1 text-center">
            <h1 class="text-lg md:text-xl lg:text-2xl font-black text-brand tracking-wide uppercase leading-none">
                QUẦY DƯỢC - TIẾP NHẬN & XỬ LÝ HÀNG CHỜ
            </h1>
        </div>

        <div class="flex items-center gap-2">
            <div
                class="hidden xl:flex items-center gap-2 bg-blue-50 px-3 py-1 rounded-xl border border-blue-200 text-xs font-bold text-blue-800">
                <i class="fa-solid fa-bullhorn text-brand"></i>
                <span>Bấm Ô 1 - 4 tại mỗi danh sách để phát loa</span>
            </div>
            <button onclick="refreshAllColumns()" title="Làm mới tất cả danh sách (F5)"
                    class="flex items-center gap-1.5 px-3 py-1.5 bg-white border-2 border-slate-300 hover:border-brand text-slate-700 hover:text-brand rounded-lg text-xs font-black transition cursor-pointer">
                <i class="fa-solid fa-rotate text-xs"></i>
                <span class="hidden sm:inline">Làm mới</span>
            </button>
            <button onclick="toggleFullScreen()" title="Toàn màn hình (F11)"
                    class="flex items-center justify-center w-8 h-8 md:w-9 md:h-9 bg-white border-2 border-slate-300 text-slate-600 hover:text-brand rounded-lg transition cursor-pointer">
                <i class="fa-solid fa-expand text-sm"></i>
            </button>
        </div>
    </header>

    <!-- MAIN: 3 KHU VỰC CHÍNH -->
    <main class="flex-grow grid grid-cols-1 lg:grid-cols-12 gap-2.5 min-h-0">

        <!-- ======================================================== -->
        <!-- CỘT 1: Ô NHẬP & QUÉT BARCODE (3 CỘT) -->
        <!-- ======================================================== -->
        <section class="lg:col-span-3 flex flex-col gap-2 min-h-0 overflow-hidden">
            <!-- Ô Quét Mã Barcode / Nhập Mã Khám -->
            <div id="scan-box"
                 class="bg-white border-2 border-slate-300 rounded-xl p-3.5 flex flex-col gap-2 shrink-0 transition-all duration-200 shadow-xs">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i id="scan-icon" class="fa-solid fa-barcode text-brand text-xl w-7 text-center shrink-0"></i>
                        <div id="scan-label"
                             class="font-black text-slate-800 text-xs md:text-sm uppercase tracking-wide">
                            Quét barcode / Gõ mã
                        </div>
                    </div>
                    <span class="text-[11px] text-slate-400 font-semibold hidden sm:inline">
                        <kbd
                        class="bg-slate-100 border border-slate-300 rounded px-1.5 py-0.5 font-mono text-slate-700">Enter</kbd>
                        tiếp nhận
                    </span>
                </div>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-sm"></i>
                    </span>
                    <input type="text" id="scan-input"
                           class="w-full pl-9 pr-3 py-2.5 border-2 border-slate-200 rounded-xl font-mono font-bold text-base text-slate-800 focus:outline-none focus:border-brand bg-slate-50 tracking-wider transition"
                           placeholder="Quét mã vạch hoặc nhập mã khám..." autocomplete="off" autocorrect="off"
                           spellcheck="false" autofocus>
                </div>
                <div id="state-label" class="text-[11px] font-bold text-slate-500 truncate">
                    Sẵn sàng – Quét mã để tiếp nhận vào hàng chờ
                </div>
            </div>

            <!-- Thẻ Thông Tin Bệnh Nhân Vừa Quét -->
            <div id="patient-card"
                 class="hidden bg-white border-2 border-slate-300 rounded-xl p-3.5 flex flex-col gap-2.5 shrink-0 shadow-xs">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-user-injured text-brand text-xs"></i>
                        <span class="text-[11px] font-black uppercase tracking-wider text-slate-500">Thông tin tiếp nhận</span>
                    </div>
                    <div id="loai-badge" class="hidden">
                        <div id="loai-badge-inner" class="flex items-center gap-1"></div>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center shrink-0">
                        <i id="bn-gender-icon" class="fa-solid fa-person text-brand text-lg"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div id="p-hoten"
                             class="text-base font-black text-slate-900 uppercase tracking-wide leading-tight truncate">
                        </div>
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1">
                            <span class="text-xs text-slate-500 flex items-center gap-1">
                                <i class="fa-regular fa-calendar text-slate-400"></i>
                                <span id="p-ngaysinh">—</span>
                            </span>
                            <span class="text-xs text-slate-500 flex items-center gap-1">
                                <i class="fa-solid fa-venus-mars text-slate-400"></i>
                                <span id="p-gioitinh">—</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- KHỐI 1: TOA BẢO HIỂM (BHYT) -->
                <div id="p-bhyt-block" class="hidden bg-blue-50/80 border border-blue-200 rounded-xl p-2.5 flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-black text-blue-900 uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-shield-halved text-blue-600"></i> Toa Bảo Hiểm
                        </span>
                       
                    </div>
                    <div class="flex items-center gap-2 flex-wrap text-xs text-blue-950 font-bold">
                        <span class="inline-flex items-center gap-1 font-mono">
                            Số đơn: <strong id="p-sohd-bhyt" class="text-blue-900 font-black">—</strong>
                        </span>
                        <span id="p-maba-bhyt-wrap" class="hidden inline-flex items-center gap-1 font-mono text-slate-600">
                            <span>(MBA: <strong id="p-maba-bhyt" class="text-slate-800 font-bold">—</strong>)</span>
                        </span>
                    </div>
                </div>

                <!-- KHỐI 2: TOA DỊCH VỤ -->
                <div id="p-dv-block" class="hidden bg-purple-50/80 border border-purple-200 rounded-xl p-2.5 flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-black text-purple-900 uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-coins text-purple-600"></i> Toa Dịch Vụ
                        </span>
                      
                    </div>
                    <div class="flex items-center gap-2 flex-wrap text-xs text-purple-950 font-bold">
                        <span class="inline-flex items-center gap-1 font-mono">
                            Số đơn: <strong id="p-sohd-dv" class="text-purple-900 font-black">—</strong>
                        </span>
                        <span id="p-maba-dv-wrap" class="hidden inline-flex items-center gap-1 font-mono text-slate-600">
                            <span>(MBA: <strong id="p-maba-dv" class="text-slate-800 font-bold">—</strong>)</span>
                        </span>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                    <button type="button" id="btn-copy-makb-card" onclick="copyCurrentPatientMakb(this, event)"
                            title="Bấm để sao chép mã khám"
                            class="inline-flex items-center gap-1 px-2.5 py-1 bg-blue-50 hover:bg-blue-100 text-brand border border-blue-200 rounded-lg font-mono text-xs font-bold transition cursor-pointer active:scale-95">
                        <i class="fa-regular fa-copy text-xs"></i>
                        <span>MKB: <span id="p-makb" class="font-black"></span></span>
                    </button>
                    <button type="button" onclick="resetPatientCard()"
                            class="text-xs text-slate-400 hover:text-danger font-bold flex items-center gap-1 transition cursor-pointer">
                        <i class="fa-solid fa-xmark"></i> Đóng
                    </button>
                </div>
            </div>

                <!-- Danh Sách Đơn Thuốc Dịch Vụ (Nếu có) -->
                <div id="thuoc-section"
                     class="hidden bg-white border-2 border-slate-300 rounded-xl p-3.5 flex flex-col gap-2 flex-grow min-h-0 shadow-xs overflow-hidden">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2 shrink-0">
                        <div class="flex items-center gap-1.5">
                            <i class="fa-solid fa-prescription-bottle-medical text-brand text-xs"></i>
                            <span class="text-[11px] font-black uppercase tracking-wider text-slate-500">Đơn thuốc dịch
                                vụ</span>
                            </div>
                            <span id="thuoc-count"
                                  class="px-2 py-0.5 bg-slate-100 rounded-full text-[11px] font-bold text-slate-500">0 đơn</span>
                        </div>
                        <div id="thuoc-list" class="flex flex-col gap-1.5 overflow-y-auto flex-grow min-h-0 pr-1"></div>
                        <div id="total-row"
                             class="shrink-0 flex items-center justify-between bg-amber-50 border border-amber-200 rounded-xl px-3 py-2 mt-1">
                            <span class="text-xs font-black text-amber-800 uppercase tracking-wide flex items-center gap-1.5">
                                <i class="fa-solid fa-coins text-amber-500"></i> Tổng tiền:
                            </span>
                            <span id="total-val" class="text-base font-black text-amber-700 tabular-nums">0 ₫</span>
                        </div>
                    </div>

                    <!-- Gợi ý phím tắt -->
                    <div
                        class="mt-auto bg-slate-200/60 border border-slate-300/80 rounded-xl p-2.5 text-[11px] text-slate-600 space-y-1 shrink-0 hidden sm:block">
                        <div class="font-black uppercase tracking-wider text-slate-500 flex items-center gap-1 text-[10px]">
                            <i class="fa-solid fa-keyboard"></i> Phím tắt tiện ích
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Tiếp nhận mã:</span>
                            <kbd
                            class="bg-white border border-slate-300 rounded px-1.5 py-0.2 font-mono font-bold text-slate-800">Enter</kbd>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Xóa trắng / Làm mới:</span>
                            <kbd
                            class="bg-white border border-slate-300 rounded px-1.5 py-0.2 font-mono font-bold text-slate-800">Esc</kbd>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Toàn màn hình:</span>
                            <kbd
                            class="bg-white border border-slate-300 rounded px-1.5 py-0.2 font-mono font-bold text-slate-800">F11</kbd>
                        </div>
                    </div>
                </section>

                <!-- ======================================================== -->
                <!-- CỘT 2: CHƯA THU TIỀN & LỊCH SỬ KHÔNG MUA (4 CỘT) -->
                <!-- ======================================================== -->
                <section
                    class="lg:col-span-4 bg-white border-2 border-slate-300 rounded-xl flex flex-col min-h-0 shadow-xs overflow-hidden">
                    <!-- Header Tab Cột Dịch Vụ -->
                    <div class="flex items-center justify-between border-b-2 border-slate-200 p-2 shrink-0 bg-slate-50 gap-1.5">
                        <div class="flex items-center gap-1 flex-1">
                            <button type="button" id="tab-btn-cho-thu" onclick="switchThuTab('cho-thu')"
                                    class="px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-amber-500 text-white shadow-xs cursor-pointer">
                                <i class="fa-solid fa-coins"></i> Chưa Thu
                                <span class="px-1.5 py-0.2 bg-white text-amber-800 rounded-full text-[10px] font-black"
                                      id="cho-thu-count">0</span>
                            </button>
                            <button type="button" id="tab-btn-khong-mua" onclick="switchThuTab('khong-mua')"
                                    class="px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-rose-700 hover:bg-slate-100 cursor-pointer">
                                <i class="fa-solid fa-ban"></i> Lịch Sử Không Mua
                                <span class="px-1.5 py-0.2 bg-slate-200 text-slate-700 rounded-full text-[10px] font-black"
                                      id="khong-mua-count">0</span>
                            </button>
                        </div>
                        <button onclick="refreshThuTab()" title="Làm mới danh sách chưa thu / không mua"
                                class="text-xs text-amber-800 hover:text-amber-950 font-bold px-2 py-1 rounded-lg border border-amber-300 hover:border-amber-500 bg-amber-50 transition flex items-center gap-1 cursor-pointer shrink-0">
                            <i class="fa-solid fa-rotate text-xs"></i>
                        </button>
                    </div>

                    <!-- Ô tìm kiếm trong cột Chưa Thu / Không Mua -->
                    <div class="px-2.5 py-1.5 bg-slate-50 border-b border-slate-200 shrink-0">
                        <div class="relative">
                            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" id="search-thu-input" oninput="filterThuList()"
                                   class="w-full pl-7 pr-7 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-800 focus:outline-none focus:border-amber-500"
                                   placeholder="Lọc tên hoặc mã KB...">
                            <button type="button" onclick="clearThuSearch()" id="clear-thu-search-btn"
                                    class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Tab 1: Danh Sách Chưa Thu Tiền (Có nút Gọi Loa Ô 1-4 & Nút Không Mua) -->
                    <div class="flex-grow overflow-y-auto overflow-x-hidden p-2.5 space-y-2 min-h-0 bg-slate-50/40"
                         id="cho-thu-list">
                        <div id="cho-thu-empty"
                             class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                            <i class="fa-solid fa-receipt text-3xl text-slate-300"></i>
                            <p class="text-xs font-bold text-slate-400">Không có đơn nào chưa thu tiền</p>
                        </div>
                    </div>

                    <!-- Tab 2: Danh Sách Lịch Sử Không Mua (Có Nút Khách Mua Lại / Hoàn Tác) -->
                    <div class="hidden flex-grow overflow-y-auto overflow-x-hidden p-2.5 space-y-2 min-h-0 bg-slate-50/40"
                         id="khong-mua-list">
                        <div id="khong-mua-empty"
                             class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                            <i class="fa-solid fa-ban text-3xl text-slate-300"></i>
                            <p class="text-xs font-bold text-slate-400">Chưa có đơn nào không mua hôm nay</p>
                        </div>
                    </div>
                </section>

                <section
                    class="lg:col-span-5 bg-white border-2 border-slate-300 rounded-xl flex flex-col min-h-0 shadow-xs overflow-hidden">
                    <!-- Header Tab Cột Giao Thuốc -->
                    <div class="flex items-center justify-between border-b-2 border-slate-200 p-2 shrink-0 bg-slate-50 gap-1.5">
                        <div class="flex items-center gap-1 flex-1">
                            <button type="button" id="tab-btn-cho-giao" onclick="switchGiaoTab('cho-giao')"
                                    class="px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-brand text-white shadow-xs cursor-pointer">
                                <i class="fa-solid fa-box-open"></i> Chờ Phát
                                <span class="px-1.5 py-0.2 bg-white text-brand rounded-full text-[10px] font-black"
                                      id="cho-giao-count">0</span>
                            </button>
                            <button type="button" id="tab-btn-da-giao" onclick="switchGiaoTab('da-giao')"
                                    class="px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer">
                                <i class="fa-solid fa-clock-rotate-left"></i> Lịch Sử Đã Phát
                                <span class="px-1.5 py-0.2 bg-slate-200 text-slate-700 rounded-full text-[10px] font-black"
                                      id="da-giao-count">0</span>
                            </button>
                        </div>
                        <button onclick="refreshGiaoTab()" title="Làm mới danh sách giao thuốc"
                                class="text-xs text-brand hover:text-blue-800 font-bold px-2 py-1 rounded-lg border border-blue-200 hover:border-brand bg-blue-50 transition flex items-center gap-1 cursor-pointer shrink-0">
                            <i class="fa-solid fa-rotate text-xs"></i>
                        </button>
                    </div>

                    <!-- Ô tìm kiếm trong cột Giao Thuốc -->
                    <div class="px-2.5 py-1.5 bg-slate-50 border-b border-slate-200 shrink-0">
                        <div class="relative">
                            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" id="search-giao-input" oninput="filterGiaoList()"
                                   class="w-full pl-7 pr-7 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-800 focus:outline-none focus:border-brand"
                                   placeholder="Lọc tên hoặc mã KB...">
                            <button type="button" onclick="clearGiaoSearch()" id="clear-giao-search-btn"
                                    class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>


                    <div class="flex-grow overflow-y-auto overflow-x-hidden p-2.5 space-y-2 min-h-0 bg-slate-50/40"
                         id="cho-giao-list">
                        <div id="cho-giao-empty"
                             class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                            <i class="fa-solid fa-clipboard-check text-3xl text-slate-300"></i>
                            <p class="text-xs font-bold text-slate-400">Không có đơn nào đang chờ phát</p>
                        </div>
                    </div>

                    <div class="hidden flex-grow overflow-y-auto overflow-x-hidden p-2.5 space-y-2 min-h-0 bg-slate-50/40"
                         id="da-giao-list">
                        <div id="da-giao-empty"
                             class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                            <i class="fa-solid fa-clock-rotate-left text-3xl text-slate-300"></i>
                            <p class="text-xs font-bold text-slate-400">Chưa có đơn nào đã phát hôm nay</p>
                        </div>
                    </div>
                </section>

            </main>


            <div id="undo-toast"
                 class="fixed bottom-5 right-5 z-50 flex items-center gap-3 bg-slate-900/95 text-white px-4 py-3 rounded-2xl shadow-2xl border border-slate-700 backdrop-blur transition-all duration-300 opacity-0 translate-y-3 pointer-events-none">
                <i id="undo-toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-base shrink-0"></i>
                <div class="flex flex-col min-w-0">
                    <span id="undo-toast-msg" class="text-xs md:text-sm font-bold truncate">Thao tác thành công</span>
                    <span id="undo-toast-sub" class="text-[11px] text-slate-400">Bấm nút để hoàn tác lại nếu nhầm</span>
                </div>
                <button id="undo-toast-btn" onclick="triggerToastUndo()" type="button"
                        class="ml-2 px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs rounded-xl shadow transition active:scale-95 cursor-pointer whitespace-nowrap">
                    <i class="fa-solid fa-rotate-left mr-1"></i> Hoàn tác
                </button>
            </div>

            <!-- JAVASCRIPT XỬ LÝ TOÀN BỘ LOGIC -->
            <script>
                    const $id = id => document.getElementById(id);
                    const scanInput = $id('scan-input');
        
                    let autoResetTimer = null;
                    let autoTimer = null;
                    let lastInputTime = 0;
                    let isScanning = false;
                    let currentScannedMakb = '';
                    let thuocList = [];

                    // Tab states
                    let currentThuTab = 'cho-thu';   // 'cho-thu' | 'khong-mua'
                    let currentGiaoTab = 'cho-giao'; // 'cho-giao' | 'da-giao'

                    // Data caches
                    let rawChuaGiaoData = [];
                    let rawDaGiaoData = [];
                    let rawKhongMuaData = [];

                    // Highlight tracker
                    let highlightedKey = '';
                    let highlightTimer = null;

                    // Undo Toast Tracker
                    let lastActionData = null; // { makb, mabn, hoTen }
                    let undoToastTimer = null;

                    // ========================================================
                    // ĐỒNG HỒ
                    // ========================================================
                    function updateTime() {
                        const now = new Date();
                        const dateEl = $id('date-str');
                        const timeEl = $id('time-str');
                        if (dateEl) dateEl.textContent = now.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
                        if (timeEl) timeEl.textContent = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
                    }
                    setInterval(updateTime, 1000);
                    updateTime();

                    function fmtMoney(n) {
                        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n || 0);
                    }

                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                    }

                    function getOcuaBadge(ocua) {
                        if (!ocua) return `<span class="px-2 py-0.5 rounded font-black text-[10px] bg-slate-100 text-slate-400 border border-slate-200">Chưa ô</span>`;
                        const val = String(ocua).trim();
                        let cls = 'bg-blue-100 text-blue-800 border-blue-200';
                        if (val === '2') cls = 'bg-emerald-100 text-emerald-800 border-emerald-200';
                        else if (val === '3') cls = 'bg-purple-100 text-purple-800 border-purple-200';
                        else if (val === '4') cls = 'bg-amber-100 text-amber-800 border-amber-200';
                        return `<span class="px-2 py-0.5 rounded font-black text-[10px] uppercase tracking-wide border shadow-2xs ${cls}"><i class="fa-solid fa-door-open mr-0.5"></i> Ô ${escapeHtml(val)}</span>`;
                    }

                    // ========================================================
                    // ÂM THANH BEEP PHẢN HỒI
                    // ========================================================
                    let nhapAudioCtx = null;
                    function getNhapAudioContext() {
                        if (!nhapAudioCtx) {
                            const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                            if (AudioCtxClass) nhapAudioCtx = new AudioCtxClass();
                        }
                        if (nhapAudioCtx && nhapAudioCtx.state === 'suspended') {
                            nhapAudioCtx.resume().catch(() => { });
                        }
                        return nhapAudioCtx;
                    }

                    function playScanBeep(isSuccess) {
                        try {
                            const ctx = getNhapAudioContext();
                            if (!ctx) return;
                            const osc = ctx.createOscillator();
                            const gain = ctx.createGain();
                            const now = ctx.currentTime;
                            if (isSuccess) {
                                osc.frequency.setValueAtTime(880, now);
                                gain.gain.setValueAtTime(0.3, now);
                                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                                osc.connect(gain);
                                gain.connect(ctx.destination);
                                osc.start(now);
                                osc.stop(now + 0.25);
                            } else {
                                osc.frequency.setValueAtTime(220, now);
                                gain.gain.setValueAtTime(0.35, now);
                                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                                osc.connect(gain);
                                gain.connect(ctx.destination);
                                osc.start(now);
                                osc.stop(now + 0.3);
                            }
                        } catch (e) { }
                    }

                    ['click', 'keydown', 'input', 'touchstart'].forEach(type => {
                        document.addEventListener(type, () => getNhapAudioContext(), { passive: true, once: true });
                    });

                    function triggerHighlight(key) {
                        if (!key) return;
                        highlightedKey = String(key).trim();
                        if (highlightTimer) clearTimeout(highlightTimer);
                        highlightTimer = setTimeout(() => {
                            highlightedKey = '';
                            renderChoThuList();
                            renderChoGiaoList();
                        }, 3500);
                    }

                    // ========================================================
                    // TOAST & HOÀN TÁC BANNER
                    // ========================================================
                    function showUndoToast(msg, actionPayload) {
                        const toast = $id('undo-toast');
                        const msgEl = $id('undo-toast-msg');
                        const btnEl = $id('undo-toast-btn');
                        if (!toast || !msgEl) return;

                        lastActionData = actionPayload;
                        msgEl.textContent = msg;

                        if (btnEl) {
                            btnEl.classList.toggle('hidden', !actionPayload);
                        }

                        toast.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
                        toast.classList.add('opacity-100', 'translate-y-0');

                        if (undoToastTimer) clearTimeout(undoToastTimer);
                        undoToastTimer = setTimeout(() => {
                            toast.classList.remove('opacity-100', 'translate-y-0');
                            toast.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
                            lastActionData = null;
                        }, 6000);
                    }

                    async function triggerToastUndo() {
                        if (!lastActionData) return;
                        const { makb, mabn, hoTen, actionType } = lastActionData;
            
                        // Ẩn toast
                        const toast = $id('undo-toast');
                        if (toast) {
                            toast.classList.remove('opacity-100', 'translate-y-0');
                            toast.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
                        }
                        lastActionData = null;

                        if (actionType === 'khong_mua') {
                            await actionHoanTacKhongMua(makb, mabn, hoTen);
                        } else {
                            await actionHoanTac(makb, mabn, hoTen);
                        }
                    }

                    function copyToClipboard(text, btnElement, event) {
                        if (event) {
                            event.stopPropagation();
                            event.preventDefault();
                        }
                        if (!text) return;
                        const str = String(text).trim();
                        if (!str) return;

                        const doFeedback = () => {
                            showUndoToast(`Đã sao chép: ${str}`, null);
                            if (btnElement) {
                                const icon = btnElement.querySelector('i');
                                if (icon) {
                                    const oldClass = icon.className;
                                    icon.className = 'fa-solid fa-check text-emerald-600';
                                    setTimeout(() => { icon.className = oldClass; }, 1500);
                                }
                            }
                        };

                        if (navigator.clipboard && window.isSecureContext) {
                            navigator.clipboard.writeText(str).then(doFeedback).catch(() => fallbackCopy(str, doFeedback));
                        } else {
                            fallbackCopy(str, doFeedback);
                        }
                    }

                    function fallbackCopy(text, callback) {
                        try {
                            const textarea = document.createElement('textarea');
                            textarea.value = text;
                            textarea.style.position = 'fixed';
                            textarea.style.left = '-999999px';
                            textarea.style.top = '-999999px';
                            document.body.appendChild(textarea);
                            textarea.focus();
                            textarea.select();
                            document.execCommand('copy');
                            document.body.removeChild(textarea);
                            if (callback) callback();
                        } catch (e) {
                            showUndoToast(`Không thể sao chép: ${text}`, null);
                        }
                    }

                    function copyCurrentPatientMakb(btnEl, event) {
                        if (currentScannedMakb) copyToClipboard(currentScannedMakb, btnEl, event);
                    }

                    // ========================================================
                    // QUẢN LÝ THẺ BỆNH NHÂN VỪA QUÉT (CỘT 1)
                    // ========================================================
                    function setScanState(type) {
                        const box = $id('scan-box');
                        const icon = $id('scan-icon');
                        if (box) {
                            box.className = 'bg-white border-2 rounded-xl p-3.5 flex flex-col gap-2 shrink-0 transition-all duration-200 shadow-xs';
                        }
                        if (type === 'loading') {
                            if (box) box.classList.add('border-amber-300');
                            if (icon) icon.className = 'fa-solid fa-spinner fa-spin text-amber-500 text-xl w-7 text-center shrink-0';
                        } else if (type === 'success') {
                            if (box) box.classList.add('border-green-400', 'bg-green-50/50');
                            if (icon) icon.className = 'fa-solid fa-circle-check text-success text-xl w-7 text-center shrink-0';
                        } else if (type === 'error') {
                            if (box) {
                                box.classList.add('border-danger', 'bg-red-50/50');
                                box.animate([
                                    { transform: 'translateX(-5px)' }, { transform: 'translateX(5px)' },
                                    { transform: 'translateX(-4px)' }, { transform: 'translateX(4px)' },
                                    { transform: 'translateX(0)' }
                                ], { duration: 350 });
                            }
                            if (icon) icon.className = 'fa-solid fa-circle-xmark text-danger text-xl w-7 text-center shrink-0';
                        } else {
                            if (box) box.classList.add('border-slate-300');
                            if (icon) icon.className = 'fa-solid fa-barcode text-brand text-xl w-7 text-center shrink-0';
                        }
                    }

                    function setStatus(msg) {
                        const el = $id('state-label');
                        if (el) el.textContent = msg;
                    }

                    function setLoaiBadge(data) {
                        const el = $id('loai-badge-inner');
                        const badgeWrap = $id('loai-badge');
                        if (!el || !badgeWrap) return;
                        if (data.hasBhyt && data.hasDichVu) {
                            el.innerHTML = `
                                <span class="px-2 py-0.5 rounded bg-blue-600 text-white font-black text-[10px] tracking-wide shadow-2xs flex items-center gap-1">
                                    <i class="fa-solid fa-shield-halved"></i> BẢO HIỂM
                                </span>
                                <span class="px-2 py-0.5 rounded bg-purple-600 text-white font-black text-[10px] tracking-wide shadow-2xs flex items-center gap-1">
                                    <i class="fa-solid fa-coins"></i> DỊCH VỤ
                                </span>`;
                        } else if (data.hasDichVu) {
                            el.innerHTML = `
                                <span class="px-2.5 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-purple-600 text-white shadow-xs flex items-center gap-1">
                                    <i class="fa-solid fa-coins"></i> TOA DỊCH VỤ
                                </span>`;
                        } else {
                            el.innerHTML = `
                                <span class="px-2.5 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-blue-600 text-white shadow-xs flex items-center gap-1">
                                    <i class="fa-solid fa-shield-halved"></i> TOA BẢO HIỂM
                                </span>`;
                        }
                        badgeWrap.classList.remove('hidden');
                    }

                    function showPatient(data) {
                        currentScannedMakb = (data.makb || data.makh || data.mabn || '').trim();
                        if ($id('p-hoten')) $id('p-hoten').textContent = data.hoTen || '—';
                        if ($id('p-ngaysinh')) $id('p-ngaysinh').textContent = data.ngaySinh || '—';
                        if ($id('p-gioitinh')) $id('p-gioitinh').textContent = data.gioiTinh || '—';
                        if ($id('p-makb')) $id('p-makb').textContent = currentScannedMakb || '—';

                        // 1. Toa Bảo Hiểm (BHYT)
                        const bhytBlock = $id('p-bhyt-block');
                        if (bhytBlock) {
                            if (data.hasBhyt) {
                                bhytBlock.classList.remove('hidden');
                                const sohdVal = data.sohdBhyt || data.mabaBhyt || data.sohd || data.maba || '—';
                                if ($id('p-sohd-bhyt')) $id('p-sohd-bhyt').textContent = sohdVal;
                                const mabaWrap = $id('p-maba-bhyt-wrap');
                                if (mabaWrap) {
                                    if (data.mabaBhyt && data.mabaBhyt !== data.sohdBhyt) {
                                        if ($id('p-maba-bhyt')) $id('p-maba-bhyt').textContent = data.mabaBhyt;
                                        mabaWrap.classList.remove('hidden');
                                    } else {
                                        mabaWrap.classList.add('hidden');
                                    }
                                }
                            } else {
                                bhytBlock.classList.add('hidden');
                            }
                        }

                        // 2. Toa Dịch Vụ
                        const dvBlock = $id('p-dv-block');
                        if (dvBlock) {
                            if (data.hasDichVu) {
                                dvBlock.classList.remove('hidden');
                                const sohdDvVal = data.sohdDv || data.mabaDv || data.sohd || data.maba || '—';
                                if ($id('p-sohd-dv')) $id('p-sohd-dv').textContent = sohdDvVal;
                                const mabaDvWrap = $id('p-maba-dv-wrap');
                                if (mabaDvWrap) {
                                    if (data.mabaDv && data.mabaDv !== data.sohdDv) {
                                        if ($id('p-maba-dv')) $id('p-maba-dv').textContent = data.mabaDv;
                                        mabaDvWrap.classList.remove('hidden');
                                    } else {
                                        mabaDvWrap.classList.add('hidden');
                                    }
                                }
                            } else {
                                dvBlock.classList.add('hidden');
                            }
                        }

                        if ($id('bn-gender-icon')) {
                            $id('bn-gender-icon').className = data.gioiTinh === 'Nữ'
                                ? 'fa-solid fa-person-dress text-pink-500 text-lg'
                                : 'fa-solid fa-person text-brand text-lg';
                        }
                        const patientCard = $id('patient-card');
                        if (patientCard) patientCard.classList.remove('hidden');
                    }

                    function addThuocRow(t, idx) {
                        const listEl = $id('thuoc-list');
                        if (!listEl) return;
                        const tien = Number(t.thanhtien ?? t.Thanhtien ?? t.tienVat ?? 0);
                        const div = document.createElement('div');
                        div.className = 'flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200 rounded-xl overflow-hidden';
                        div.innerHTML = `
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="w-6 h-6 rounded-md bg-purple-600 text-white flex items-center justify-center font-black text-xs shrink-0">${idx + 1}</span>
                                            <div class="min-w-0">
                                                <div class="text-xs font-black text-slate-800 flex items-center gap-1.5">
                                                    <span>Đơn thuốc ${idx + 1}</span>
                                                    <span class="px-1.5 py-0.2 bg-blue-50 text-blue-800 border border-blue-200 rounded font-mono text-[10px] font-bold">SHĐ: ${escapeHtml(t.sohd) || '—'}</span>
                                                </div>
                                                <div class="text-[10px] text-slate-400 font-mono truncate">${t.maba ? `MBA: ${escapeHtml(t.maba)}` : ''}</div>
                                            </div>
                                        </div>
                                        <div class="text-xs md:text-sm font-black text-rose-700 tabular-nums shrink-0">${fmtMoney(tien)}</div>`;
                        listEl.appendChild(div);
                    }

                    function updateTotalThuoc() {
                        const total = thuocList.reduce((s, t) => s + Number(t.thanhtien ?? t.Thanhtien ?? t.tienVat ?? 0), 0);
                        const totalVal = $id('total-val');
                        const totalRow = $id('total-row');
                        const thuocCount = $id('thuoc-count');
                        if (totalVal) totalVal.textContent = fmtMoney(total);
                        if (totalRow) totalRow.classList.toggle('hidden', thuocList.length === 0);
                        if (thuocCount) thuocCount.textContent = `${thuocList.length} đơn`;
                    }

                    function resetPatientCard() {
                        thuocList = [];
                        currentScannedMakb = '';
                        const pCard = $id('patient-card');
                        if (pCard) pCard.classList.add('hidden');
                        const bhytBlock = $id('p-bhyt-block');
                        if (bhytBlock) bhytBlock.classList.add('hidden');
                        const dvBlock = $id('p-dv-block');
                        if (dvBlock) dvBlock.classList.add('hidden');
                        const thuocSec = $id('thuoc-section');
                        if (thuocSec) thuocSec.classList.add('hidden');
                        const thuocListEl = $id('thuoc-list');
                        if (thuocListEl) thuocListEl.innerHTML = '';
                        const loaiBadge = $id('loai-badge');
                        if (loaiBadge) loaiBadge.classList.add('hidden');
                    }

                    function resetAll() {
                        if (autoResetTimer) {
                            clearTimeout(autoResetTimer);
                            autoResetTimer = null;
                        }
                        resetPatientCard();
                        if (scanInput) scanInput.value = '';
                        setScanState('');
                        setStatus('Sẵn sàng – Quét mã để tiếp nhận vào hàng chờ');
                        if (scanInput) scanInput.focus({ preventScroll: true });
                        refreshAllColumns();
                    }

                    function showError(msg) {
                        setScanState('error');
                        setStatus(msg || 'Lỗi không xác định');
                        if (scanInput) {
                            scanInput.select();
                            scanInput.focus({ preventScroll: true });
                        }
                        autoResetTimer = setTimeout(() => {
                            setScanState('');
                            setStatus('Sẵn sàng – Quét mã để tiếp nhận vào hàng chờ');
                        }, 4000);
                    }

                    // ========================================================
                    // QUÉT & TIẾP NHẬN TỰ ĐỘNG
                    // ========================================================
                    async function handleScan(raw) {
                        let code = (raw || '').replace(/[\r\n\t]/g, '').trim();
                        if (!code || isScanning) return;
                        isScanning = true;

                        clearTimeout(autoTimer);
                        if (autoResetTimer) {
                            clearTimeout(autoResetTimer);
                            autoResetTimer = null;
                        }

                        setScanState('loading');
                        setStatus('Đang tra cứu mã: ' + code + '...');

                        try {
                            // 1. Tra cứu thông tin chứng từ & bệnh nhân
                            let data;
                            try {
                                const r = await fetch(`/api/duoc-nhap/scan?makh=${encodeURIComponent(code)}`);
                                data = await r.json();
                            } catch (err) {
                                playScanBeep(false);
                                showError('Lỗi kết nối server.');
                                return;
                            }

                            if (!data.success) {
                                playScanBeep(false);
                                showError(data.message || `Không tìm thấy mã '${code}'.`);
                                return;
                            }

                            // Xoá ô nhập sau khi tìm thấy
                            if (scanInput) scanInput.value = '';

                            // 2. Hiển thị thông tin bệnh nhân
                            setLoaiBadge(data);
                            showPatient(data);

                            if (data.hasDichVu) {
                                thuocList = (data.danhSachThuoc && data.danhSachThuoc.length > 0)
                                    ? data.danhSachThuoc
                                    : [{ sohd: data.sohdDv || data.sohd, maba: data.mabaDv || data.maba, thanhtien: data.thanhtien ?? 0 }];
                                const thuocSec = $id('thuoc-section');
                                if (thuocSec) thuocSec.classList.remove('hidden');
                                const tListEl = $id('thuoc-list');
                                if (tListEl) tListEl.innerHTML = '';
                                thuocList.forEach((t, i) => addThuocRow(t, i));
                                updateTotalThuoc();
                            } else {
                                const thuocSec = $id('thuoc-section');
                                if (thuocSec) thuocSec.classList.add('hidden');
                                const tListEl = $id('thuoc-list');
                                if (tListEl) tListEl.innerHTML = '';
                            }

                            // 3. Tự động tiếp nhận vào hàng chờ
                            let res;
                            try {
                                const r = await fetch('/api/duoc-nhap/them-hang-cho', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        makb: data.makb,
                                        mabn: data.mabn,
                                        hasBhyt: data.hasBhyt,
                                        hasDichVu: data.hasDichVu,
                                        loai: data.loai,
                                        maba: data.maba,
                                        ngayKcb: data.ngayKcb,
                                        oCua: null
                                    })
                                });
                                res = await r.json();
                            } catch (err) {
                                playScanBeep(false);
                                showError('Lỗi lưu vào hàng chờ.');
                                return;
                            }

                            if (!res.success) {
                                playScanBeep(false);
                                showError(res.message || 'Lỗi khi lưu vào hàng chờ.');
                                return;
                            }

                            // 4. Thành công
                            playScanBeep(true);
                            setScanState('success');
                            const msg = res.message || 'Đã tiếp nhận vào hàng chờ!';
                            setStatus(`${msg}`);
                            triggerHighlight(data.makb || data.mabn);
                            showUndoToast(`Đã tiếp nhận: ${data.hoTen}`, null);

                            // Cập nhật các danh sách
                            refreshAllColumns();

                            if (scanInput) scanInput.focus({ preventScroll: true });
                        } finally {
                            isScanning = false;
                        }
                    }

                    function switchThuTab(tab) {
                        currentThuTab = tab;
                        const btnChoThu = $id('tab-btn-cho-thu');
                        const btnKhongMua = $id('tab-btn-khong-mua');
                        const listChoThu = $id('cho-thu-list');
                        const listKhongMua = $id('khong-mua-list');

                        if (tab === 'cho-thu') {
                            if (btnChoThu) btnChoThu.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-amber-500 text-white shadow-xs cursor-pointer';
                            if (btnKhongMua) btnKhongMua.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-rose-700 hover:bg-slate-100 cursor-pointer';
                            if (listChoThu) listChoThu.classList.remove('hidden');
                            if (listKhongMua) listKhongMua.classList.add('hidden');
                            renderChoThuList();
                        } else {
                            if (btnKhongMua) btnKhongMua.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-rose-600 text-white shadow-xs cursor-pointer';
                            if (btnChoThu) btnChoThu.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-amber-800 hover:bg-slate-100 cursor-pointer';
                            if (listKhongMua) listKhongMua.classList.remove('hidden');
                            if (listChoThu) listChoThu.classList.add('hidden');
                            loadDanhSachKhongMua();
                        }
                    }

                    function refreshThuTab() {
                        loadDanhSachChuaGiao();
                        if (currentThuTab === 'khong-mua') loadDanhSachKhongMua();
                    }

                    function filterThuList() {
                        const clearBtn = $id('clear-thu-search-btn');
                        const query = ($id('search-thu-input')?.value || '').trim().toLowerCase();
                        if (clearBtn) clearBtn.classList.toggle('hidden', !query);
                        if (currentThuTab === 'cho-thu') renderChoThuList();
                        else renderKhongMuaList();
                    }

                    function clearThuSearch() {
                        const input = $id('search-thu-input');
                        if (input) input.value = '';
                        filterThuList();
                        if (input) input.focus();
                    }

                    function renderChoThuList() {
                        const container = $id('cho-thu-list');
                        const countEl = $id('cho-thu-count');
                        const query = ($id('search-thu-input')?.value || '').trim().toLowerCase();

                        const choThuItems = rawChuaGiaoData.filter(item => {
                            if (Number(item.dagiao) !== 0) return false;
                            if (item.isBhyt) return false;
                            return !item.daThu;
                        });
                        if (countEl) countEl.textContent = choThuItems.length;
                        if (!container) return;

                        const filtered = query
                            ? choThuItems.filter(i => (i.hoTen || '').toLowerCase().includes(query) || (i.makb || '').toLowerCase().includes(query) || (i.mabn || '').toLowerCase().includes(query) || (i.sohd || '').toLowerCase().includes(query))
                            : choThuItems;

                        if (filtered.length === 0) {
                            container.innerHTML = `
                                            <div id="cho-thu-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                                                <i class="fa-solid fa-receipt text-3xl text-slate-300"></i>
                                                <p class="text-xs font-bold text-slate-400">${query ? 'Không tìm thấy bệnh nhân phù hợp' : 'Không có đơn nào chưa thu tiền'}</p>
                                            </div>`;
                            return;
                        }

                        const prevScrollTop = container.scrollTop;
                        let html = '';
                        for (const item of filtered) {
