@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quầy Dược</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script src="/js/signalr.min.js"></script>
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#1e40af',
                            danger: '#dc2626',
                            success: '#16a34a',
                        }
                    }
                }
            }
    </script>
    <style>
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f5f9;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 4px;
            }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

            @@keyframes cardGlideIn {
                0% {
                    opacity: 0;
                    transform: translateY(10px) scale(0.99);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .patient-card-item {
                animation: cardGlideIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
                transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
                will-change: transform, opacity;
            }

            .patient-card-item:hover {
                transform: translateY(-1px);
            }
    </style>
</head>

<body
    class="bg-slate-100 text-slate-800 font-sans flex flex-col h-screen overflow-hidden select-none p-2.5 antialiased">

    <header
        class="bg-white border border-slate-200 shadow-xs rounded-lg px-4 py-2 flex flex-col md:flex-row items-center justify-between gap-3 shrink-0 mb-2.5">
        
        <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-start">
            <div class="flex items-center gap-2.5">
                <a href="/duoc" title="Về danh sách quầy Dược (Esc)"
                   class="flex items-center justify-center w-8 h-8 text-slate-500 hover:text-brand bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-brand rounded-lg transition shrink-0">
                    <i class="fa-solid fa-arrow-left text-xs"></i>
                </a>
                <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-8 md:h-9 object-contain">
                <div>
                    <div
                        class="text-sm font-black text-slate-900 leading-tight uppercase tracking-tight flex items-center gap-1.5">
                        <span>Quầy Dược</span>
                    </div>
                    <div class="text-[11px] font-semibold text-slate-500 flex items-center gap-2">
                        <span id="date-str">—</span>
                        <span class="text-slate-300">•</span>
                        <span id="time-str" class="font-black text-brand font-mono">--:--:--</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Center: Ô Quét Barcode & Nhập Mã Khám (Nổi bật, Gọn gàng) -->
        <div class="w-full md:max-w-xl flex-1 px-0 md:px-4">
            <div id="scan-box"
                 class="relative flex items-center bg-slate-50 hover:bg-white focus-within:bg-white border-2 border-slate-300 focus-within:border-brand rounded-lg transition duration-150 shadow-2xs">
                <span class="pl-3.5 pr-2 text-slate-400">
                    <i id="scan-icon" class="fa-solid fa-barcode text-base text-slate-500"></i>
                </span>
                <input type="text" id="scan-input"
                       class="w-full py-2 pr-24 bg-transparent font-mono font-bold text-sm md:text-base text-slate-900 placeholder:text-slate-400 placeholder:font-sans placeholder:font-normal placeholder:text-xs md:placeholder:text-sm focus:outline-none tracking-wider"
                       placeholder="Quét mã vạch hoặc gõ mã khám..." autocomplete="off" autocorrect="off"
                       spellcheck="false" autofocus>
                
                <div class="absolute right-2 flex items-center gap-1">
                    <kbd
                    class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono font-bold bg-white border border-slate-200 text-slate-500 rounded shadow-2xs">Enter</kbd>
                    <button type="button" onclick="resetAll()" title="Xóa trắng (Esc)"
                            class="text-slate-400 hover:text-slate-600 p-1 rounded transition text-xs">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Right: Controls & Quick Stats -->
        <div class="flex items-center gap-2 shrink-0">
            <button onclick="refreshAllColumns()" title="Làm mới danh sách (F5)"
                    class="flex items-center gap-1.5 px-3 py-2 bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-brand text-slate-700 hover:text-brand rounded-lg text-xs font-bold transition cursor-pointer">
                <i class="fa-solid fa-rotate text-xs"></i>
                <span class="hidden lg:inline">Làm mới</span>
            </button>
            <button onclick="toggleFullScreen()" title="Toàn màn hình (F11)"
                    class="flex items-center justify-center w-8 h-8 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-600 hover:text-slate-900 rounded-lg transition cursor-pointer">
                <i class="fa-solid fa-expand text-xs"></i>
            </button>
        </div>
    </header>

   
    <div id="patient-card"
         class="hidden bg-white border border-blue-200 shadow-sm rounded-lg p-2.5 mb-2.5 shrink-0 transition-all duration-200">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2.5">
            <!-- Thông tin cá nhân -->
            <div class="flex items-center gap-2.5 min-w-0">
                <div
                    class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center shrink-0">
                    <i id="bn-gender-icon" class="fa-solid fa-user text-brand text-sm"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span id="p-hoten"
                              class="text-sm md:text-base font-black text-slate-900 uppercase tracking-wide truncate"></span>
                        <div id="loai-badge" class="flex items-center gap-1"></div>
                    </div>
                    <div class="text-xs text-slate-500 flex items-center gap-2 mt-0.5 flex-wrap">
                        <span>Năm sinh: <strong id="p-ngaysinh" class="text-slate-700">—</strong></span>
                        <span>•</span>
                        <span>MKB: <strong id="p-makb" class="text-slate-700 font-mono">—</strong></span>
                    </div>
                </div>
            </div>

            <!-- Chi tiết các toa thuốc -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- BHYT -->
                <div id="p-bhyt-block"
                     class="hidden px-2.5 py-1 bg-blue-50 border border-blue-200 rounded-lg text-xs flex items-center gap-1.5 font-semibold text-blue-900">
                    <i class="fa-solid fa-id-card text-blue-600 text-[11px]"></i>
                    <span>BHYT:</span>
                    <span class="font-mono font-black text-blue-950" id="p-sohd-bhyt">—</span>
                </div>

                <!-- Dịch vụ -->
                <div id="p-dv-block"
                     class="hidden px-2.5 py-1 bg-purple-50 border border-purple-200 rounded-lg text-xs flex items-center gap-1.5 font-semibold text-purple-900">
                    <i class="fa-solid fa-receipt text-purple-600 text-[11px]"></i>
                    <span>Dịch vụ:</span>
                    <span class="font-mono font-black text-purple-950" id="p-sohd-dv">—</span>
                    <span id="total-val"
                          class="font-black text-xs md:text-sm text-rose-700 font-mono bg-white px-2 py-0.5 rounded border border-purple-300 shadow-2xs">0
                        ₫</span>
                    </div>

                    <button type="button" onclick="resetPatientCard()" title="Đóng thông tin này"
                            class="text-xs text-slate-400 hover:text-rose-600 p-1 rounded-lg hover:bg-slate-100 transition cursor-pointer">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- ======================================================== -->
        <!-- 2 CỘT DANH SÁCH CHÍNH (50% / 50%) -->
        <!-- ======================================================== -->
        <main class="flex-grow grid grid-cols-1 lg:grid-cols-2 gap-3 min-h-0">

            <!-- ======================================================== -->
            <!-- CỘT 1: CHƯA THU TIỀN & LỊCH SỬ KHÔNG MUA -->
            <!-- ======================================================== -->
            <section class="bg-white border border-slate-200 rounded-lg flex flex-col min-h-0 shadow-xs overflow-hidden">
                <!-- Header Tab Cột 1 -->
                <div
                    class="flex items-center justify-between border-b border-slate-200 px-3.5 py-2 shrink-0 bg-slate-50/70 gap-2">
                    <div class="flex items-center gap-1.5">
                        <button type="button" id="tab-btn-cho-thu" onclick="switchThuTab('cho-thu')"
                                class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-amber-500 text-white shadow-2xs cursor-pointer">
                            <i class="fa-solid fa-coins text-xs"></i>
                            <span>Chưa Thu Tiền</span>
                            <span class="px-1.5 py-0.2 bg-white/90 text-amber-900 rounded-md text-[11px] font-black"
                                  id="cho-thu-count">0</span>
                        </button>
                        <button type="button" id="tab-btn-khong-mua" onclick="switchThuTab('khong-mua')"
                                class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 hover:bg-slate-200/60 cursor-pointer">
                            <i class="fa-solid fa-ban text-xs"></i>
                            <span>Lịch Sử Không Mua</span>
                            <span class="px-1.5 py-0.2 bg-slate-200 text-slate-700 rounded-md text-[11px] font-black"
                                  id="khong-mua-count">0</span>
                        </button>
                    </div>
                    <button onclick="refreshThuTab()" title="Làm mới cột này"
                            class="text-slate-400 hover:text-slate-700 w-7 h-7 flex items-center justify-center rounded-lg hover:bg-slate-200 transition cursor-pointer">
                        <i class="fa-solid fa-rotate text-xs"></i>
                    </button>
                </div>

                <!-- Ô tìm kiếm trong cột -->
                <div class="px-3 py-1.5 border-b border-slate-100 bg-white shrink-0">
                    <div class="relative flex items-center">
                        <span class="absolute left-2.5 text-slate-400 text-xs">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="search-thu-input" oninput="filterThuList()"
                               class="w-full pl-7 pr-7 py-1.5 bg-slate-50 focus:bg-white border border-slate-200 focus:border-amber-400 rounded-lg text-xs font-semibold text-slate-800 focus:outline-none transition"
                               placeholder="Lọc theo tên, mã KB, số đơn...">
                        <button type="button" onclick="clearThuSearch()" id="clear-thu-search-btn"
                                class="hidden absolute right-2.5 text-slate-400 hover:text-slate-600 text-xs">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <!-- Danh sách Chưa Thu -->
                <div class="flex-grow overflow-y-auto p-3 space-y-2.5 min-h-0 bg-slate-50/40" id="cho-thu-list">
                    <div id="cho-thu-empty"
                         class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-16">
                        <i class="fa-solid fa-receipt text-3xl text-slate-300"></i>
                        <p class="text-xs font-semibold text-slate-400">Không có đơn nào chưa thu tiền</p>
                    </div>
                </div>

                <!-- Danh sách Không Mua -->
                <div class="hidden flex-grow overflow-y-auto p-3 space-y-2.5 min-h-0 bg-slate-50/40" id="khong-mua-list">
                    <div id="khong-mua-empty"
                         class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-16">
                        <i class="fa-solid fa-ban text-3xl text-slate-300"></i>
                        <p class="text-xs font-semibold text-slate-400">Chưa có đơn nào không mua hôm nay</p>
                    </div>
                </div>
            </section>

            <!-- ======================================================== -->
            <!-- CỘT 2: CHỜ PHÁT THUỐC & LỊCH SỬ ĐÃ PHÁT -->
            <!-- ======================================================== -->
            <section class="bg-white border border-slate-200 rounded-lg flex flex-col min-h-0 shadow-xs overflow-hidden">
                <!-- Header Tab Cột 2 -->
                <div
                    class="flex items-center justify-between border-b border-slate-200 px-3.5 py-2 shrink-0 bg-slate-50/70 gap-2">
                    <div class="flex items-center gap-1.5">
                        <button type="button" id="tab-btn-cho-giao" onclick="switchGiaoTab('cho-giao')"
                                class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-brand text-white shadow-2xs cursor-pointer">
                            <i class="fa-solid fa-box-open text-xs"></i>
                            <span>Chờ Phát Thuốc</span>
                            <span class="px-1.5 py-0.2 bg-white/90 text-brand rounded-md text-[11px] font-black"
                                  id="cho-giao-count">0</span>
                        </button>
                        <button type="button" id="tab-btn-da-giao" onclick="switchGiaoTab('da-giao')"
                                class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 hover:bg-slate-200/60 cursor-pointer">
                            <i class="fa-solid fa-clock-rotate-left text-xs"></i>
                            <span>Lịch Sử Đã Phát</span>
                            <span class="px-1.5 py-0.2 bg-slate-200 text-slate-700 rounded-md text-[11px] font-black"
                                  id="da-giao-count">0</span>
                        </button>
                    </div>
                    <button onclick="refreshGiaoTab()" title="Làm mới cột này"
                            class="text-slate-400 hover:text-slate-700 w-7 h-7 flex items-center justify-center rounded-lg hover:bg-slate-200 transition cursor-pointer">
                        <i class="fa-solid fa-rotate text-xs"></i>
                    </button>
                </div>

                <!-- Ô tìm kiếm trong cột -->
                <div class="px-3 py-1.5 border-b border-slate-100 bg-white shrink-0">
                    <div class="relative flex items-center">
                        <span class="absolute left-2.5 text-slate-400 text-xs">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="search-giao-input" oninput="filterGiaoList()"
                               class="w-full pl-7 pr-7 py-1.5 bg-slate-50 focus:bg-white border border-slate-200 focus:border-brand rounded-lg text-xs font-semibold text-slate-800 focus:outline-none transition"
                               placeholder="Lọc theo tên, mã KB, số đơn...">
                        <button type="button" onclick="clearGiaoSearch()" id="clear-giao-search-btn"
                                class="hidden absolute right-2.5 text-slate-400 hover:text-slate-600 text-xs">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <!-- Danh sách Chờ Phát -->
                <div class="flex-grow overflow-y-auto p-3 space-y-2.5 min-h-0 bg-slate-50/40" id="cho-giao-list">
                    <div id="cho-giao-empty"
                         class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-16">
                        <i class="fa-solid fa-clipboard-check text-3xl text-slate-300"></i>
                        <p class="text-xs font-semibold text-slate-400">Không có đơn nào đang chờ phát</p>
                    </div>
                </div>

                <!-- Danh sách Đã Phát -->
                <div class="hidden flex-grow overflow-y-auto p-3 space-y-2.5 min-h-0 bg-slate-50/40" id="da-giao-list">
                    <div id="da-giao-empty"
                         class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-16">
                        <i class="fa-solid fa-clock-rotate-left text-3xl text-slate-300"></i>
                        <p class="text-xs font-semibold text-slate-400">Chưa có đơn nào đã phát hôm nay</p>
                    </div>
                </div>
            </section>
        </main>

        <!-- ======================================================== -->
        <!-- TOAST THÔNG BÁO & NÚT HOÀN TÁC (GỌN GÀNG) -->
        <!-- ======================================================== -->
        <div id="undo-toast"
             class="fixed bottom-4 right-4 z-50 flex items-center gap-2.5 bg-slate-900/95 text-white px-3.5 py-2 rounded-lg shadow-lg border border-slate-700 backdrop-blur transition-all duration-200 opacity-0 translate-y-3 pointer-events-none text-xs">
            <i id="undo-toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-sm shrink-0"></i>
            <span id="undo-toast-msg" class="font-bold truncate max-w-xs">Thao tác thành công</span>
            <button id="undo-toast-btn" onclick="triggerToastUndo()" type="button"
                    class="hidden ml-1 px-2.5 py-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black rounded-lg shadow-xs transition active:scale-95 cursor-pointer whitespace-nowrap text-[11px]">
                <i class="fa-solid fa-rotate-left mr-0.5"></i> Hoàn tác
            </button>
        </div>

        <!-- ======================================================== -->
        <!-- LOGIC JAVASCRIPT -->
        <!-- ======================================================== -->
        <script>
                const $id = id => document.getElementById(id);
                const scanInput = $id('scan-input');

                let autoResetTimer = null;
                let autoTimer = null;
                let lastInputTime = 0;
                let isScanning = false;
                let currentScannedMakb = '';

                // Tab states
                let currentThuTab = 'cho-thu';   // 'cho-thu' | 'khong-mua'
                let currentGiaoTab = 'cho-giao'; // 'cho-giao' | 'da-giao'

                // Data caches
                let rawChuaGiaoData = [];
                let rawDaGiaoData = [];
                let rawKhongMuaData = [];

                // Highlight tracker
                let highlightedKey = '';
                let highlightTimer = null;

                // Undo Toast Tracker
                let lastActionData = null; // { makb, mabn, hoTen, actionType }
                let undoToastTimer = null;

    
                function updateTime() {
                    const now = new Date();
                    const dateEl = $id('date-str');
                    const timeEl = $id('time-str');
                    if (dateEl) dateEl.textContent = now.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit' });
                    if (timeEl) timeEl.textContent = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
                }
                setInterval(updateTime, 1000);
                updateTime();

                function fmtMoney(n) {
                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n || 0);
                }

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                }

                function getOcuaBadge(ocua) {
                    if (!ocua) return `<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-100 text-slate-400">Chưa gọi ô</span>`;
                    const val = String(ocua).trim();
                    let cls = 'bg-blue-50 text-blue-800 border-blue-200';
                    if (val === '2') cls = 'bg-emerald-50 text-emerald-800 border-emerald-200';
                    else if (val === '3') cls = 'bg-purple-50 text-purple-800 border-purple-200';
                    else if (val === '4') cls = 'bg-amber-50 text-amber-800 border-amber-200';
                    else if (val === '5') cls = 'bg-rose-50 text-rose-800 border-rose-200';
                    return `<span class="px-2 py-0.5 rounded-md text-[11px] font-black uppercase border ${cls}"><i class="fa-solid fa-door-open mr-0.5"></i> Ô ${escapeHtml(val)}</span>`;
                }

                let nhapAudioCtx = null;
                function getNhapAudioContext() {
                    if (!nhapAudioCtx) {
                        const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                        if (AudioCtxClass) nhapAudioCtx = new AudioCtxClass();
                    }
                    if (nhapAudioCtx && nhapAudioCtx.state === 'suspended') {
                        nhapAudioCtx.resume().catch(() => { });
                    }
                    return nhapAudioCtx;
                }

                function playScanBeep(isSuccess) {
                    try {
                        const ctx = getNhapAudioContext();
                        if (!ctx) return;
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        const now = ctx.currentTime;
                        if (isSuccess) {
                            osc.frequency.setValueAtTime(880, now);
                            gain.gain.setValueAtTime(0.2, now);
                            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.start(now);
                            osc.stop(now + 0.2);
                        } else {
                            osc.frequency.setValueAtTime(220, now);
                            gain.gain.setValueAtTime(0.25, now);
                            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.start(now);
                            osc.stop(now + 0.25);
                        }
                    } catch (e) { }
                }

                ['click', 'keydown', 'input', 'touchstart'].forEach(type => {
                    document.addEventListener(type, () => getNhapAudioContext(), { passive: true, once: true });
                });

                function triggerHighlight(key) {
                    if (!key) return;
                    highlightedKey = String(key).trim();
                    if (highlightTimer) clearTimeout(highlightTimer);
                    highlightTimer = setTimeout(() => {
                        highlightedKey = '';
                        renderChoThuList();
                        renderChoGiaoList();
                    }, 3500);
                }

                
                function showUndoToast(msg, actionPayload, isError = false) {
                    const toast = $id('undo-toast');
                    const msgEl = $id('undo-toast-msg');
                    const iconEl = $id('undo-toast-icon');
                    const btnEl = $id('undo-toast-btn');
                    if (!toast || !msgEl) return;

                    lastActionData = actionPayload;
                    msgEl.textContent = msg;

                    if (iconEl) {
                        iconEl.className = isError
                            ? 'fa-solid fa-circle-xmark text-rose-400 text-sm shrink-0'
                            : 'fa-solid fa-circle-check text-emerald-400 text-sm shrink-0';
                    }

                    if (btnEl) {
                        btnEl.classList.toggle('hidden', !actionPayload);
                    }

                    toast.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
                    toast.classList.add('opacity-100', 'translate-y-0');

                    if (undoToastTimer) clearTimeout(undoToastTimer);
                    undoToastTimer = setTimeout(() => {
                        toast.classList.remove('opacity-100', 'translate-y-0');
                        toast.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
                        lastActionData = null;
                    }, actionPayload ? 4500 : 2500);
                }

                async function triggerToastUndo() {
                    if (!lastActionData) return;
                    const { makb, mabn, hoTen, actionType } = lastActionData;

                    const toast = $id('undo-toast');
                    if (toast) {
                        toast.classList.remove('opacity-100', 'translate-y-0');
                        toast.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
                    }
                    lastActionData = null;

                    if (actionType === 'khong_mua') {
                        await actionHoanTacKhongMua(makb, mabn, hoTen);
                    } else {
                        await actionHoanTac(makb, mabn, hoTen);
                    }
                }

                function copyToClipboard(text, btnElement, event) {
                    if (event) {
                        event.stopPropagation();
                        event.preventDefault();
                    }
                    if (!text) return;
                    const str = String(text).trim();
                    if (!str) return;

                    const doFeedback = () => {
                        showUndoToast(`Đã sao chép: ${str}`, null);
                        if (btnElement) {
                            const icon = btnElement.querySelector('i');
                            if (icon) {
                                const oldClass = icon.className;
                                icon.className = 'fa-solid fa-check text-emerald-600';
                                setTimeout(() => { icon.className = oldClass; }, 1200);
                            }
                        }
                    };

                    if (navigator.clipboard && window.isSecureContext) {
                        navigator.clipboard.writeText(str).then(doFeedback).catch(() => fallbackCopy(str, doFeedback));
                    } else {
                        fallbackCopy(str, doFeedback);
                    }
                }

                function fallbackCopy(text, callback) {
                    try {
                        const textarea = document.createElement('textarea');
                        textarea.value = text;
                        textarea.style.position = 'fixed';
                        textarea.style.left = '-999999px';
                        textarea.style.top = '-999999px';
                        document.body.appendChild(textarea);
                        textarea.focus();
                        textarea.select();
                        document.execCommand('copy');
                        document.body.removeChild(textarea);
                        if (callback) callback();
                    } catch (e) {
                        showUndoToast(`Không thể sao chép: ${text}`, null, true);
                    }
                }

                function copyCurrentPatientMakb(btnEl, event) {
                    if (currentScannedMakb) copyToClipboard(currentScannedMakb, btnEl, event);
                }

                // ========================================================
                // QUẢN LÝ TRẠNG THÁI Ô NHẬP & THẺ BỆNH NHÂN
                // ========================================================
                function setScanState(type) {
                    const box = $id('scan-box');
                    const icon = $id('scan-icon');
                    if (box) {
                        box.className = 'relative flex items-center bg-slate-50 hover:bg-white focus-within:bg-white border-2 rounded-lg transition duration-150 shadow-2xs';
                    }
                    if (type === 'loading') {
                        if (box) box.classList.add('border-amber-400');
                        if (icon) icon.className = 'fa-solid fa-spinner fa-spin text-amber-500 text-base';
                    } else if (type === 'success') {
                        if (box) box.classList.add('border-emerald-500', 'bg-emerald-50/40');
                        if (icon) icon.className = 'fa-solid fa-circle-check text-emerald-600 text-base';
                    } else if (type === 'error') {
                        if (box) {
                            box.classList.add('border-rose-500', 'bg-rose-50/40');
                            box.animate([
                                { transform: 'translateX(-4px)' }, { transform: 'translateX(4px)' },
                                { transform: 'translateX(-3px)' }, { transform: 'translateX(3px)' },
                                { transform: 'translateX(0)' }
                            ], { duration: 300 });
                        }
                        if (icon) icon.className = 'fa-solid fa-circle-xmark text-rose-500 text-base';
                    } else {
                        if (box) box.classList.add('border-slate-300', 'focus-within:border-brand');
                        if (icon) icon.className = 'fa-solid fa-barcode text-slate-500 text-base';
                    }
                }

