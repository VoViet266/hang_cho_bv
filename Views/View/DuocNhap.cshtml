        function addThuocRow(t, idx) {
            const listEl = $id('thuoc-list');
            if (!listEl) return;
            const tien = Number(t.thanhtien ?? t.Thanhtien ?? t.tienVat ?? 0);
            const div = document.createElement('div');
            div.className = 'flex items-center justify-between p-2 bg-slate-50 border border-slate-200 rounded-xl overflow-hidden';
            div.innerHTML = `
                <div class="flex items-center gap-2 min-w-0">
                    <span class="w-6 h-6 rounded-md bg-brand text-white flex items-center justify-center font-black text-xs shrink-0">${idx + 1}</span>
                    <div class="min-w-0">
                        <div class="text-xs font-bold text-slate-700">Đơn thuốc ${idx + 1}</div>
                        <div class="text-[10px] text-slate-400 font-mono truncate">SHĐ: ${escapeHtml(t.sohd) || '—'} &bull; MBA: ${escapeHtml(t.maba) || '—'}</div>
                    </div>
                </div>
                <div class="text-xs md:text-sm font-black text-amber-700 tabular-nums shrink-0">${fmtMoney(tien)}</div>`;
