        function filterThuList() {
            const clearBtn = $id('clear-thu-search-btn');
            const query = ($id('search-thu-input')?.value || '').trim().toLowerCase();
            if (clearBtn) clearBtn.classList.toggle('hidden', !query);
            renderChoThuList();
        }

        function clearThuSearch() {
            const input = $id('search-thu-input');
            if (input) input.value = '';
            filterThuList();
            if (input) input.focus();
        }

        function renderChoThuList() {
            const container = $id('cho-thu-list');
            const countEl = $id('cho-thu-count');
            const query = ($id('search-thu-input')?.value || '').trim().toLowerCase();

            // Chưa thu = Đơn Dịch Vụ (!isBhyt) và chưa in hóa đơn (!daThu && trangThai !== 'Đang soạn thuốc thuốc') và dagiao === 0
            const choThuItems = rawChuaGiaoData.filter(item => {
                if (Number(item.dagiao) !== 0) return false;
                if (item.isBhyt) return false;
                return !item.daThu && item.trangThai !== 'Đang soạn thuốc thuốc';
            });
            if (countEl) countEl.textContent = choThuItems.length;
            if (!container) return;

            const filtered = query
                ? choThuItems.filter(i => (i.hoTen || '').toLowerCase().includes(query) || (i.makb || '').toLowerCase().includes(query) || (i.mabn || '').toLowerCase().includes(query))
                : choThuItems;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div id="cho-thu-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                        <i class="fa-solid fa-receipt text-3xl text-slate-300"></i>
                        <p class="text-xs font-bold text-slate-400">${query ? 'Không tìm thấy bệnh nhân phù hợp' : 'Không có đơn nào chưa thu tiền'}</p>
                    </div>`;
                return;
            }

            const prevScrollTop = container.scrollTop;
            let html = '';
            for (const item of filtered) {
                const curOcua = String(item.oCua || '').trim();
                const safeHoTen = escapeHtml(item.hoTen).replace(/'/g, "\\'");
                const safeTrangThai = 'Chờ thu';

                const assignBtns = ['1', '2', '3', '4'].map(num => {
                    const isCurrent = curOcua === num;
                    const activeCls = isCurrent
                        ? 'bg-amber-600 text-white font-black border-amber-600 ring-2 ring-amber-300 shadow-xs'
                        : 'bg-white text-slate-700 hover:bg-amber-50 hover:text-amber-800 hover:border-amber-300 border-slate-300';
                    return `<button type="button" onclick="actionGoiCua('${item.makb}', '${item.mabn}', '${safeHoTen}', '${escapeHtml(item.namSinh || '')}', '${num}', false, '${safeTrangThai}')"
                                class="px-2 py-1 text-xs rounded-lg border font-black transition cursor-pointer flex items-center gap-1 active:scale-95 ${activeCls}"
                                title="Chọn Ô ${num} & phát loa gọi ${escapeHtml(item.hoTen)} đến đóng tiền">${isCurrent ? '<i class="fa-solid fa-volume-high text-[11px] text-yellow-300"></i> ' : ''}Ô ${num}</button>`;
                }).join('');

                const isHighlighted = (item.makb && item.makb === highlightedKey) || (item.mabn && item.mabn === highlightedKey);
                const cardCls = isHighlighted
                    ? 'border-2 border-amber-500 bg-amber-50/80 ring-4 ring-amber-200 shadow-md animate-pulse'
                    : 'border-2 border-amber-200 hover:border-amber-300 bg-white shadow-xs';

                html += `
                    <div class="${cardCls} rounded-xl p-3 flex flex-col gap-2 transition overflow-hidden">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex-1 min-w-0">
                                <div class="font-black text-slate-900 text-sm md:text-base uppercase truncate leading-tight tracking-wide">
                                    ${escapeHtml(item.hoTen)}
                                </div>
                                <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                    <span class="px-2 py-0.5 bg-purple-100 text-purple-800 border border-purple-200 rounded font-black text-[10px] uppercase tracking-wide">Dịch Vụ</span>
                                    <span class="text-xs font-black text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 flex items-center gap-1">
                                        <i class="fa-solid fa-coins text-amber-500"></i> ${item.soTienStr || '—'}
                                    </span>
                                    <button type="button" onclick="copyToClipboard('${escapeHtml(item.makb || item.mabn)}', this, event)"
                                            title="Bấm để sao chép mã khám"
                                            class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-brand border border-slate-200 font-mono text-[10px] font-bold transition cursor-pointer active:scale-95">
                                        <span>MKB: ${escapeHtml(item.makb || item.mabn)}</span>
                                        <i class="fa-regular fa-copy text-[10px]"></i>
                                    </button>
                                    ${item.ngayNhapStr ? `<span class="text-[10px] text-slate-400 whitespace-nowrap"><i class="fa-regular fa-clock"></i> ${item.ngayNhapStr}</span>` : ''}
                                </div>
                            </div>
                            <div class="shrink-0">
                                ${getOcuaBadge(item.oCua)}
                            </div>
                        </div>
                        <div class="flex items-center justify-between border-t border-slate-100 pt-2 flex-wrap gap-1.5">
                            <span class="text-[11px] font-black text-slate-500 uppercase tracking-wider flex items-center gap-1">
                                <i class="fa-solid fa-bullhorn text-amber-600 text-xs"></i> Gọi loa:
                            </span>
                            <div class="flex items-center gap-1">
                                ${assignBtns}
                            </div>
                        </div>
                    </div>`;
            }

            container.innerHTML = html;
            container.scrollTop = prevScrollTop;
        }

        // ========================================================
        // QUẢN LÝ CỘT 3: GIAO THUỐC (CHỜ GIAO & LỊCH SỬ GIAO)
        // ========================================================
        function switchGiaoTab(tab) {
            currentGiaoTab = tab;
            const btnChoGiao = $id('tab-btn-cho-giao');
            const btnDaGiao = $id('tab-btn-da-giao');
            const listChoGiao = $id('cho-giao-list');
            const listDaGiao = $id('da-giao-list');

            if (tab === 'cho-giao') {
                if (btnChoGiao) btnChoGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-brand text-white shadow-xs cursor-pointer';
                if (btnDaGiao) btnDaGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer';
                if (listChoGiao) listChoGiao.classList.remove('hidden');
                if (listDaGiao) listDaGiao.classList.add('hidden');
                renderChoGiaoList();
            } else {
                if (btnDaGiao) btnDaGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 bg-emerald-600 text-white shadow-xs cursor-pointer';
                if (btnChoGiao) btnChoGiao.className = 'px-2.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition flex items-center gap-1.5 text-slate-600 hover:text-brand hover:bg-slate-100 cursor-pointer';
                if (listDaGiao) listDaGiao.classList.remove('hidden');
                if (listChoGiao) listChoGiao.classList.add('hidden');
                loadDanhSachDaGiao();
            }
        }

        function refreshGiaoTab() {
            loadDanhSachChuaGiao();
            if (currentGiaoTab === 'da-giao') loadDanhSachDaGiao();
        }

        function filterGiaoList() {
            const clearBtn = $id('clear-giao-search-btn');
            const query = ($id('search-giao-input')?.value || '').trim().toLowerCase();
            if (clearBtn) clearBtn.classList.toggle('hidden', !query);

            if (currentGiaoTab === 'cho-giao') renderChoGiaoList();
            else renderDaGiaoList();
        }

        function clearGiaoSearch() {
            const input = $id('search-giao-input');
            if (input) input.value = '';
            filterGiaoList();
            if (input) input.focus();
        }

        function renderChoGiaoList() {
            const container = $id('cho-giao-list');
            const countEl = $id('cho-giao-count');
            const query = ($id('search-giao-input')?.value || '').trim().toLowerCase();

            // Chờ phát = BHYT (isBhyt && dagiao === 0) HOẶC Dịch vụ đã in/thu (daThu || trangThai === 'Đang soạn thuốc thuốc')
            const choGiaoItems = rawChuaGiaoData.filter(item => {
                if (Number(item.dagiao) !== 0) return false;
                return item.isBhyt || item.daThu || item.trangThai === 'Đang soạn thuốc thuốc';
            });

            if (countEl) countEl.textContent = choGiaoItems.length;
            if (!container) return;

            const filtered = query
                ? choGiaoItems.filter(i => (i.hoTen || '').toLowerCase().includes(query) || (i.makb || '').toLowerCase().includes(query) || (i.mabn || '').toLowerCase().includes(query))
                : choGiaoItems;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div id="cho-giao-empty" class="h-full flex flex-col items-center justify-center text-slate-300 gap-2 py-12">
                        <i class="fa-solid fa-clipboard-check text-3xl text-slate-300"></i>
                        <p class="text-xs font-bold text-slate-400">${query ? 'Không tìm thấy bệnh nhân phù hợp' : 'Không có đơn nào đang chờ phát'}</p>
                    </div>`;
