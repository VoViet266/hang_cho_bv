@model HangChoKhamBenh.Web.Models.DuocIndexViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hàng Chờ Khoa Dược - Bệnh Viện Tâm Minh Đức</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#1e40af',
                            danger: '#dc2626',
                            accent: '#0f172a',
                        }
                    }
                }
            }
    </script>
</head>

<body class="bg-slate-100 text-slate-900 font-sans p-2 sm:p-4 flex flex-col h-screen overflow-hidden select-none">

    <!-- HEADER: MÀU CŨ & CẤU TRÚC CŨ -->
    <div class="flex items-center gap-4 bg-white p-3 border-2 border-slate-300 rounded-lg mb-3 shadow-sm shrink-0">
        <a href="/" title="Quay lại chọn dịch vụ (Esc)"
           class="remote-item flex items-center justify-center w-11 h-11 bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-brand rounded-lg border-2 border-slate-300 transition shrink-0 cursor-pointer"
           tabindex="0">
            <i class="fa-solid fa-arrow-left text-lg"></i>
        </a>

        <div class="flex-shrink-0 flex items-center justify-center w-[130px]">
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-16 w-auto object-contain">
        </div>

        <div class="flex-1 min-w-0 text-center font-black tabular-nums tracking-wider">
            <div id="date-str" class="text-base text-slate-500 font-bold mb-0.5 uppercase tracking-widest"></div>
            <div id="time-str" class="text-[2.2rem] sm:text-[3rem] text-danger leading-none font-black"></div>
        </div>

        <div class="hidden sm:flex flex-col items-end justify-center min-w-[220px] text-right">
            <div class="text-brand font-black text-xl md:text-2xl uppercase tracking-wider">
                KHOA DƯỢC
            </div>
            <div class="text-slate-500 text-xs font-bold mt-0.5">
                Bệnh Viện Đa Khoa Tâm Minh Đức
            </div>
        </div>
    </div>

    <!-- BODY: 2 NÚT (1 DANH SÁCH CHIẾU TV, 1 NHẬP HÀNG CHỜ) -->
    <div class="flex-grow flex flex-col justify-center max-w-4xl mx-auto w-full px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- 1. DANH SÁCH HÀNG CHỜ PHÁT THUỐC (MÀN HÌNH TV) -->
            <div class="remote-item bg-white border-2 border-slate-300 hover:border-brand rounded-lg cursor-pointer p-8 flex flex-col items-center justify-between text-center min-h-[250px] shadow-sm hover:shadow-md transition-all group"
                 tabindex="0" onclick="window.location.href='/duoc/danh-sach'">
                <div
                    class="w-20 h-20 rounded-lg bg-blue-50 border-2 border-blue-200 text-brand flex items-center justify-center text-4xl mb-4 group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-tv"></i>
                </div>
                <div>
                    <div class="text-brand font-black text-2xl sm:text-3xl uppercase tracking-wide">
                        Danh Sách Chờ
                    </div>
                    <div class="text-slate-500 text-xs sm:text-sm font-semibold mt-2 leading-relaxed">
                        Màn hình TV hiển thị danh sách bệnh nhân chờ cấp phát thuốc
                    </div>
                </div>
                <div
                    class="mt-5 px-6 py-2.5 bg-brand text-white font-black text-sm rounded-lg border border-blue-700 uppercase tracking-wider shadow-sm group-hover:bg-blue-800 transition-colors flex items-center gap-2">
                    <span>Mở màn hình TV</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </div>

            <!-- 2. NHẬP HÀNG CHỜ (QUÉT MÃ TIẾP NHẬN & GỌI Ô CỬA) -->
            <div class="remote-item bg-white border-2 border-slate-300 hover:border-blue-900 rounded-lg cursor-pointer p-8 flex flex-col items-center justify-between text-center min-h-[250px] shadow-sm hover:shadow-md transition-all group"
                 tabindex="0" onclick="window.location.href='/duoc/nhap'">
                <div
                    class="w-20 h-20 rounded-lg bg-blue-50 border-2 border-blue-200 text-blue-900 flex items-center justify-center text-4xl mb-4 group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-barcode"></i>
                </div>
                <div>
                    <div class="text-blue-900 font-black text-2xl sm:text-3xl uppercase tracking-wide">
                        Nhập Hàng Chờ
                    </div>
                    <div class="text-slate-500 text-xs sm:text-sm font-semibold mt-2 leading-relaxed">
                        Quét mã vạch tiếp nhận toa thuốc &amp; phát loa gọi theo ô cửa
                    </div>
                </div>
                <div
                    class="mt-5 px-6 py-2.5 bg-blue-900 text-white font-black text-sm rounded-lg border border-blue-950 uppercase tracking-wider shadow-sm group-hover:bg-blue-950 transition-colors flex items-center gap-2">
                    <span>Mở trang Nhập</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </div>

        </div>
    </div>

    <!-- FOOTER CHỈ DẪN -->
    <div
        class="py-2 px-4 text-center text-xs text-slate-500 bg-white border-t border-slate-200 shrink-0 flex justify-between items-center rounded-lg mt-1">
        <span>Chọn <strong>Danh Sách Chờ</strong> để mở màn hình TV hoặc <strong>Nhập Hàng Chờ</strong> để quét mã •
            Nhấn <strong>[Esc]</strong> để quay lại</span>
            <span>Phím <strong>[F11]</strong>: Toàn màn hình TV</span>
        </div>

        <script src="/js/remoteNav.js?v=@DateTime.UtcNow.Ticks"></script>
        <script>
                function updateTime() {
                    const now = new Date();
                    const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
                    const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
                    const dateStrEl = document.getElementById('date-str');
                    const timeStrEl = document.getElementById('time-str');

                    if (dateStrEl && timeStrEl) {
                        dateStrEl.textContent = now.toLocaleDateString('vi-VN', dateOpts);
                        timeStrEl.textContent = now.toLocaleTimeString('vi-VN', timeOpts);
                    }
                }
                setInterval(updateTime, 1000);
                updateTime();

                window.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' || e.key === 'Backspace') {
                        window.location.href = '/';
                    }
                });
        </script>
    </body>

</html>
