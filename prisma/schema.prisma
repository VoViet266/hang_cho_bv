generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = [ "current"]
}

model dmphong {
  maphong      String       @id
  tenphong     String?
  succhua      Decimal?
  sophong      Decimal?
  loaphat      Decimal?
  xoa          Decimal?
  loaiphong    String?
  thannhantao  Decimal?
  khoakb       Decimal?
  mack         String?
  stt          String?
  psdangky     psdangky[]
  khambenh     khambenh[]
  dmchuyenkhoa dmchuyenkhoa? @relation(fields: [mack], references: [mack])

  @@index([khoakb, xoa, maphong])
  @@index([tenphong])
  @@schema("current")
}

model psdangky {
  makb        String      @id
  mabn        String?
  tuoi        Int?
  ngaydk      DateTime?
  maphong     String?
  dmphong     dmphong?    @relation(fields: [maphong], references: [maphong])
  dmbenhnhan  dmbenhnhan? @relation(fields: [mabn], references: [mabn])

  @@index([ngaydk, maphong, mabn])
  @@index([maphong, ngaydk])
  @@schema("current")
}

model khambenh {
  makb        String      @id
  mabn        String?
  maphong     String?
  dakham      Decimal? ///0: Chua khám (default) 1: đã khám
  xoa         Decimal?
  dmphong     dmphong?    @relation(fields: [maphong], references: [maphong])
  dmbenhnhan  dmbenhnhan? @relation(fields: [mabn], references: [mabn])

  @@index([maphong, dakham, xoa])
  @@index([makb, maphong])
  @@schema("current")
}

model dmchuyenkhoa {
  mack String @id
  tenck String

  dmphong dmphong[]
  @@schema("current")
}

model dmbenhnhan {
  mabn       String       @id
  holot      String?
  ten        String?
  gioitinh   Decimal?
  ngaysinh   DateTime?    @db.Date
  xoa        Decimal?
  psdangky   psdangky[]
  khambenh   khambenh[]

  @@schema("current")
}
