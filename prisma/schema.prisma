generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = [ "current"]
}

model dmphong {
  maphong     String       @id
  tenphong    String?
  succhua     Decimal?
  sophong     Decimal?
  loaphat     Decimal?
  xoa         Decimal?
  loaiphong   String?
  thannhantao Decimal?
  khoakb      Decimal?
  mack        String?
  stt         String?
  psdangky    psdangky[]
  khambenh    khambenh[]
  dmchuyenkhoa dmchuyenkhoa? @relation(fields: [mack], references: [mack])

  @@schema("current")
}


model psdangky {
  makb       String      @id
  mabn       String?
  tuoi       Int?
  ngaydk     DateTime?
  maphong    String?
  dmphong    dmphong?    @relation(fields: [maphong], references: [maphong])
  dmbenhnhan dmbenhnhan? @relation(fields: [mabn], references: [mabn])

  @@schema("current")
}


