<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh Sách Hàng Chờ Chẩn Đoán Hình Ảnh - <%= room.tenphong || 'CDHA' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: '#1e40af',
                        danger: '#dc2626',
                        success: '#16a34a',
                        accent: '#0f172a',
                    }
                }
            }
        }
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="bg-slate-100 text-slate-900 font-sans flex flex-col h-screen overflow-hidden select-none">

    <!-- Top Bar Header -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center bg-white p-2 border-2 border-slate-300 shadow-sm gap-2 shrink-0">
        <!-- Logo & Đồng hồ -->
        <div class="flex items-center bg-white gap-3">
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-12 md:h-14 object-contain">
            <div class="tabular-nums">
                <div id="date-str" class="text-xs text-slate-500 font-bold uppercase tracking-widest leading-tight"></div>
                <div id="time-str" class="text-xl md:text-2xl font-black text-brand leading-none"></div>
            </div>
        </div>

        <!-- Tiêu đề (chỉ hiện khi xem 1 phòng) -->
        <div class="flex flex-col flex-1 text-center items-center justify-center">
            <% if (roomsData.length <= 1) { 
                let ten = (room && room.tenphong) ? room.tenphong : 'Khoa Chẩn Đoán Hình Ảnh';
                let words = ten.trim().split(/\s+/);
                let lastWord = words.pop();
            %>
            <h1 class="text-danger text-xl md:text-4xl font-extrabold uppercase tracking-wide">
                <%= words.join(' ').toUpperCase() %>
                <span class="inline-block border-4 border-current bg-red-600 text-white rounded-full px-3 py-0.5 ml-1 leading-none">
                    <%= lastWord.toUpperCase() %>
                </span>
            </h1>
            <% } %>
        </div>

        <!-- Controls & Counters -->
        <div class="flex items-center gap-2">
            <% if (roomsData.length === 1) { %>
            <div class="bg-red-50 px-3 py-1 text-center min-w-[90px] rounded border border-red-200">
                <span class="block text-danger font-bold text-[10px] uppercase tracking-wide">Đang chờ</span>
                <span id="totalWaiting" class="block text-danger font-black text-lg md:text-xl tabular-nums leading-none mt-0.5">
                    <%= room.totalWaiting %>
                </span>
            </div>
            <% } %>

            <!-- Nút Chia phòng -->
            <button onclick="toggleRoomModal(true)"
                class="remote-item bg-blue-50 hover:bg-brand hover:text-white text-brand border-2 border-blue-300 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer"
                tabindex="0"
                title="Chia màn hình phòng CDHA">
                <i class="fas fa-th-large"></i>
                <span class="hidden md:inline"><%= roomsData.length <= 1 ? 'Chia phòng' : 'Đổi phòng' %></span>
            </button>

            <!-- Nút bật âm thanh -->
            <button id="soundToggleBtn" onclick="toggleSound()"
                class="remote-item bg-slate-50 hover:bg-slate-100 border-2 border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all cursor-pointer"
                tabindex="0"
                title="Bật/Tắt âm thanh">
                <i id="soundIcon" class="fas fa-volume-mute text-slate-400"></i>
                <span id="soundText" class="hidden md:inline text-xs font-bold">Loa: Tắt</span>
            </button>

            <!-- Nút quay lại -->
            <a href="/cdha" class="remote-item bg-slate-50 hover:bg-red-50 hover:border-red-300 border-2 border-slate-300 text-slate-500 hover:text-danger px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition-colors inline-flex items-center gap-1" tabindex="0" title="Về danh sách CDHA">
                <i class="fas fa-arrow-left"></i>
                <span class="hidden md:inline">Quay lại</span>
            </a>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="flex-grow p-1.5 overflow-hidden flex flex-col">
        <% if (roomsData.length <= 1) { 
            const waitingList = room.waitingList || [];
            let nextPatientNameToRead = '';
        %>
        <!-- ================= CHẾ ĐỘ 1 PHÒNG CDHA ================= -->
        <div id="room-card-<%= room.tenphong %>" 
             class="room-container flex-grow overflow-y-auto bg-white border-2 border-slate-300 rounded-xl flex flex-col shadow-sm"
             data-room-type="cdha"
             data-room-id="<%= room.tenphong %>"
             data-room-name="<%= room.tenphong %>">
            
            <table class="w-full text-left border-collapse" style="table-layout: fixed;">
                <colgroup>
                    <col style="width: 10%;">
                    <col style="width: 40%;">
                    <col style="width: 15%;">
                    <col style="width: 20%;">
                    <col style="width: 15%;">
                </colgroup>
                <thead class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300 text-blue-900 uppercase font-extrabold text-2xl md:text-3xl">
                    <tr>
                        <th class="py-3 px-4 text-center">STT</th>
                        <th class="py-3 px-4">Họ và Tên</th>
                        <th class="py-3 px-4 text-center">Năm Sinh</th>
                        <th class="py-3 px-4 text-center">Ghi Chú</th>
                        <th class="py-3 px-4 text-center">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody id="patientTableBody" class="divide-y divide-slate-200">
                    <% if (waitingList.length === 0) { %>
                    <tr>
                        <td colspan="5" class="text-center py-16 text-slate-400 text-3xl font-bold italic">
                            Không có bệnh nhân chờ chẩn đoán hình ảnh.
                        </td>
                    </tr>
                    <% } else { 
                        let waitCounter = 0; 
                        waitingList.forEach(function(patient, index) { 
                            let timeStr = '';
                            if (patient.priorityLabel) {
                                timeStr = `<span class="inline-block bg-yellow-100 text-yellow-800 px-3 py-1 rounded-lg border border-yellow-300 font-extrabold uppercase shadow-sm text-lg md:text-xl">Ưu tiên: ${patient.priorityLabel}</span>`;
                            }
                            let isNear = false; 
                            if (patient.dakham == 0) { 
                                waitCounter++; 
                                if (waitCounter === 1) {
                                    isNear = true; 
                                    nextPatientNameToRead = `${patient.holot || ''} ${patient.ten || ''}`.trim(); 
                                } 
                            }
                            const currentPatientName = `${patient.holot || ''} ${patient.ten || ''}`.trim();
                            const dobYear = patient.dobStr && patient.dobStr !== 'Chưa cập nhật' ? patient.dobStr.split('/').pop() : '';
                    %>
                    <tr data-patient="<%= currentPatientName %>" data-patient-key="<%= (patient.makb || patient.mabn || currentPatientName + '_' + (patient.dobStr || '')).trim() %>" data-room="<%= room.tenphong || '' %>" onclick="onRowClick(this)"
                        class="remote-item transition-all cursor-pointer <%= isNear ? 'bg-red-50 hover:bg-red-100 border-l-8 border-red-500 shadow-md' : 'hover:bg-blue-50 border-b border-slate-200' %>" tabindex="0">
                        <td class="py-5 px-4 font-bold text-center text-blue-900 <%= isNear ? 'text-5xl md:text-7xl font-black text-danger' : 'text-4xl md:text-6xl font-bold' %>">
                            <%= index + 1 %>
                        </td>
                        <td class="py-5 px-4 text-blue-900 overflow-hidden <%= isNear ? 'text-5xl md:text-7xl font-black tracking-tight text-danger' : 'text-4xl md:text-6xl font-black' %>">
                            <div class="patient-name-container truncate">
                                <%= (currentPatientName || 'Chưa cập nhật').toUpperCase() %>
                            </div>
                        </td>
                        <td class="py-5 px-4 font-bold text-center text-blue-900 <%= isNear ? 'text-4xl md:text-6xl font-black text-danger' : 'text-3xl md:text-5xl' %>">
                            <%= dobYear %>
                        </td>
                        <td class="py-5 px-4 text-center text-blue-900">
                            <%- timeStr %>
                        </td>
                        <td class="py-5 px-4 text-center">
                            <% if (isNear) { %>
                            <span class="inline-block bg-red-600 text-white px-4 md:px-6 py-2 md:py-3 rounded-xl text-xl md:text-3xl font-black uppercase shadow-lg animate-pulse">
                                Tới Lượt Khám
                            </span>
                            <% } else { %>
                            <span class="inline-block bg-slate-100 text-slate-600 px-3 md:px-4 py-1.5 md:py-2 rounded-xl text-lg md:text-2xl font-bold border-2 border-slate-200 shadow-sm">
                                Chờ Lượt khám
                            </span>
                            <% } %>
                        </td>
                    </tr>
                    <% }); } %>
                </tbody>
            </table>

            <div id="speechData" 
                 data-room-type="cdha" 
                 data-room-id="<%= room.tenphong %>" 
                 data-patient="<%= nextPatientNameToRead %>" 
                 data-room="<%= room.tenphong %>"
                 style="display: none;"></div>
        </div>

        <% } else { 
            const isSplit2 = roomsData.length === 2;
            const gridClass = isSplit2 
                ? 'grid grid-cols-1 md:grid-cols-2 gap-2 h-full' 
                : 'grid grid-cols-2 grid-rows-2 gap-2 h-full';
        %>
        <!-- ================= CHẾ ĐỘ CHIA 2 HOẶC CHIA 4 CDHA ================= -->
        <div class="<%= gridClass %>">
            <% roomsData.forEach(function(rData, rIdx) { 
                const roomId = rData.tenphong;
                const roomTitle = rData.tenphong;
                const waitingList = rData.waitingList || [];
                let nextPatient = '';
            %>
            <div id="room-card-<%= roomId %>" 
                 class="room-container bg-white text-slate-900 rounded-xl shadow-sm border-2 border-slate-300 flex flex-col overflow-hidden h-full"
                 data-room-type="cdha"
                 data-room-id="<%= roomId %>"
                 data-room-name="<%= roomTitle %>">
                
                <!-- Header ô phòng -->
                <div class="bg-white px-3 py-1.5 flex justify-between items-center shrink-0 border-b-2 border-slate-300 gap-2">
                    <div class="flex items-center gap-1.5 min-w-0">
                        <h2 class="text-lg md:text-3xl font-black text-danger uppercase truncate tracking-wide">
                            <%= roomTitle %>
                        </h2>
                    </div>

                    <div class="flex items-center gap-1.5 text-xs md:text-sm shrink-0">
                        <div class="bg-red-50 border border-red-200 px-2 py-0.5 rounded text-center">
                            <span class="text-danger font-bold text-[10px] uppercase">Đang chờ:</span>
                            <span id="total-wait-<%= roomId %>" class="text-danger font-black text-sm md:text-base tabular-nums"><%= rData.totalWaiting %></span>
                        </div>
                    </div>
                </div>

                <!-- Bảng ô phòng -->
                <div class="flex-grow overflow-y-auto no-scrollbar bg-white">
                    <table class="w-full text-left border-collapse" style="table-layout: fixed;">
                        <colgroup>
                            <col style="width: 8%;">
                            <col style="width: 56%;">
                            <col style="width: 13%;">
                            <col style="width: 23%;">
                        </colgroup>
                        <thead class="sticky top-0 bg-slate-200 text-blue-900 font-extrabold border-b-2 border-slate-300 shadow-sm z-10 text-sm md:text-xl uppercase">
                            <tr>
                                <th class="py-1.5 px-2 text-center">STT</th>
                                <th class="py-1.5 px-2">Họ và Tên</th>
                                <th class="py-1.5 px-2 text-center">Năm</th>
                                <th class="py-1.5 px-2 text-center">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-<%= roomId %>" class="divide-y divide-slate-200">
                            <% if (waitingList.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center py-8 text-slate-400 font-bold text-base md:text-2xl italic">
                                    Không có bệnh nhân chờ.
                                </td>
                            </tr>
                            <% } else { 
                                let waitCount = 0;
                                waitingList.forEach(function(p, pIdx) {
                                    let isNear = false;
                                    if (p.dakham == 0) {
                                        waitCount++;
                                        if (waitCount === 1) {
                                            isNear = true;
                                            nextPatient = `${p.holot || ''} ${p.ten || ''}`.trim();
                                        }
                                    }
                                    const pName = `${p.holot || ''} ${p.ten || ''}`.trim();
                                    const pYear = p.dobStr && p.dobStr !== 'Chưa cập nhật' ? p.dobStr.split('/').pop() : '';
                                    
                                    let noteTag = '';
                                    if (p.priorityLabel) {
                                        noteTag = `<span class="inline-block bg-yellow-100 text-yellow-800 text-xs md:text-sm px-1.5 py-0.5 rounded font-extrabold border border-yellow-300 ml-1">Ưu tiên: ${p.priorityLabel}</span>`;
                                    }
                            %>
                            <tr data-patient="<%= pName %>" data-patient-key="<%= (p.makb || p.mabn || pName + '_' + (p.dobStr || '')).trim() %>" data-room="<%= roomTitle %>" onclick="onRowClick(this)" 
                                class="remote-item cursor-pointer transition-all <%= isNear ? 'bg-red-50 hover:bg-red-100 border-l-8 border-red-500 shadow-md font-black' : 'hover:bg-blue-50 border-b border-slate-200' %>" tabindex="0">
                                <td class="py-2.5 px-2 text-center font-bold text-blue-900 <%= isNear ? 'text-danger text-2xl md:text-4xl lg:text-5xl font-black' : 'text-xl md:text-3xl font-bold' %>">
                                    <%= pIdx + 1 %>
                                </td>
                                <td class="py-2.5 px-2 text-blue-900 <%= isNear ? 'text-danger text-2xl md:text-4xl lg:text-5xl font-black tracking-tight' : 'text-xl md:text-3xl lg:text-4xl font-extrabold' %>">
                                    <div class="patient-name-container flex items-center overflow-hidden">
                                        <span class="patient-name-text truncate">
                                            <%= (pName || 'Chưa cập nhật').toUpperCase() %>
                                        </span>
                                        <%- noteTag %>
                                    </div>
                                </td>
                                <td class="py-2.5 px-2 text-center font-bold text-blue-900 <%= isNear ? 'text-danger text-xl md:text-3xl lg:text-4xl font-black' : 'text-lg md:text-2xl font-bold' %>">
                                    <%= pYear %>
                                </td>
                                <td class="py-2.5 px-2 text-center">
                                    <% if (isNear) { %>
                                    <span class="inline-block bg-red-600 text-white px-2.5 md:px-4 py-1 rounded-xl text-sm md:text-xl font-black uppercase shadow-lg animate-pulse">
                                        Tới Lượt
                                    </span>
                                    <% } else { %>
                                    <span class="inline-block bg-slate-100 text-slate-600 px-2 py-0.5 rounded-lg text-xs md:text-base font-bold border border-slate-300 shadow-sm">
                                        Chờ khám
                                    </span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); } %>
                        </tbody>
                    </table>
                </div>

                <div id="speech-track-<%= roomId %>" 
                     data-patient="<%= nextPatient %>" 
                     data-room="<%= roomTitle %>" 
                     style="display:none;"></div>
            </div>
            <% }); %>
        </div>
        <% } %>
    </main>

    <!-- Modal Cấu Hình Chia Phòng CDHA -->
    <div id="roomModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white border-2 border-slate-300 rounded-2xl w-full max-w-2xl p-5 text-slate-900 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center pb-3 border-b-2 border-slate-200">
                <h3 class="text-lg md:text-xl font-black text-brand flex items-center gap-2 uppercase">
                    <i class="fas fa-th-large text-danger"></i> Cấu hình phòng CDHA hiển thị trên TV
                </h3>
                <button onclick="toggleRoomModal(false)" class="text-slate-400 hover:text-danger text-2xl font-bold cursor-pointer transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="my-3 flex-grow overflow-hidden flex flex-col">
                <p class="text-xs md:text-sm text-slate-600 mb-2 font-medium">
                    Tích chọn <strong>1 phòng</strong> (toàn màn hình), <strong>2 phòng</strong> (chia đôi) hoặc <strong>4 phòng</strong> (chia 4):
                </p>

                <div class="flex justify-between items-center mb-3 shrink-0">
                    <span class="text-xs text-slate-500 font-semibold">Danh sách các phòng CDHA:</span>
                    <button type="button" onclick="clearRoomSelection()" class="remote-item bg-red-50 hover:bg-red-100 text-danger text-xs font-bold px-3 py-1.5 rounded-lg border border-red-200 transition-colors" tabindex="0">
                        <i class="fas fa-trash-alt mr-1"></i> Bỏ chọn hết
                    </button>
                </div>

                <!-- Checkbox list -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 overflow-y-auto p-2 bg-slate-50 rounded-xl border-2 border-slate-200 flex-grow">
                    <% allAvailableRooms.forEach(function(r) { 
                        const isChecked = selectedRoomIds.includes(r.id);
                    %>
                    <label class="remote-item flex items-center gap-2 p-2 bg-white hover:bg-blue-50 rounded-lg cursor-pointer transition-colors border border-slate-300 shadow-2xs" tabindex="0">
                        <input type="checkbox" name="roomSelection" value="<%= r.id %>" <%= isChecked ? 'checked' : '' %>
                               class="w-4 h-4 rounded text-brand focus:ring-brand cursor-pointer pointer-events-none">
                        <span class="text-xs md:text-sm font-bold text-slate-800 truncate"><%= r.name %></span>
                    </label>
                    <% }); %>
                </div>
            </div>

            <div class="flex justify-between items-center pt-3 border-t-2 border-slate-200 shrink-0">
                <span id="selectedCountText" class="text-xs md:text-sm text-brand font-black">
                    Đã chọn: <%= selectedRoomIds.length %> phòng
                </span>
                <div class="flex gap-2">
                    <button onclick="toggleRoomModal(false)" class="remote-item px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs md:text-sm border border-slate-300 transition-colors cursor-pointer" tabindex="0">
                        Hủy
                    </button>
                    <button onclick="applyRoomSelection('/cdha/room')" class="remote-item px-5 py-2 bg-brand hover:bg-blue-800 text-white rounded-xl font-black text-xs md:text-sm shadow-md transition-colors cursor-pointer" tabindex="0">
                        Áp Dụng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Tác Vụ Bệnh Nhân (Gọi đọc tên hoặc Bỏ qua/Đôn lên) -->
    <div id="patientActionModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white border-2 border-slate-300 rounded-2xl w-full max-w-lg p-5 text-slate-900 shadow-2xl flex flex-col gap-4">
            <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                <div>
                    <span id="modalPatientRoom" class="text-xs font-bold text-slate-500 uppercase tracking-wide block">Phòng CDHA</span>
                    <h3 id="modalPatientName" class="text-xl md:text-2xl font-black text-danger uppercase truncate max-w-sm">Bệnh nhân</h3>
                </div>
                <button onclick="closePatientActionModal()" class="text-slate-400 hover:text-danger text-2xl font-bold cursor-pointer transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="flex flex-col gap-3 py-2">
                <!-- Nút gọi đọc tên -->
                <button id="btnActionSpeak" onclick="triggerModalSpeak()" class="remote-item flex items-center gap-3 p-4 bg-blue-50 hover:bg-blue-600 text-blue-900 hover:text-white rounded-xl border-2 border-blue-200 transition-all font-black text-base md:text-xl cursor-pointer" tabindex="0">
                    <i class="fas fa-volume-up text-2xl"></i>
                    <span>Gọi / Đọc lại tên bệnh nhân</span>
                </button>

                <!-- Nút Bỏ qua & Đôn người khác lên -->
                <button id="btnActionSkip" onclick="triggerModalSkip()" class="remote-item flex items-center gap-3 p-4 bg-red-50 hover:bg-red-600 text-danger hover:text-white rounded-xl border-2 border-red-200 transition-all font-black text-base md:text-xl cursor-pointer" tabindex="0">
                    <i class="fas fa-forward text-2xl"></i>
                    <span>Bỏ qua & Đôn người kế tiếp lên</span>
                </button>

                <!-- Nút Đóng -->
                <button onclick="closePatientActionModal()" class="remote-item p-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl border border-slate-300 transition-colors font-bold text-sm md:text-base text-center cursor-pointer" tabindex="0">
                    Đóng
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/remoteNav.js"></script>
    <script src="/js/displayBoard.js"></script>
</body>

</html>