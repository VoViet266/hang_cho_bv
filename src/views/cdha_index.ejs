<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách phòng Chẩn Đoán Hình Ảnh</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/logo_tam-minh-duc.png" type="image/png">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: '#1e40af', 
                        danger: '#dc2626',
                        accent: '#0f172a',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-slate-100 text-slate-900 font-sans p-2 flex flex-col h-screen overflow-hidden">

    <!-- HEADER -->
    <div class="flex items-center gap-4 bg-white p-3 border-2 border-slate-300 rounded-lg mb-3 shadow-sm shrink-0">
        <div class="flex-shrink-0 flex items-center justify-center w-[140px]">
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-25 w-auto object-contain">
        </div>
        
        <div class="flex-1 min-w-0 text-center text-danger font-black tabular-nums tracking-wider">
            <div id="date-str" class="text-lg sm:text-xl text-slate-500 font-bold mb-1 uppercase tracking-widest"></div>
            <div id="time-str" class="text-[2.2rem] sm:text-[3rem] md:text-[3.5rem] leading-none"></div>
            <div class="text-xl text-brand font-bold mt-1">KHOA CHẨN ĐOÁN HÌNH ẢNH</div>
        </div>
        
        <div class="flex flex-col gap-2 min-w-[250px]">
            <div class="bg-white border-2 gap-3 border-red-300 px-3 py-2 rounded-lg text-danger text-lg font-extrabold flex justify-between items-center">
                <span>TỔNG ĐANG CHỜ:</span>
                <span id="cdha_tong_cho_kham" class="text-2xl tabular-nums"><%= data.overview.tong_cho_kham %></span>
            </div>
            <a href="/" class="bg-slate-200 border-2 gap-3 border-slate-300 px-3 py-2 rounded-lg text-slate-700 hover:text-brand hover:border-brand text-center font-bold text-lg transition-colors inline-block mt-1">
                <i class="fas fa-home mr-1"></i> Trở về phòng khám
            </a>
        </div>
    </div>

    <!-- BODY -->
    <div class="flex-grow overflow-y-auto p-1">
        <div id="cdhaGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 h-max">
            <% if (data.rooms.length === 0) { %>
                <div class="col-span-full text-center text-slate-500 text-2xl font-bold p-10">
                    Không có phòng CDHA nào đang hoạt động.
                </div>
            <% } else { %>
                <% data.rooms.forEach(function(r) { 
                    const targetUrl = '/' + (r.alias || ('cdha/room/' + encodeURIComponent(r.tenphong)));
                %>
                <div class="remote-item bg-white border-2 border-slate-300 rounded-xl shadow-sm hover:border-brand hover:bg-slate-50 hover:shadow-md transition-all cursor-pointer flex flex-col justify-center items-center p-4 min-h-[120px] gap-2" 
                     tabindex="0"
                     onclick="window.location.href='<%= targetUrl %>'">
                    <div class="text-brand font-bold text-xl md:text-2xl text-center truncate w-full px-1">
                        <%= r.tenphong || 'Chưa cập nhật' %>
                    </div>
                    <div class="bg-red-50 text-danger font-bold px-3 py-1 rounded-full border border-red-200">
                        Chờ: <%= r.tong_cho_kham %>
                    </div>
                </div>
                <% }); %>
            <% } %>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/remoteNav.js"></script>
    <script>
        function updateTime() {
            const now = new Date();
            const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
            const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
            const dateStrEl = document.getElementById('date-str');
            const timeStrEl = document.getElementById('time-str');

            if (dateStrEl && timeStrEl) {
                dateStrEl.textContent = now.toLocaleDateString('en-GB', dateOpts);
                timeStrEl.textContent = now.toLocaleTimeString('en-GB', timeOpts);
            }
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Socket.IO Real-time cho CDHA Dashboard
        if (typeof io !== "undefined") {
            const socket = io();
            socket.on("connect", () => {
                socket.emit("join_room", { roomType: "cdha_dashboard", roomId: "" });
            });

            socket.on("room_data_updated", (payload) => {
                if (!payload || !payload.data) return;
                const d = payload.data;
                if (d.overview) {
                    const ckEl = document.getElementById("cdha_tong_cho_kham");
                    if (ckEl) ckEl.textContent = d.overview.tong_cho_kham;
                }
            });
        }
    </script>
</body>

</html>
