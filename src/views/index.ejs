<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Số lượng chờ</title>
    <meta http-equiv="refresh" content="60">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: '#1e40af', 
                        danger: '#dc2626',
                        accent: '#0f172a',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-slate-100 text-slate-900 font-sans p-2 flex flex-col h-screen overflow-hidden">

    <!-- HEADER (Giữ nguyên cấu trúc, thu gọn padding một chút để ưu tiên không gian cho cụm) -->
    <div class="flex items-center gap-4 bg-white p-3 border-2 border-slate-300 rounded-lg mb-3 shadow-sm shrink-0">
        <div class="flex-shrink-0 flex items-center justify-center w-[140px]">
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-20 w-auto object-contain">
        </div>
        
        <div class="flex-1 min-w-0 text-center text-danger font-black tabular-nums tracking-wider">
            <div id="date-str" class="text-lg sm:text-xl text-slate-500 font-bold mb-1 uppercase tracking-widest"></div>
            <div id="time-str" class="text-[2.2rem] sm:text-[3rem] md:text-[3.5rem] leading-none"></div>
        </div>
        
        <div class="flex flex-col gap-2 min-w-[250px]">
            <div class="bg-white gap-3 border-2 border-blue-300 px-3 py-2 rounded-lg text-brand text-lg font-extrabold flex justify-between items-center">
                <span>TỔNG ĐĂNG KÝ:</span>
                <span class="text-2xl tabular-nums"><%= data.overview.tong_dangky %></span>
            </div>
            <div class="bg-white border-2 gap-3 border-red-300 px-3 py-2 rounded-lg text-danger text-lg font-extrabold flex justify-between items-center">
                <span>TỔNG CHỜ KHÁM:</span>
                <span class="text-2xl tabular-nums"><%= data.overview.tong_cho_kham %></span>
            </div>
        </div>
    </div>

    <!-- BODY: CHUYỂN TỪ TABLE SANG GRID (CÁC CỤM CARD) -->
    <div class="flex-grow overflow-y-auto p-1">
        <!-- Tự động chia cột: 2 cột (mobile), 3 cột (tablet), 4-5 cột (màn hình lớn) -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 h-max">
            
            <% data.rooms.forEach(function(r) { %>
            <div class="bg-white border-2 border-slate-300 rounded-xl shadow-sm hover:border-brand hover:shadow-md transition-all cursor-pointer flex flex-col overflow-hidden" 
                 onclick="window.location.href='/room/<%= r.maphong %>'">
                
                <!-- Tên phòng -->
                <div class="bg-slate-200 text-brand font-bold text-xl md:text-2xl text-center py-2 border-b-2 border-slate-300 truncate px-2">
                    <%= r.tenphong || r.maphong %>
                </div>
                
                <!-- Thông số -->
                <div class="p-3 grid grid-cols-2 gap-2">
                    <!-- Thông số ĐK -->
                    <div class="bg-slate-100 rounded flex flex-col items-center justify-center p-1 border border-slate-200">
                        <span class="text-slate-500 font-bold text-xs uppercase">ĐK</span>
                        <span class="font-bold text-slate-700 text-xl tabular-nums"><%= r.tong_dangky %></span>
                    </div>
                    
                    <!-- Thông số ĐK+ -->
                    <div class="bg-slate-100 rounded flex flex-col items-center justify-center p-1 border border-slate-200">
                        <span class="text-slate-500 font-bold text-xs uppercase">ĐK+</span>
                        <span class="font-bold text-slate-700 text-xl tabular-nums"><%= r.tong_chuyen_sang %></span>
                    </div>
                    
                    <!-- Thông số Đang chờ (Nhấn mạnh) -->
                    <div class="col-span-2 bg-red-50 border-2 border-red-200 rounded p-2 flex justify-between items-center mt-1">
                        <span class="text-danger font-bold text-sm uppercase">Đang Chờ</span>
                        <span class="text-3xl font-black text-danger tabular-nums"><%= r.tong_cho_kham %></span>
                    </div>
                </div>
            </div>
            <% }); %>

        </div>
    </div>

    <script>
        function updateTime() {
            const now = new Date();
            const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
            const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
            const dateStrEl = document.getElementById('date-str');
            const timeStrEl = document.getElementById('time-str');

            if (dateStrEl && timeStrEl) {
                dateStrEl.textContent = now.toLocaleDateString('en-GB', dateOpts);
                timeStrEl.textContent = now.toLocaleTimeString('en-GB', timeOpts);
            }
        }
        setInterval(updateTime, 1000);
        updateTime();
    </script>
</body>

</html>