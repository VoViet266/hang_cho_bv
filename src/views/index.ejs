<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Số lượng chờ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: '#1e40af',
                        danger: '#dc2626',
                        accent: '#0f172a',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-slate-100 text-slate-900 font-sans p-2 flex flex-col h-screen overflow-hidden">

    <!-- HEADER -->
    <div class="flex items-center gap-4 bg-white p-3 border-2 border-slate-300 rounded-lg mb-3 shadow-sm shrink-0">
        <div class="flex-shrink-0 flex items-center justify-center w-[140px]">
            <img src="/logo_tam-minh-duc.png" alt="Logo" class="h-25 w-auto object-contain">
        </div>

        <div class="flex-1 min-w-0 text-center text-danger font-black tabular-nums tracking-wider">
            <div id="date-str" class="text-lg sm:text-xl text-slate-500 font-bold mb-1 uppercase tracking-widest"></div>
            <div id="time-str" class="text-[2.2rem] sm:text-[3rem] md:text-[3.5rem] leading-none"></div>
        </div>

        <div class="flex flex-col gap-2 min-w-[250px]">
            <div
                class="bg-white gap-3 border-2 border-blue-300 px-3 py-2 rounded-lg text-brand text-lg font-extrabold flex justify-between items-center">
                <span>TỔNG ĐĂNG KÝ:</span>
                <span id="dashboard_tong_dangky" class="text-2xl tabular-nums">
                    <%= data.overview.tong_dangky %>
                </span>
            </div>
            <div
                class="bg-white border-2 gap-3 border-red-300 px-3 py-2 rounded-lg text-danger text-lg font-extrabold flex justify-between items-center">
                <span>TỔNG CHỜ KHÁM:</span>
                <span id="dashboard_tong_cho_kham" class="text-2xl tabular-nums">
                    <%= data.overview.tong_cho_kham %>
                </span>
            </div>
        </div>
    </div>

    <!-- BODY: CÁC CỤM CARD -->
    <div class="flex-grow overflow-y-auto p-1">
        <div id="roomGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2 h-max">
            <div class="remote-item bg-slate-200 border-2 border-slate-300 rounded-xl shadow-sm hover:border-brand hover:bg-slate-50 hover:shadow-md transition-all cursor-pointer flex flex-col justify-center items-center p-1 min-h-[70px]"
                tabindex="0"
                onclick="window.location.href='/cdha'">
                <div class="text-brand font-bold text-xl md:text-2xl text-center truncate w-full px-1">
                    Chẩn đoán hình ảnh
                </div>
            </div>
            <% data.rooms.forEach(function(r) { %>
                <div class="remote-item bg-white border-2 border-slate-300 rounded-xl shadow-sm hover:border-brand hover:bg-slate-50 hover:shadow-md transition-all cursor-pointer flex flex-col justify-center items-center p-1 min-h-[70px]"
                    tabindex="0"
                    onclick="window.location.href='/room/<%= r.maphong %>'">
                    <div class="text-brand font-bold text-xl md:text-2xl text-center truncate w-full px-1">
                        <%= r.tenphong || r.maphong %>
                    </div>
                </div>
                <% }); %>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/remoteNav.js"></script>
    <script>
        function updateTime() {
            const now = new Date();
            const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
            const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
            const dateStrEl = document.getElementById('date-str');
            const timeStrEl = document.getElementById('time-str');

            if (dateStrEl && timeStrEl) {
                dateStrEl.textContent = now.toLocaleDateString('en-GB', dateOpts);
                timeStrEl.textContent = now.toLocaleTimeString('en-GB', timeOpts);
            }
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Socket.IO Real-time cho Dashboard
        if (typeof io !== "undefined") {
            const socket = io();
            socket.on("connect", () => {
                socket.emit("join_room", { roomType: "dashboard", roomId: "" });
            });

            socket.on("room_data_updated", (payload) => {
                if (!payload || !payload.data) return;
                const d = payload.data;
                if (d.overview) {
                    const dkEl = document.getElementById("dashboard_tong_dangky");
                    const ckEl = document.getElementById("dashboard_tong_cho_kham");
                    if (dkEl) dkEl.textContent = d.overview.tong_dangky;
                    if (ckEl) ckEl.textContent = d.overview.tong_cho_kham;
                }
            });
        }
    </script>
</body>

</html>