<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi Tiết Phòng Khám - <%= room.tenphong || room.maphong %></title>
    <meta http-equiv="refresh" content="10">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: '#1e40af',
                        danger: '#dc2626',
                        success: '#16a34a',
                        accent: '#0f172a',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-100 text-slate-900 font-sans px-2 flex flex-col h-screen overflow-hidden">
    <!-- Top Bar -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-white p-2 border-2 border-slate-300 rounded-lg mb-4 shadow-sm gap-4 md:gap-0">
        <div class="flex flex-col">
            <div class="text-brand text-3xl md:text-4xl font-extrabold uppercase tracking-wide mb-1">
             <%= room.tenphong || room.maphong %>
            </div>
            <a href="/" class="text-slate-500 font-semibold text-base hover:text-brand transition-colors inline-block">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách phòng
            </a>
        </div>
        <!-- Đồng hồ -->
            <div class="flex justify-center items-center bg-white  mb-4 ">
        <div class="text-center text-danger font-black tabular-nums tracking-wider">
            <div id="date-str" class="text-2xl text-slate-500 font-bold mb-2 uppercase tracking-widest"></div>
            <div id="time-str" class="text-[4rem] leading-none"></div>
        </div>
    </div>
        <div class="flex gap-4">
            <div class="bg-white px-5 py-3  text-center min-w-[140px] shadow-sm">
                <span class="block text-brand font-bold text-base mb-1 uppercase tracking-wide">Tổng Đăng Ký</span>
                <span class="block text-brand font-black text-3xl tabular-nums"><%= room.totalRegistered %></span>
            </div>
       
            <div class="bg-white px-5 py-3  text-center min-w-[140px] shadow-sm">
                <span class="block text-danger font-bold text-base mb-1 uppercase tracking-wide">Đang chờ</span>
                <span class="block text-danger font-black text-3xl tabular-nums"><%= room.totalWaiting %></span>
            </div>
        </div>
    </div>

    <!-- Table Container -->
    <div class="flex-grow overflow-y-auto bg-white border-2 border-slate-300 rounded-lg">
        <table class="w-full text-left border-collapse">
            <thead class="sticky top-0 bg-slate-200 z-10 border-b-2 border-slate-300">
                <tr>
                    <th class="py-4 px-6 font-bold text-2xl text-center text-slate-700">STT</th>
                    <th class="py-4 px-6 font-bold text-2xl text-center text-slate-700">Mã BN</th>
                    <th class="py-4 px-6 font-bold text-2xl text-center text-slate-700">Họ và Tên</th>
                    <th class="py-4 px-6 font-bold text-2xl text-center text-slate-700">Giới tính</th>
                    <th class="py-4 px-6 font-bold text-2xl text-center text-slate-700">Ngày Sinh</th>
                    <th class="py-4 px-6 font-bold text-2xl text-center text-slate-700">Giờ Đăng Ký</th>
                    <th class="py-4 px-6 font-bold text-2xl  text-slate-700 text-center">Trạng Thái</th>
                </tr>
            </thead>
            <tbody class="divide-y-1 divide-slate-200">
                <% 
                const allPatients = [...room.waitingList];
                allPatients.sort((a, b) => new Date(a.ngaydk) - new Date(b.ngaydk));

                if (allPatients.length === 0) { 
                %>
                    <tr><td colspan="7" class="text-center p-10 text-slate-500 text-xl font-medium">Phòng trống, không có bệnh nhân.</td></tr>
                <% } else { 
                    let waitCounter = 0; 
                    
                    allPatients.forEach(function(patient, index) { 
                        let gender = (patient.gioitinh == 1) ? 'Nam' : ((patient.gioitinh == 2 || patient.gioitinh == 0) ? 'Nữ' : 'Khác');
                        
                        let dobStr = patient.ngaysinh ? patient.ngaysinh : 'Chưa cập nhật';
                        if (patient.ngaysinh instanceof Date) {
                            dobStr = patient.ngaysinh.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
                        } else if (typeof patient.ngaysinh === 'string' && patient.ngaysinh.includes('-')) {
                            const d = new Date(patient.ngaysinh);
                            if (!isNaN(d.getTime())) {
                                dobStr = d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
                            }
                        }

                        const dateObj = new Date(patient.ngaydk);
                        const timeStr = dateObj.toLocaleString('vi-VN', {
                            day: '2-digit', month: '2-digit', year: 'numeric',
                            hour: '2-digit', minute: '2-digit', hour12: false
                        });

                        let isNear = false;
                        if (patient.dakham == 0) {
                            waitCounter++;
                            if (waitCounter === 1) {
                                isNear = true;
                            }
                        }
                %>
                    <tr class="transition-colors <%= isNear ? 'bg-red-50 hover:bg-red-100 text-danger font-bold' : 'hover:bg-blue-50 cursor-pointer font-medium' %>">
                        <td class="py-4 px-6 text-xl text-center"><%= index + 1 %></td>
                        <td class="py-4 px-6 text-2xl text-center"><%= patient.mabn || patient.makb %></td>
                        <td class="py-4 px-6 <%= isNear ? 'text-3xl' : 'text-2xl font-bold text-slate-900' %>"><%= `${patient.holot || ''} ${patient.ten || ''}`.trim().toUpperCase() || 'Chưa cập nhật' %></td>
                        <td class="py-4 px-6 text-2xl text-center"><%= gender %></td>
                        <td class="py-4 px-6 text-2xl text-center"><%= dobStr %></td>
                        <td class="py-4 px-6 text-2xl text-center"><%= timeStr %></td>
                        <td class="py-4 px-6 text-center">
                            <% if (isNear) { %>
                                <span class="inline-block bg-red-100 text-danger px-4 py-2 rounded-full text-xl font-extrabold uppercase border border-red-300 shadow-sm animate-pulse">Sắp tới lượt khám</span>
                            <% } else { %>
                                <span class="inline-block bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-lg font-semibold border border-slate-200">Đang chờ</span>
                            <% } %>
                        </td>
                    </tr>
                <%  }); 
                } %>
            </tbody>
        </table>
    </div>

    <script>
        setTimeout(() => {
            window.location.reload();
        }, 30000);

        function updateTime() {
            const now = new Date();
            const dateOpts = { day: '2-digit', month: '2-digit', year: 'numeric' };
            const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
            
            const dateStrEl = document.getElementById('date-str');
            const timeStrEl = document.getElementById('time-str');
            if (dateStrEl && timeStrEl) {
                dateStrEl.textContent = now.toLocaleDateString('en-GB', dateOpts);
                timeStrEl.textContent = now.toLocaleTimeString('en-GB', timeOpts);
            }
        }
        setInterval(updateTime, 1000);
        updateTime();
    </script>
</body>
</html>